<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 서비스 식별자 (고유해야 함) -->
    <key>Label</key>
    <string>com.amiwork.validate</string>

    <!-- 로그인 후 즉시 실행 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 비정상 종료 시 자동 재시작 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 실행할 명령 — 절대 경로 사용 -->
    <key>ProgramArguments</key>
    <array>
        <!-- ★ 영준님 홈 디렉토리 경로로 교체 필요 (아래 예시는 /Users/woodelight 기준) -->
        <string>/Users/woodelight/Projects/ami-work/research/admin-validation/start.sh</string>
    </array>

    <!-- 표준 출력 / 에러 로그 -->
    <key>StandardOutPath</key>
    <string>/tmp/amiwork-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/amiwork-launchd-err.log</string>

    <!-- 환경변수 (ANTHROPIC_API_KEY 필요 시 여기 추가) -->
    <!--
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>sk-ant-여기에입력</string>
    </dict>
    -->
</dict>
</plist>
