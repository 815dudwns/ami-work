{"kind":"xhr","ts":1780495256299,"url":"https://awms.kdn.com/assets/js/main.js","method":"GET","reqBody":"","status":200,"resBody":"$(document).ready(function() {\r\n  //메인 사용자정보 박스 접고, 펼침\r\n    var wwidth = $(window).width();\r\n    \r\n    if (wwidth > 480) {\r\n        $('.notice_box_slide').on('click', function() {\r\n            if ($(this).hasClass('on')) {\r\n                $('.notice_box .notice_box_inner>.inner_cont').fadeIn();\r\n                $('.notice_box .notice_box_inner').stop().animate({ 'height': 200 }, 600, 'easeOutExpo');\r\n//                $('.notice_box .notice_box_inner>.m_btn_carousel').delay(150).fadeIn();\r\n//                $('.notice_box .notice_box_inner>.m_btn_notice').delay(150).fadeIn();\r\n                $(this).removeClass('on');\r\n            } else {\r\n                $('.notice_box .notice_box_inner>.inner_cont').fadeOut();\r\n                $('.notice_box .notice_box_inner>.m_btn_carousel').css({ 'display': 'none' });\r\n                $('.notice_box .notice_box_inner>.m_btn_notice').css({ 'display': 'none' });\r\n                $('.notice_box .notice_box_inner').stop().animate({ 'height': 0 }, 600, 'easeOutExpo');\r\n                $(this).addClass('on');\r\n            }\r\n        });\r\n    } else if (wwidth < 481) {\r\n        $('.notice_box_slide').on('click', function() {\r\n            if ($(this).hasClass('on')) {\r\n                $('.notice_box .notice_box_inner>.inner_cont').fadeIn();\r\n                $('.notice_box .notice_box_inner').stop().animate({ 'height': 240 }, 600, 'easeOutExpo');\r\n                $('.notice_box .notice_box_inner>.m_btn_carousel').delay(150).fadeIn();\r\n                $('.notice_box .notice_box_inner>.m_btn_notice').delay(150).fadeIn();\r\n                $(this).removeClass('on');\r\n                $(this).css({ 'bottom': '-6px' });\r\n            } else {\r\n                $('.notice_box .notice_box_inner>.inner_cont').fadeOut();\r\n                $('.notice_box .notice_box_inner>.m_btn_carousel').css({ 'display': 'none' });\r\n                $('.notice_box .notice_box_inner>.m_btn_notice').css({ 'display': 'none' });\r\n                $('.notice_box .notice_box_inner').stop().animate({ 'height': 0 }, 600, 'easeOutExpo');\r\n                $(this).addClass('on');\r\n                $(this).css({ 'bottom': '-16px' });\r\n            }\r\n        });\r\n    }\r\n    \r\n    \r\n    // widnow resize\r\n    $(window).resize(function(){    \t \r\n    \t$('.widget_list .widget_box').removeClass(\"transition\");\r\n    \t//$('.widget_list .widget_box.on').closest('.widget_list').masonry('layout');\r\n    });\r\n    \r\n\r\n    //메인 탭 위젯\r\n    $(\".main_tab_box > li > p > a\").on(\"click\", function() {\r\n        $(this).parent().parent().siblings().find('> div').hide();\r\n        $(this).parent().parent().find('> div').fadeIn();\r\n        $(this).parent().parent().addClass(\"on\").siblings().removeClass(\"on\");\r\n        $('.widget_list .widget_box').removeClass(\"transition\");\r\n        $(this).parent().siblings().find('.widget_list > .widget_box').addClass(\"transition\");\r\n\r\n        $('.widget_list > .widget_box').removeClass('on');\r\n        // 메인 위젯리스트 그리드 설정\r\n        var cnt = 0;\r\n\r\n        // 애니메이션 설정\r\n        function delayAniClass(target, delay) {\r\n            setTimeout(function() {\r\n                target.addClass('on');\r\n            }, delay);\r\n        }\r\n\r\n        var widgetList = $(this).parent().siblings().find('.widget_list > .widget_box');\r\n        var widgetListIdx = $(widgetList).length;\r\n\r\n        if (wwidth > 480) {\r\n            $($(this).parent().siblings().find('.widget_list')).masonry({\r\n                itemSelector: '.widget_list > .widget_box',\r\n                columnWidth: 1\r\n            });\r\n        } else if (wwidth < 481) {\r\n            var option = {\r\n                itemSelector: '.widget_list > .widget_box',\r\n                columnWidth: 1\r\n            };\r\n            $grid = $('.widget_list').masonry(option);\r\n            $grid.masonry('destroy');\r\n        }\r\n\r\n        for (var i = 0; i < widgetListIdx; i++) {\r\n            var aniDelay = (i + 1) * 150;\r\n            var aniTarget = $(widgetList).eq(i);\r\n            delayAniClass(aniTarget, aniDelay);\r\n        };\r\n        \r\n        var that = $(this);\r\n        setTimeout(function() {\r\n            var centerTabHeight2 = $(that).parent().siblings('.tab_content').find('.widget_list').outerHeight() + $(\".main_tab_box\").outerHeight() + 150;\r\n            $(\".main_tab_wrap\").height(centerTabHeight2);\r\n        }, 500);\r\n\r\n        return false;\r\n    });\r\n\r\n    $(\".main_tab_box > li:first > p > a\").trigger('click');\r\n    $('.main_tab_box > li:first .tab_content .widget_list .widget_box').addClass('transition');\r\n    \r\n\r\n    //메인 사용자정보 박스 반응형일때 슬라이더 형식으로 변환\r\n    $('.m_btn_carousel').on('click', function() {\r\n        $(this).siblings('.inner_cont').eq(2).addClass('on');\r\n        $(this).siblings('.dark_layer').addClass('on');\r\n    });\r\n    $('.inner_cont .btn_close_m3').on('click', function() {\r\n        $(this).parent().removeClass('on');\r\n        $(this).parent().siblings('.dark_layer').removeClass('on');\r\n    });\r\n    $('.m_btn_notice').on('click', function() {\r\n        $(this).siblings('.inner_cont').eq(0).addClass('on');\r\n        $(this).siblings('.dark_layer').addClass('on');\r\n    });\r\n    $('.inner_cont .btn_close_m1').on('click', function() {\r\n        $(this).parent().removeClass('on');\r\n        $(this).parent().siblings('.dark_layer').removeClass('on');\r\n    });\r\n});\r\n\r\n","dur":35,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01050000"}
{"kind":"xhr","ts":1780495256249,"url":"../sub/portal_main.html","method":"GET","reqBody":"","status":200,"resBody":"<script type=\"text/javascript\" src=\"../../assets/js/main.js\"></script>\r\n\r\n<div class=\"main_wrap\" id=\"appMain\">\r\n\t<section class=\"main_inner\">\r\n\t    <section class=\"top_logo\">\r\n\t        <a href=\"javascript:void(0);\" class=\"logo\"><img src=\"/images/common/KDN_CI_05.png\" :alt=\"defaultInfo.SITE_NM\"></a>\r\n\t\t\t\t\t<h1 class=\"project-name\">AMI 현장관리 시스템</h1>\r\n\t    </section>\r\n\t    \r\n\t   \t<section class=\"main_tab_wrap\" id=\"mainListLoading\">\r\n\t        <ul class=\"main_tab_box\">\r\n\t            <li :class=\"{'on':layoutList.rowposition == index}\" v-for=\"(item, index) in layoutList.getData()\">\r\n\t                <div class=\"tab_content\" id=\"subListLoading\" v-if=\"layoutList.rowposition == index\">\r\n\t                    <div class=\"widget_list\" v-if=\"layoutContentList.length > 0\">\r\n\t                    \t<grid-layout :layout.sync=\"layoutContentList\" :col-num=\"3\" :row-height=\"120\" :auto-size=\"true\" :is-resizable=\"false\" :vertical-compact=\"true\" :is-draggable=\"false\" :responsive=\"true\" :use-css-transforms=\"true\" :breakpoints=\"{lg: 1920, md: 1500, sm: 800, xs: 480, xxs: 0}\" :cols=\"{lg:3, md:3, sm:2, xs:1, xxs:1}\" :margin=\"widgetMargin\" @layout-mounted=\"layoutMountedEvent\">\r\n\t\t\t\t\t\t\t\t<grid-item class=\"handle main-grid\" v-for=\"(item, index) in layoutContentList\" :x=\"item.x\" :y=\"item.y\" :w=\"item.w\" :h=\"item.h\" :i=\"item.i\" style=\"background:#ffffff;\" :key=\"index\">\r\n\t\t\t\t\t\t\t\t\t<component :is=\"item.URL\" :appid=\"item.APP_ID\" :widgetseq=\"item.WIDGET_SEQ\" :key=\"index\" :parameter=\"item.PARAMETER\"></component>\r\n\t\t\t\t\t\t\t\t</grid-item>\r\n\t\t\t\t\t\t\t</grid-layout>\r\n\t                   \t</div>\r\n\t              \t</div>\r\n\t           \t</li>\r\n\t      \t</ul>\r\n\t   \t</section>\r\n\t</section>\r\n</div>\r\n<script type=\"text/javascript\">\r\n/*******************************************************************************************************************************************************************\r\n * vue start \r\n ********************************************************************************************************************************************************************/\r\n var vmPortalMain = new Vue({\r\n    el: '#appMain',\r\n    //사용할 데이터\r\n    data: {\r\n    \tlayoutList: new Dataset(),\r\n    \tlayoutContentList: [],\r\n    \tbannerPostList: new Dataset(),\r\n    \tmainListLoading: {id:'mainListLoading', val:false},\r\n    \tsubListLoading: {id:'subListLoading', val:false},\r\n    \twidgetMargin: [0,0],\r\n    \t\r\n    \tpushIljeongCount: 0,\r\n    \tpushMailCount: 0,\r\n    \tpushNotyCount: 0,\r\n    \tpushMsgCount: 0,\t\r\n    \temailUseYn : false\r\n    },\r\n    //마운트 된 시점수행\r\n    watch: {\r\n    \t'layoutList.rowposition': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tif(this.layoutList.enableevent){\r\n\t\t\t\t\tthis.layoutContentList = [];\r\n\t\t\t\t\tthis.setMyLayoutContent();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\t\t\r\n\t\t'mainListLoading.val': {\r\n\t    \thandler: function (val, oldVal) {\r\n\t\t\t\tthis.LoadingOverlay($('#'+this.mainListLoading.id), val);\r\n\t\t\t}\r\n\t    },\r\n\t    'subListLoading.val': {\r\n\t    \thandler: function (val, oldVal) {\r\n\t\t\t\tthis.LoadingOverlay($('#'+this.subListLoading.id), val);\r\n\t\t\t}\r\n\t    },\r\n    },\r\n    created: function(){\r\n       \tvar wwidth = $(window).width();\r\n       \t\r\n       \tif (wwidth < 481) {\r\n       \t\tthis.widgetMargin = [3,20];\r\n       \t}else{\r\n       \t\tthis.widgetMargin = [30,30];\r\n       \t}\r\n       \t\r\n    \t// this.setBannerPostList();\r\n    },\r\n    //마운트 된 시점수행\r\n    mounted: function(){\r\n    \tthis.setLayoutList();    \t\r\n    \tthis.setPushCount(staticVue.pushAlarmCount);\r\n    },\r\n    //함수\r\n    methods: {\r\n    \tsetPushCount: function (pCntObj) {\r\n    \t\tvar cntObj = pCntObj;\r\n    \t\tvar headerIljeongClass = 'new';\r\n    \t\tvar headerNotiClass = 'new';\r\n    \t\tvar headerTalkClass = 'new';\r\n\r\n    \t\tthis.pushIljeongCount = cntObj.iljeongCnt;\r\n    \t\tthis.pushMailCount = cntObj.mailCnt;\r\n    \t\tthis.pushNotyCount = cntObj.notyCnt;\r\n    \t\tthis.pushMsgCount = cntObj.msgCnt;\r\n    \t\t\r\n    \t\theaderTalkClass = (this.pushMsgCount > 0)?'new':'';\t\t\r\n    \t\t$('#appListArea > div.menu_bar > span').attr('class','btn_talk ' + headerTalkClass);\r\n    \t\t$('#icon-message-circle-new').attr('class', headerTalkClass);\r\n    \t\t\r\n    \t\theaderNotiClass = (this.pushNotyCount > 0)?'new':'';\t\t\r\n    \t\t$('#icon-noti-circle-new').attr('class', headerNotiClass);\r\n    \t\t\r\n    \t\theaderIljeongClass = (this.pushIljeongCount > 0)?'new':'';\t\t\r\n    \t\t$('#icon-email-circle-new').attr('class', headerIljeongClass);\r\n    \t},\r\n\t\tsetLayoutList: function(){\r\n\t\t\ttry{\r\n\t\t\t\tvar param = {pSearchGb:'main'};\r\n\t\t\t\tvar self = this;\r\n\t\t\t\t//self.mainListLoading.val = true;\r\n\t\t\t\tvar returnVal = layoutApi.layout(param, false);\r\n\t\t\t\t\r\n\t\t\t\treturnVal.then(function(response) {\r\n\t\t\t\t\tself.layoutList.setData(response.data);\r\n\t\t\t\t\tself.layoutList.selectRow(0);\r\n\t\t\t\t}).catch(function(error) {\r\n\t\t\t\t\tconsole.error('error:', error);\r\n\t\t\t\t}).finally(function(){\r\n\t\t\t\t\t//self.mainListLoading.val = false;\r\n\t\t\t\t});\r\n\t\t\t} catch(err){\r\n\t\t\t\tconsole.log('setLayoutList() Error : '+err.message);\r\n\t\t\t};\r\n\t\t},\r\n\t\tsetMyLayoutContent: function(){\r\n\t\t\ttry{\r\n\t\t\t\tvar self = this;\r\n\t\t\t\t\r\n\t\t\t\tif(self.layoutList.currentRow && self.layoutList.rowposition > -1){\r\n\t\t\t\t\tself.subListLoading.val = true;\r\n\t\t\t\t\tvar returnVal = layoutApi.layoutContent(self.layoutList.currentRow, false);\r\n\t\t\t\t\t\r\n\t\t\t\t\treturnVal.then(function(response) {\r\n\t\t\t\t\t\tself.layoutContentList = response.data;\r\n\t\t\t\t\t}).catch(function(error) {\r\n\t\t\t\t\t\tconsole.error('error:', error);\r\n\t\t\t\t\t}).finally(function(){\r\n\t\t\t\t\t\tself.subListLoading.val = false;\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t} catch(err){\r\n\t\t\t\tconsole.log('setMyLayoutContent() Error : '+err.message);\r\n\t\t\t};\r\n\t\t},\r\n\t\tsetBannerPostList: function(){\r\n\t\t\ttry{\r\n\t\t\t\tvar self = this;\r\n\t\t\t\tvar returnVal = bannerApiApi.bannerPosts({'BANNER_GROUP_SEQ':'1'}, false);\r\n\t\t\t\t\r\n\t\t\t\treturnVal.then(function(response) {\r\n\t\t\t\t\tself.bannerPostList.setData(response.data);\r\n\t\t\t\t\t//메인 carousel 슬라이더\r\n\t\t\t\t\tself.$nextTick(function() {\r\n\t\t\t\t\t\t$('.main_carousel').slick({\r\n\t\t\t\t\t\t\tautoplay: true,\r\n\t\t\t\t\t\t\tautoplaySpeed: 3000,\r\n\t\t\t\t\t\t});\t\r\n\t\t\t\t\t});\r\n\t\t\t\t}).catch(function(error) {\r\n\t\t\t\t\tconsole.error('error:', error);\r\n\t\t\t\t}).finally(function(){\r\n\t\t\t\t\t//self.mainListLoading.val = false;\r\n\t\t\t\t});\r\n\t\t\t} catch(err){\r\n\t\t\t\tconsole.log('setBannerPostList() Error : '+err.message);\r\n\t\t\t};\r\n\t\t},\r\n        layoutMountedEvent: function() {\r\n        \ttry{\r\n\t        \tvar wwidth = $(window).width();\r\n\t        \t\r\n\t        \tif (wwidth < 481) {\r\n\t                // 모바일일때 위젯 접고, 펼침\r\n\t                // PHS: 모바일일때 위젯을 접지 않음.\r\n\t                //mwidget()\r\n\t            } else if (wwidth > 480) {}\r\n\t        \t\r\n\t        \tfunction mwidget() {\t\r\n\t        \t\t//모바일일때 위젯 접고, 펼침\t        \t\r\n\t        \t\t$('.widget_list').css({ 'overflow': 'hidden' });\r\n\t        \t    $('.widget_list .widget_box .title_box').on('click', function() {\r\n\t        \t\t\tvar that = $(this);\r\n\t        \t\t\tvar pheight = $(this).parent().parent().height();\r\n\t        \t        if ($(this).hasClass('on')) {\r\n\t        \t            setTimeout(function() {\r\n\t        \t                var centerTabHeight3 = $(that).closest('.widget_list').outerHeight() + $(\".main_tab_box\").outerHeight() + 150;\r\n\t        \t                $(\".main_tab_wrap\").height(centerTabHeight3);\r\n\t        \t            }, 500);\r\n\t        \t            $(this).siblings('.content_box').slideUp();\r\n\t        \t            $(this).parent().parent().stop().animate({'maxHeight':'85px'});\r\n\t        \t            $(this).removeClass('on');\r\n\t\r\n\t        \t        } else {\r\n\t        \t            setTimeout(function() {\r\n\t        \t            \ttheOffset = jQuery(that).offset();\r\n\t        \t            \tjQuery('body,html').animate({ scrollTop: theOffset.top - 30 });\r\n\t        \t                var centerTabHeight3 = $(that).closest('.widget_list').outerHeight() + $(\".main_tab_box\").outerHeight() + 150;\r\n\t        \t                $(\".main_tab_wrap\").height(centerTabHeight3);\r\n\t        \t            }, 500);\r\n\t        \t            $('.widget_list .widget_box .content_box').slideUp();\r\n\t        \t            $('.widget_list .main-grid').css({'maxHeight':'85px'});\t        \t            \r\n\t        \t            $(this).parent().parent().stop().animate({'maxHeight':'100%'});\r\n\t        \t            $(this).parent().parent().siblings().find('.title_box').removeClass('on');\r\n\t        \t            $(this).siblings('.content_box').slideDown();\r\n\t        \t            $(this).addClass('on');\r\n\t        \t        }\r\n\t        \t    });\r\n\t        \t} \r\n\t        \t\r\n\t        \tvar delta = 200;\r\n\t            var timer = null;\r\n\r\n\t            var cachedWidth = $(window).width();\r\n\r\n\t            $(window).resize(function() {\r\n\t                var newWidth = $(window).width();\r\n\t                if (newWidth !== cachedWidth) {\r\n\t                    // 모바일일때 위젯 접고, 펼침\r\n\t                    // PHS: 모바일일때 위젯을 접지 않음. \r\n\t                    if (newWidth < 481 && false) {\r\n\t                        clearTimeout(timer);\r\n\t                        timer = setTimeout(mwidget, delta);\r\n\t                        $('.widget_list .main-grid').stop().animate({'height':'85px'});\r\n\t                        //$('.widget_box .title_box').siblings('.content_box').slideUp();\r\n\t                        $('.widget_box .title_box').removeClass('on');\r\n\t                        setTimeout(function() {\r\n\t                            var centerTabHeight3 = $('.widget_list').outerHeight() + $(\".main_tab_box\").outerHeight() + 150;\r\n\t                            $(\".main_tab_wrap\").height(centerTabHeight3);\r\n\t                        }, 500);\r\n\r\n\t                    } else if (newWidth > 480 || true) {\r\n\t                    \t$('.widget_list .main-grid').stop().animate({'height':'auto'});\r\n\t                        //$('.widget_box .content_box').slideDown();\r\n\t                        $('.widget_list .widget_box .title_box').off('click');\r\n\t                        setTimeout(function() {\r\n\t                            var centerTabHeight3 = $('.widget_list').outerHeight() + $(\".main_tab_box\").outerHeight() + 150;\r\n\t                            $(\".main_tab_wrap\").height(centerTabHeight3);\r\n\t                        }, 500);\r\n\t                    }\r\n\t                    cachedWidth = newWidth;\r\n\t                }\r\n\t            });\r\n        \t} catch(err){\r\n\t\t\t\tconsole.log('setMyLayoutContent() Error : '+err.message);\r\n\t\t\t};\r\n        },\r\n\t\tmodiImgAddr: function(pAddr){\r\n\t\t\tvar modiAddr = '';\r\n\t\t\t\r\n\t\t\tif(!isNull(pAddr)){\r\n\t\t\t\tmodiAddr = pAddr.replace(/\\\\/g, '/'); \r\n\t\t\t\t\r\n\t\t\t\tif(modiAddr.substring(1,4) == 'SMN'){\r\n\t\t\t\t\tmodiAddr = '/upload' + modiAddr;\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tmodiAddr = '/service/design/images/mypage/noimage.png';\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\treturn modiAddr;\r\n\t\t}\r\n    }\r\n});\r\n$(function() {\r\n\t$('.main_user_photo img').on('error', function() {$(this).attr('src', '/service/design/images/mypage/noimage.png');});\r\n\t$('.user_photo img').on('error', function() {$(this).attr('src', '/service/design/images/mypage/noimage.png');});\r\n});\r\n/*******************************************************************************************************************************************************************\r\n * vue end \r\n ********************************************************************************************************************************************************************/\r\n </script>","dur":95,"page":"https://awms.kdn.com/html/main/index.html?portalPage=portal_main"}
{"kind":"xhr","ts":1780495256281,"url":"../sub/app_main.html","method":"GET","reqBody":"","status":200,"resBody":"<div id=\"app_wrap\">\r\n    <!-- header 배경색은 학생일때.stu, 교수일때.pro, 직원일때.mng  -->\r\n    <!-- //4(학생), 1,2(교수), 3(직원), 5(학사외부사용자), 9(포탈 사용자) -->\r\n    <header id=\"sub_header\" :class=\"{'mng':session.USER_GB == '7' || session.USER_GB == '8' || session.USER_GB == '9','pro':session.USER_GB == '1' || session.USER_GB == '2' || session.USER_GB == '3','stu':session.USER_GB == '4' || session.USER_GB == '5'}\">\r\n\t\t\t\t<a href=\"#\" class=\"logo\" @click=\"goMain()\"><img src=\"/images/common/KDN_CI_05.png\" alt=\"AMI 현장관리 시스템\"></a>\r\n        <a href=\"javascript:void(0);\" class=\"btn_menu\"><span class=\"icon-menu\"></span></a>\r\n\t\t\t\t<h1 class=\"project-name\">AMI 현장관리 시스템</h1>\r\n\t\t<!-- <div class=\"sub_title\">\r\n\t\t\t<span class=\"icon\"></span>\r\n\t\t\t<h1 class=\"txt\"></h1>\r\n\t\t</div> -->\r\n    </header>\r\n    <nav id=\"snb\">\r\n        \r\n    </nav>\r\n\t\t<div class=\"nav-bg\"></div>\r\n    <article class=\"sub_content\">\r\n        <div class=\"sub_cont_wrap\"></div>\r\n    </article>\r\n    <a href=\"javascript:void(0);\" class=\"btn_top\">\r\n        <span>TOP</span>\r\n    </a>\r\n    <script id=\"notify\" type=\"text/template\">\r\n\t\t<div class=\"notify <!= color !>\">\r\n\t\t\t<div class=\"image\"><i class=\"<!=icon!>\" style=\"font-size: 18px;\"></i></div>\r\n    \t\t<div class=\"title\"><!= title !></div>\r\n    \t\t<div class=\"message\"><!= message !></div>\r\n\t\t\t<a href=\"#\" class=\"close\"><i class=\"icon-exit\"></i></a>\r\n\t\t</div>\r\n\t</script>\r\n</div>\r\n\t\r\n<script type=\"text/javascript\">\r\n/**********************************************************\t*********************************************************************************************************\r\n * vue start \r\n ********************************************************************************************************************************************************************/\r\nvar appIndexVm = new Vue({\r\n\tel: '#app_wrap',\r\n\tdata: {\r\n\t\tsessionInfo : '',\r\n\t},\r\n\twatch: {\r\n\t\t\r\n\t},\r\n\tmounted: function(){\r\n\t\tthis.getUserSession();\r\n\t},\r\n\tmethods: {\r\n\t\tgetUserSession: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar returnVal = getSession();\r\n\t\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.sessionInfo = response.data;\r\n\t\t\t\tself.$forceUpdate();\r\n\t\t\t}).catch(function(error) {\r\n\t\t\t\tconsole.error('session info set ERROR:', error);\r\n\t\t\t\treturn null;\r\n\t\t\t});\r\n\t\t},\r\n\t\tgoMain(){\r\n\t\t\tdocument.location.href = '/html/main/index.html?portalPage=portal_main';\r\n\t\t}\r\n\t},\r\n});\r\n/**********************************************************\t*********************************************************************************************************\r\n * vue end\r\n ********************************************************************************************************************************************************************/\r\n\r\n/*******************************************************************************************************************************************************************\r\n * javascript start \r\n ********************************************************************************************************************************************************************/\r\nvar globalParam = {};\r\n\r\n// iOS 18 대응 뷰포트 및 Safe Area 처리\r\n(function() {\r\n    var viewportTimer;\r\n    var isIOS18Plus = false;\r\n    \r\n    // iOS 버전 감지\r\n    function detectIOSVersion() {\r\n        var ua = navigator.userAgent;\r\n        var iOS = /iPad|iPhone|iPod/.test(ua);\r\n        if (iOS) {\r\n            var version = ua.match(/OS (\\d+)_/);\r\n            if (version && parseInt(version[1]) >= 18) {\r\n                isIOS18Plus = true;\r\n                document.documentElement.classList.add('ios18-plus');\r\n            }\r\n        }\r\n        return isIOS18Plus;\r\n    }\r\n    \r\n    function setViewportHeight() {\r\n        const vh = window.innerHeight * 0.01;\r\n        const vw = window.innerWidth * 0.01;\r\n        \r\n        // 기본 뷰포트 변수 설정\r\n        document.documentElement.style.setProperty('--vh', `${vh}px`);\r\n        document.documentElement.style.setProperty('--vw', `${vw}px`);\r\n        \r\n        // iOS 18+ 대응 추가 뷰포트 단위\r\n        if (window.CSS) {\r\n            if (CSS.supports('height', '100dvh')) {\r\n                document.documentElement.style.setProperty('--dvh', '1dvh');\r\n            } else {\r\n                document.documentElement.style.setProperty('--dvh', `${vh}px`);\r\n            }\r\n            \r\n            if (CSS.supports('height', '100svh')) {\r\n                document.documentElement.style.setProperty('--svh', '1svh');\r\n            } else {\r\n                document.documentElement.style.setProperty('--svh', `${vh}px`);\r\n            }\r\n            \r\n            if (CSS.supports('height', '100lvh')) {\r\n                document.documentElement.style.setProperty('--lvh', '1lvh');\r\n            } else {\r\n                document.documentElement.style.setProperty('--lvh', `${vh}px`);\r\n            }\r\n        }\r\n        \r\n        // iOS 18에서 Safe Area 재계산\r\n        if (isIOS18Plus) {\r\n            const safeBottom = getComputedStyle(document.documentElement).getPropertyValue('--safe-area-inset-bottom');\r\n            if (safeBottom && safeBottom !== '0px') {\r\n                document.documentElement.style.setProperty('--calculated-safe-bottom', safeBottom);\r\n            }\r\n        }\r\n    }\r\n    \r\n    // iOS 버전 감지 실행\r\n    detectIOSVersion();\r\n    \r\n    // 초기 설정\r\n    setViewportHeight();\r\n    \r\n    // 이벤트 리스너 등록\r\n    window.addEventListener('resize', function() {\r\n        clearTimeout(viewportTimer);\r\n        viewportTimer = setTimeout(setViewportHeight, 100);\r\n    });\r\n    \r\n    window.addEventListener('orientationchange', function() {\r\n        setTimeout(setViewportHeight, 150);\r\n    });\r\n    \r\n    // iOS 18 전용 추가 이벤트\r\n    if (isIOS18Plus) {\r\n        window.addEventListener('scroll', function() {\r\n            clearTimeout(viewportTimer);\r\n            viewportTimer = setTimeout(setViewportHeight, 50);\r\n        }, { passive: true });\r\n        \r\n        // Visual Viewport API 지원 시 사용\r\n        if (window.visualViewport) {\r\n            window.visualViewport.addEventListener('resize', setViewportHeight);\r\n        }\r\n    }\r\n})();\r\n\r\n$(document).ready(function(){\r\n\ttry{\r\n\t\tvar urlInfo = window.location;\r\n\t\tvar appId = getParameterByName('app', urlInfo);\r\n\t\t\r\n\t\tchangeAppInfo();\r\n\t\tif(!isNull(appId)){\r\n\t\t\t$('body').LoadingOverlay(\"show\", true);\r\n\t\t}\r\n\t}catch(err){\r\n\t\tconsole.log('app index.html $(document).ready() Error : '+err.message);\r\n\t\treturn false;\r\n\t}\r\n});\r\n\r\nfunction changeAppInfo(){\r\n\ttry{\r\n\t\t/* if(self != top){ */\r\n\t\t\tvar className = 'icon '+parent.globalAppIcon+' '+parent.globalAppColor;\r\n\t\t\r\n\t\t\t$('#sub_header .sub_title h1.txt').text(parent.globalAppNm);\r\n\t\t\t$('#sub_header .sub_title span').attr('class',className);\r\n\t\t\t\r\n\t\t/* } */\r\n\t}catch(err){\r\n\t\tconsole.log('app index.html changeAppInfo() Error : '+err.message);\r\n\t\treturn false;\r\n\t}\r\n}\r\n\r\n$(document).ready(function() {\r\n    // 상단으로 이동 버튼\r\n    $(window).scroll(function() {\r\n        var bot = $(document).height() - $(window).height();\r\n        var height = $(document).scrollTop();\r\n        if (height == bot) {\r\n            $('.btn_top').fadeIn();\r\n            $('.btn_top').on('click', function() {\r\n                $('html').stop().animate({ scrollTop: 0 }, 100);\r\n            });\r\n        } else {\r\n            $('.btn_top').fadeOut();\r\n        }\r\n    });\r\n});\r\n\r\n// 외부 영역 클릭 시 id=\"snb\" 닫기\r\nif ($(window).width() < 1650) {\r\n\t$(document).click(function (event) {\r\n\t\tif (!$(event.target).closest('#snb, .btn_menu').length) {\r\n\t\t\t$('#snb').removeClass('on').css('transition', '.4s');\r\n\t\t\t$('html').css('overflow', 'auto');\r\n\t\t}\r\n\t});\r\n}\r\n\r\n// #snb on일때 html overflow:hidden\r\nif ($(window).width() < 1650) {\r\n\t$(document).on('click', '.btn_menu', function () {\r\n\t\tif ($('#snb').hasClass('on')) {\r\n\t\t\t$('html').css('overflow', 'hidden');\r\n\t\t} else {\r\n\t\t\t$('html').css('overflow', 'auto');\r\n\t\t}\r\n\t});\r\n}\r\n\r\n\r\n\r\n/*******************************************************************************************************************************************************************\r\n * javascript end \r\n ********************************************************************************************************************************************************************/\r\n</script>\r\n","dur":80,"page":"https://awms.kdn.com/html/main/index.html?portalPage=portal_main"}
