m\">\r\n\t\t\t\t            <option value=\"\">없음</option>\r\n\t\t\t\t\t\t\t<option value=\"1\">1</option>\r\n\t\t\t\t\t\t\t<option value=\"2\">2</option>\r\n\t\t\t\t        </select>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n                <th scope=\"row\"><label for=\"form030101\">봉인종류(베터리)</label></th>\r\n                <td colspan=\"3\">\r\n                    <select v-model=\"mainList.BATT_SEAL_KND_CD\" id=\"form030101\" class=\"size-m\">\r\n                        <option value=\"\">선택</option>\r\n                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'JC069')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n                    </select>\r\n                </td>\r\n            </tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th scope=\"row\"><label for=\"form0105\">봉인수량(베터리)</label></th>\r\n\t\t\t\t<td colspan=\"3\">\r\n\t\t\t\t\t<div class=\"flex\">\r\n\t\t\t\t\t\t<select v-model=\"mainList.BATT_SEAL_CNT_VAL\" id=\"form0105\" class=\"size-m\">\r\n\t\t\t\t            <option value=\"\">없음</option>\r\n\t\t\t\t\t\t\t<option value=\"1\">1</option>\r\n\t\t\t\t\t\t\t<option value=\"2\">2</option>\r\n\t\t\t\t        </select>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n                <th scope=\"row\"><label for=\"form030101\">봉인종류(계기함)</label></th>\r\n                <td colspan=\"3\">\r\n                    <select v-model=\"mainList.MTBX_SEAL_KND_CD\" id=\"form030101\" class=\"size-m\">\r\n                        <option value=\"\">선택</option>\r\n                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'JC069')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n                    </select>\r\n                </td>\r\n            </tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th scope=\"row\"><label for=\"form0106\">봉인수량(계기함)</label></th>\r\n\t\t\t\t<td colspan=\"3\">\r\n\t\t\t\t\t<div class=\"flex\">\r\n\t\t\t\t\t\t<select v-model=\"mainList.MTBX_SEAL_CNT_VAL\" id=\"form0106\" class=\"size-m\">\r\n\t\t\t\t            <option value=\"\">없음</option>\r\n\t\t\t\t\t\t\t<option value=\"1\">1</option>\r\n\t\t\t\t\t\t\t<option value=\"2\">2</option>\r\n\t\t\t\t        </select>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</tbody>\r\n\t</table>\r\n\t<h3 class=\"h3 type02\">실효계기 공사정보설정</h3>\r\n\t<table class=\"table-type33\">\r\n\t\t<caption>공사정보</caption>\r\n\t\t<colgroup>\r\n\t\t\t<col width=\"20%\">\r\n\t\t\t<col width=\"30%\">\r\n\t\t\t<col width=\"20%\">\r\n\t\t\t<col width=\"30%\">\r\n\t\t</colgroup>\r\n\t\t<tbody>\r\n\t\t\t<tr>\r\n\t\t\t\t<th scope=\"row\"><label for=\"form0104\">공사명(저압)</label></th>\r\n\t\t\t\t<td colspan=\"3\">\r\n\t\t\t\t\t<div class=\"flex\">\r\n\t\t\t\t\t\t<select v-model=\"mainList.LV_CONS_NO\" id=\"select01\" class=\"size-m\">\r\n\t\t\t\t\t\t\t<option value=\"\">전체</option>\r\n\t\t\t\t\t\t\t<option v-for=\"item in busiList.rawData.filter(item=>item.DIST_LV_HV_CLCD == '1')\" :value=\"item.CONS_NO\">({{item.CONS_NO}}){{ item.CONS_OVVW_CTT }}</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th scope=\"row\"><label for=\"form0105\">공사명(고압)</label></th>\r\n\t\t\t\t<td colspan=\"3\">\r\n\t\t\t\t\t<div class=\"flex\">\r\n\t\t\t\t\t\t<select v-model=\"mainList.HV_CONS_NO\" id=\"select01\" class=\"size-m\">\r\n\t\t\t\t\t\t\t<option value=\"\">전체</option>\r\n\t\t\t\t\t\t\t<option v-for=\"item in busiList.rawData.filter(item=>item.DIST_LV_HV_CLCD == '2')\" :value=\"item.CONS_NO\">({{item.CONS_NO}}){{ item.CONS_OVVW_CTT }}</option>\r\n\t\t\t\t\t\t</select>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</tbody>\r\n\t</table>\r\n\t<div class=\"btn-line right\">\r\n\t\t<button type=\"button\" class=\"btn type01 size-m c-primary\" @click=\"messagePopup('28')\">저장</button>\r\n\t</div>\r\n\t<modal-message :modalset=\"messageModal\" v-on:messagepoppupcallback=\"messagePopupCallback\"></modal-message>\r\n</section>\r\n<script type=\"text/javascript\">\r\n/*******************************************************************************************************************************************************************\r\n * vue start\r\n ********************************************************************************************************************************************************************/\r\nvar vm = new Vue({\r\n\tel: '#app',\r\n\t//사용할 데이터\r\n\tdata: {\r\n\t\tmainList: {\r\n\t\t\tENCL_SEAL_VAL: '',\r\n\t\t\tMETR_SEAL_VAL: '',\r\n\t\t\tOTSD_SEAL_VAL: '',\r\n\t\t\tETC_SEAL_VAL: '',\r\n\t\t\tTRML_SEAL_CNT_VAL: '',\r\n\t\t\tBATT_SEAL_CNT_VAL: '',\r\n\t\t\tMTBX_SEAL_CNT_VAL: '',\r\n\t\t\tLV_CONS_NO: '',\r\n\t\t\tHV_CONS_NO: '',\r\n\t\t},\r\n\t\tcodeList: new Dataset(),\r\n\t\tbusiList: new Dataset(), //errCause 목록\r\n\t\tmessageModal: new ModalSet('modal-message') //메시지 출력\r\n\t},\r\n\t//계산된 속성 표현 시\r\n\tcomputed: {\r\n\t},\r\n\t//데이터 감시\r\n\twatch: {\r\n\r\n\t},\r\n\t//마운트 된 시점수행\r\n\tmounted: function () {\r\n\t\tthis.setMainList();\r\n\t\tthis.setBusiList();\r\n\t\tthis.setCommonCode();\r\n\t},\r\n\t//함수\r\n\tmethods: {\r\n\t\tsetMainList: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\t\t\t\r\n\t\t\tvar returnVal = mobMtr8000Api.getMainList(params);\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tif(response.data){\r\n\t\t\t\t\tself.mainList = response.data;\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetBusiList: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {\r\n\t\t\t\tDEPT1 : self.session.DEPT1,\r\n\t\t\t};\r\n\t\t\tvar returnVal = mobMtr8000Api.getBusiList(params);\r\n\t\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.busiList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tsaveRow: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = this.mainList;\r\n\t\t\t\r\n\t\t\tvar returnVal = mobMtr8000Api.saveRow(params);\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tif(response.data > 0){\r\n\t\t\t\t\tnotifySubmit('success', '완료', '저장을 완료했습니다', 'icon-success');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tnotifySubmit('error', '실패', '저장이 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tresetData: function(data){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {\r\n\t\t\t\ttarget: data\r\n\t\t\t};\r\n\t\t\t\r\n\t\t\tvar returnVal = mobMtr8000Api.resetData(params);\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tif(response.data > 0){\r\n\t\t\t\t\tself.mainList[data] = '';\r\n\t\t\t\t\tnotifySubmit('success', '완료', '초기화가 완료했습니다', 'icon-success');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tnotifySubmit('error', '실패', '초기화가 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetCommonCode: function(){\r\n            var self = this;\r\n            var params = {};\r\n            var returnVal = mobMtr4000Api.getCommonCode();\r\n\r\n            returnVal.then(function(response) {\r\n                self.codeList.setRawData(response.data);\r\n            });\r\n        },\r\n\t\tmessagePopup: function(pId) {\r\n\t\t\tvar title = '확인';\r\n\t\t\tvar cont = '해당 작업을 수행하시겠습니까?';\r\n\t\t\tswitch(pId) {\r\n\t\t\t\tcase '28':\r\n\t\t\t\t\ttitle = '저장';\r\n\t\t\t\t\tcont = '변경 사항을 저장하시겠습니까?';\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tconst sealKeys = [\r\n\t\t\t\t'ENCL_SEAL_VAL',\r\n\t\t\t\t'METR_SEAL_VAL',\r\n\t\t\t  \t'OTSD_SEAL_VAL',\r\n\t\t\t  \t'ETC_SEAL_VAL'\r\n\t\t\t];\r\n\r\n\t\t\tfor (const key of sealKeys) {\r\n\t\t\t  \tconst value = this.mainList[key];\r\n\t\t\t  \tif (value !== undefined && value !== '' && (value.length < 7 || value.length > 7)) {\r\n\t\t\t\t\tnotifySubmit('error', '봉인번호', '봉인번호가 7자리가 아닙니다', 'icon-success');\r\n\t\t\t    \treturn;\r\n\t\t\t  \t}\r\n\t\t\t}\r\n\t\t\tthis.messageModal.openModal('confirm', title, cont, 'small', pId);\r\n\t\t},\r\n\t\tmessagePopupCallback: function(pGb, pId) {\r\n\t\t\tif(pGb!='confirm') return;\r\n\t\t\tthis.validateRow(pId);\r\n\t\t},\r\n\t\tvalidateRow: function(pId) {\r\n\t\t\tthis.saveRow();\r\n\t\t},\r\n\t\tnumberFormat: function(input, maxLength){\r\n\t\t\tthis.mainList[input] = this.mainList[input].replace(/[^0-9]/g, '');\r\n\t\t\tif (this.mainList[input].length > maxLength) this.mainList[input] = this.mainList[input].slice(0, maxLength);\r\n\t\t}\r\n\t}\r\n});\r\n/*******************************************************************************************************************************************************************\r\n * vue end\r\n ********************************************************************************************************************************************************************/\r\n\r\n\r\n\r\n/*******************************************************************************************************************************************************************\r\n * javascript start\r\n ********************************************************************************************************************************************************************/\r\n$(document).ready(function () {\r\n\r\n});\r\n/*******************************************************************************************************************************************************************\r\n * javascript end\r\n ********************************************************************************************************************************************************************/\r\n</script>","dur":150,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01050000"}
