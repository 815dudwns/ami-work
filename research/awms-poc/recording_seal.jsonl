keys(this.disabledFields)\r\n\t\t        .filter(key => this.disabledFields[key] === false);\r\n\r\n\t\t    const fieldMap = {\r\n\t\t        \"DGD_WHME_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_3\",\r\n\t\t        \"DGD_WHME_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_4\",\r\n\t\t        \"DGD_WHME_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_5\",\r\n\t\t        \"DGD_DM_MT_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_6\",\r\n\t\t        \"DGD_DM_MT_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_7\",\r\n\t\t        \"DGD_DM_MT_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_8\",\r\n\t\t        \"DGD_VAR_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_9\",\r\n\t\t        \"DGD_VAR_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_10\",\r\n\t\t        \"DGD_VAR_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_11\",\r\n\t\t        \"DGD_AEXST_WHME_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_3\",\r\n\t\t        \"DGD_AEXST_WHME_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_4\",\r\n\t\t        \"DGD_AEXST_WHME_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_5\",\r\n\t\t        \"DGD_AEXST_DM_MT_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_6\",\r\n\t\t        \"DGD_AEXST_DM_MT_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_7\",\r\n\t\t        \"DGD_AEXST_DM_MT_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_8\",\r\n\t\t        \"DGD_AEXST_VAR_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_9\",\r\n\t\t        \"DGD_AEXST_VAR_NDL_EVEN_QTT\": \"DREMO_ATCH_FILE_ID_10\",\r\n\t\t        \"DGD_AEXST_VAR_NDL_MNGT_QTT\": \"DREMO_ATCH_FILE_ID_11\",\r\n\t\t        \"DGD_GENT_WHM_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_12\",\r\n\t\t        \"DGD_ESS_WHME_NDL_DAY_QTT\": \"DREMO_ATCH_FILE_ID_13\",\r\n\t\t    };\r\n\r\n\t\t    for (const fieldKey of filteredFields) {\r\n\t\t        if (!fieldKey.endsWith('_QTT')) continue;\r\n\r\n\t\t        const parts = fieldKey.split('_');\r\n\t\t        const baseKey = parts.slice(0, -2).join('_');\r\n\t\t        const dgtsKey = `${baseKey}_DGTS`;\r\n\r\n\t\t        if (!filteredFields.includes(dgtsKey)) {\r\n\t\t            continue;\r\n\t\t        }\r\n\t\t        const qttValue = this.detail[fieldKey];\r\n\t\t        const dgtsValue = this.detail[dgtsKey];\r\n\r\n\t\t        if (typeof qttValue !== 'string' && typeof qttValue !== 'number') {\r\n\t\t            console.warn(`${fieldKey} has invalid qttValue:`, qttValue);\r\n\t\t            return false;\r\n\t\t        }\r\n\t\t        if (typeof dgtsValue !== 'number' && typeof dgtsValue !== 'string') {\r\n\t\t            console.warn(`${dgtsKey} has invalid dgtsValue:`, dgtsValue);\r\n\t\t            return false;\r\n\t\t        }\r\n\t\t\t\tif (dgtsValue === '' || dgtsValue === undefined){\r\n\t\t\t\t\tnotifySubmit('error', '자리수 선택', this.album.titleByColumnName[fieldMap[fieldKey]].split(' ')[1] + \" 자리수를 선택하세요\", 'icon-caution');\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t\tif(qttValue === '' || qttValue === undefined){\r\n\t\t\t\t\tnotifySubmit('error', '지침입력', this.album.titleByColumnName[fieldMap[fieldKey]] + \" 정보를 입력하세요\", 'icon-caution');\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t        const qttStr = String(qttValue);\r\n\t\t        const targetLen = parseInt(dgtsValue, 10) || 0;\r\n\t\t\t    /*\r\n\t\t        if (qttStr.length < targetLen) {\r\n\t\t            const padded = qttStr.padStart(targetLen, '0');\r\n\t\t            const confirmMsg = `${fieldKey}를 ${padded} 로 채우시겠습니까?`;\r\n\t\t            if (confirm(confirmMsg)) {\r\n\t\t                this.detail[fieldKey] = padded;\r\n\t\t            } else {\r\n\t\t                return false;\r\n\t\t            }\r\n\t\t        }\r\n\t\t\t    */\r\n\t\t    }\r\n\t\t\t/** 이미지 확인 */\r\n\t\t\tfor (const fieldKey of filteredFields) {\r\n\t\t\t\tconst imgColName = fieldMap[fieldKey];\r\n\t\t\t\tif (imgColName) {\r\n\t\t\t\t    const pageImg = document.getElementById(\"img.\" + imgColName);\r\n\t\t\t\t    if (!pageImg) {\r\n\t\t\t\t        console.warn(\"이미지 엘리먼트를 찾을 수 없습니다:\", \"img.\" + imgColName);\r\n\t\t\t\t        return false;\r\n\t\t\t\t    }\r\n\t\t\t\t    const src = pageImg.src || '';\r\n\t\t\t\t    if (src.indexOf(\"board_noimage\") > -1) {\r\n\t\t\t\t        notifySubmit('error', '이미지 없음', (this.album && this.album.titleByColumnName ? this.album.titleByColumnName[imgColName] : imgColName) + \" 이미지가 없습니다\", 'icon-caution');\r\n\t\t\t\t        return false;\r\n\t\t\t\t    }\r\n\t\t\t\t}\t\t\t\t\r\n\t\t\t}\r\n\r\n\t\t\t\r\n\t\t\t/** MOBMTR4000.js의 값들도 확인을 해야함 */\r\n\t\t\tvar crossCheck = await this.crossCheck();\r\n\t\t\tif(!crossCheck){\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t    return true;\r\n\t\t},\r\n\t\t\r\n\t\tcrossCheck: function(){\r\n\t\t\tif(this.detail.CREMO_WHM_NO == '' || this.detail.CREMO_CNTR_CLAS_CD == ''){\r\n\t\t\t\tnotifySubmit('error', '부설정보 미입력', \"부설정보가 입력되지 않았습니다\", 'icon-caution');\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tconst VOLT_CD = this.volttype;\r\n\t\t\tconst CNTR_PWR = this.detail.CNTR_PWR;\r\n\t\t\tconst CNTR_CLAS_CD = this.detail.CREMO_CNTR_CLAS_CD;\r\n\t\t\t\r\n\t\t\tconst CUST_GEN_INST_CLCD = this.detail.CUST_GEN_INST_CLCD;\r\n\t\t\tconst SD_ETC_BIZ_CD = this.detail.SD_ETC_BIZ_CD;\r\n\t\t\tconst PACH_CLCD = this.detail.PACH_CLCD;\r\n\t\t\t\r\n\t\t\tconst rules = [\r\n\t\t\t\t//계약종별값 없는 경우\r\n\t\t\t\t{ condition: ({CNTR_CLAS_CD}) => !CNTR_CLAS_CD, fields: this.fieldGroups[\"G00\"] },\r\n\t\t\t\t//특례적용 값이 72인 경우 별도 rule 적용\r\n\t\t\t\t{ condition: ({SD_ETC_BIZ_CD}) => SD_ETC_BIZ_CD=='72', fields: this.fieldGroups[\"S72\"+VOLT_CD] },\r\n\t\t\t\t//모자구분코드 값이 2인 경우 별도 rule 적용\r\n\t\t\t\t{ condition: ({PACH_CLCD}) => PACH_CLCD=='2', fields: this.fieldGroups[\"P2\"+VOLT_CD] },\r\n\r\n\t\t\t\t// VOLT=1, PWR<20\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>0 && CNTR_PWR<20 && ['100','108','211','213','218','311','410','430','610'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G01\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>0 && CNTR_PWR<20 && ['905','910','915'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G02\"+VOLT_CD] },\r\n\t\t\t\t// VOLT=1, PWR>=20\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['100'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G01\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['213'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G04\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['211','218','311','410','430'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G03\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['610'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G04\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['905'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G02\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && CNTR_PWR>=20 && ['910','915'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G05\"+VOLT_CD] },\r\n\t\t\t\t// VOLT=1\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD}) => VOLT_CD==1 && ['222','223','226','228','231','232','233','236','238','322','332','431','432','526','536','726','736','746'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G06\"+VOLT_CD] },\r\n\t\t\t\t// VOLT=1, PWR 0 or null\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD,CNTR_PWR}) => VOLT_CD==1 && (!CNTR_PWR || CNTR_PWR==0) && ['211','915'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G06\"+VOLT_CD] },\r\n\t\t\t\t// VOLT=1 ELSE\r\n\t\t\t\t{ condition: ({VOLT_CD}) => VOLT_CD==1, fields: this.fieldGroups[\"G07\"+VOLT_CD] },\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t// VOLT=2\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD}) => VOLT_CD==2 && ['100'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G01\"+VOLT_CD] },\r\n\t\t\t\t{ condition: ({VOLT_CD,CNTR_CLAS_CD}) => VOLT_CD==2 && ['108','222','223','226','228','231','232','233','236','238','322','332','410','431','432','526','536','610','726','736','746','905','910','915'].includes(CNTR_CLAS_CD), fields: this.fieldGroups[\"G06\"+VOLT_CD] },\r\n\t\t\t\t// VOLT=2 ELSE\r\n\t\t\t\t{ condition: ({VOLT_CD}) => VOLT_CD==2, fields: this.fieldGroups[\"G08\"+VOLT_CD] },\r\n\t\t\t];\r\n\t\t\t\r\n\t\t\tlet enableFields = [];\r\n\t\t\t// 매칭되는 룰 찾기\r\n\t\t\tfor (let rule of rules) {\r\n\t\t\t    if (rule.condition({VOLT_CD, CNTR_PWR, CNTR_CLAS_CD, SD_ETC_BIZ_CD, PACH_CLCD})) {\r\n\t\t\t        enableFields = rule.fields;\r\n\t\t\t        break;\r\n\t\t\t    }\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar imgList = [];\r\n\t\t\tenableFields = enableFields.map(field => field.replace('DGD_', 'CGD_'));\r\n\t\t\tenableFields.forEach(field => {\r\n\t\t\t\tif(field.endsWith('QTT') && !field.includes(\"GENERATION\")){\r\n\t\t\t\t\tconst fieldMap = {\r\n\t\t\t\t\t\t\"CGD_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_3\",\r\n\t\t\t\t\t\t\"CGD_WHME_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_4\",\r\n\t\t\t\t\t\t\"CGD_WHME_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_5\",\r\n\t\t\t\t\t\t\"CGD_DM_MT_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_6\",\r\n\t\t\t\t\t\t\"CGD_DM_MT_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_7\",\r\n\t\t\t\t\t\t\"CGD_DM_MT_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_8\",\r\n\t\t\t\t\t\t\"CGD_VAR_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_9\",\r\n\t\t\t\t\t\t\"CGD_VAR_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_10\",\r\n\t\t\t\t\t\t\"CGD_VAR_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_11\",\r\n\t\t\t\t\t\t\"CGD_AEXST_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_3\",\r\n\t\t\t\t\t\t\"CGD_AEXST_WHME_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_4\",\r\n\t\t\t\t\t\t\"CGD_AEXST_WHME_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_5\",\r\n\t\t\t\t\t\t\"CGD_AEXST_DM_MT_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_6\",\r\n\t\t\t\t\t\t\"CGD_AEXST_DM_MT_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_7\",\r\n\t\t\t\t\t\t\"CGD_AEXST_DM_MT_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_8\",\r\n\t\t\t\t\t\t\"CGD_AEXST_VAR_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_9\",\r\n\t\t\t\t\t\t\"CGD_AEXST_VAR_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_10\",\r\n\t\t\t\t\t\t\"CGD_AEXST_VAR_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_11\",\r\n\t\t\t\t\t\t\"CGD_GENT_WHM_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_12\",\r\n\t\t        \t\t\"CGD_ESS_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_13\",\r\n\t\t\t\t\t};\r\n\t\t\t\t\tconst mappedField = fieldMap[field] || field;\r\n\t\t\t\t\timgList.push(mappedField);\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\tfor (const field of enableFields) {\r\n\t\t\t\tif(field.endsWith('QTT') && !field.includes(\"GENT\") && !field.includes(\"GENERATION\") && !field.includes(\"ESS\")){\r\n\t\t\t\t\tif(this.detail[field] === '' || this.detail[field] === undefined){\r\n\t\t\t\t\t\tnotifySubmit('error', '부설정보 미입력', \"부설 지침정보가 입력되지 않았습니다\", 'icon-caution');\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tlet hasImage = false;\r\n\t\t\tfor (const field of imgList) {\r\n\t\t\t    if ((this.detail[field + \"_SRC\"] && this.detail[field + \"_SRC\"] !== '') || \r\n\t\t\t        (this.detail[field] && this.detail[field] !== '')) {\r\n\t\t\t        hasImage = true;\r\n\t\t\t        break;\r\n\t\t\t    }\r\n\t\t\t}\r\n\r\n\t\t\tif (!hasImage) {\r\n\t\t\t    notifySubmit('error', '부설정보 미입력', \"부설 사진촬영이 완료되지 않았습니다\", 'icon-caution');\r\n\t\t\t    return false;\r\n\t\t\t}\r\n\t\t\treturn true;\r\n\t\t},\r\n\t\tcheckBeforeSave: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {\r\n\t\t\t\tHDQR_CD: this.detail.HDQR_CD,\r\n\t\t\t\tCONS_NO: this.detail.CONS_NO,\r\n\t\t\t\tCONS_TGT_SEQNO: this.detail.CONS_TGT_SEQNO,\r\n\t\t\t};\r\n\r\n\t\t\treturn mobMtr5000Api.checkBeforeSave(params).then(function (response) {\r\n\t\t\t    return response.data.CNT;\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetCurDate: function(){\r\n\t\t\tif(this.detail.ACT_DATE != ''){\r\n\t\t\t\tthis.actDateYmd = moment(this.detail.ACT_DATE, 'YYYYMMDD HH:mm').format('YYYY-MM-DD');\r\n\t\t\t\tthis.actDateH = moment(this.detail.ACT_DATE, 'YYYYMMDD HH:mm').format('HH');\r\n\t\t\t\tthis.actDateM = moment(this.detail.ACT_DATE, 'YYYYMMDD HH:mm').format('mm');\r\n\t\t\t}else{\r\n\t\t\t\t\r\n\t\t\t\tif(this.detail.WORK_STEP == '25' || this.detail.WORK_STEP == '28'){\r\n\t\t\t\t\tthis.actDateYmd = moment(this.detail.REG_DATE, 'YYYYMMDD HH:mm').format('YYYY-MM-DD');\r\n\t\t\t\t\tthis.actDateH = moment(this.detail.REG_DATE, 'YYYYMMDD HH:mm').format('HH');\r\n\t\t\t\t\tthis.actDateM = moment(this.detail.REG_DATE, 'YYYYMMDD HH:mm').format('mm');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tconst now = moment();\r\n\t\t\t\t\tthis.actDateYmd = now.format('YYYYMMDD');\r\n\t\t\t\t\tthis.actDateH = now.format('HH');\r\n\t\t\t\t\tthis.actDateM = now.format('mm');\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t}\r\n\t\t},\r\n\t\tcheckNumberFormat: function(val, totalDigit){\r\n\t\t\tif(val != ''){\r\n\t\t\t\tconst intDegit = totalDigit;\r\n\t\t\t\tconst decimalDigit = 6 - totalDigit;\r\n\t\t\t\t\r\n\t\t\t\tvar regex = '';\r\n\t\t\t\tif(totalDigit == 6){\r\n\t\t\t\t\tregex = new RegExp(`^\\\\d{1,${intDegit}}$`);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tregex = new RegExp(`^\\\\d{1,${intDegit}}(\\\\.\\\\d{1,${decimalDigit}})?$`);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tif(regex.test(val)){\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}else{\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\tzoomIn: function(){\r\n\t\t\tif((this.album.currentZoom + this.album.zoomStep) <= this.album.zoomRange.max){\r\n\t\t\t\tthis.album.currentZoom += this.album.zoomStep;\r\n\t\t\t\tthis.applyZoom(); \r\n\t\t\t}\r\n\t\t},\r\n\t\tzoomOut: function(){\r\n\t\t\tif((this.album.currentZoom - this.album.zoomStep) >= this.album.zoomRange.min){\r\n\t\t\t\tthis.album.currentZoom = this.album.currentZoom - this.album.zoomStep;\r\n\t\t\t\tthis.applyZoom(); \r\n\t\t\t}\r\n\t\t},\r\n\t\tapplyZoom: async function(){\r\n\t\t\tif(!this.album.videoTrack) return;\r\n\t\t\t\r\n\t\t\ttry{\r\n\t\t\t\tawait this.album.videoTrack.applyConstraints({\r\n\t\t\t\t\tadvanced: [{ zoom: parseFloat(this.album.currentZoom) }]\r\n\t\t\t\t})\r\n\t\t\t}catch(err){\r\n\t\t\t\talert(\"error \"