';\r\n\t\t\t\tvar bValue = b[order] || '';\r\n\t        \treturn sortDirection === 'DESC'\r\n\t            \t? bValue.localeCompare(aValue)\r\n\t            \t: aValue.localeCompare(bValue); \r\n\t        });\r\n\t\t},\r\n\t\tsubTitle(){\r\n\t\t\tswitch(this.orgSts){\r\n\t\t\t\tcase '10':\r\n\t\t\t\t\treturn ' - 신설';\r\n\t\t\t\tcase '20':\r\n\t\t\t\t\treturn ' - 철거';\r\n\t\t\t\tcase '30':\r\n\t\t\t\t\treturn ' - 교체';\r\n\t\t\t\tcase '40':\r\n\t\t\t\t\treturn ' - 재봉인';\r\n\t\t\t\tdefault:\r\n\t\t\t\t\treturn '';\r\n\t\t\t}\r\n\t\t},\r\n\t\tgroupData(){\r\n\t\t\tthis.addrMap.clear(); \r\n\t\t\tthis.mainList.data.forEach(item => {\r\n\t\t\t\tconst key = item.WRK_PLCE_ADDR_CTT;\r\n\t\t\t\tif(!this.addrMap.has(key)){\r\n\t\t\t\t\tthis.addrMap.set(key,[]);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tthis.addrMap.get(key).push(item);\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\treturn Object.fromEntries(this.addrMap);\r\n\t\t\t\r\n\t\t}\r\n\t},\r\n\t//데이터 감시\r\n\twatch: {\r\n\t\tworkStepFilter: 'resetSelections',\r\n\t\t//searchKeyword: 'resetSelections',\r\n\t\tbusiKey: 'resetSelections',\r\n\t\t'radio':{\r\n\t\t\thandler: function(val, oldVal){\r\n\t\t\t\tthis.workStepFilter = ['20', '25', '28'];\r\n\t\t\t\tthis.sortKey = '';\r\n\t\t\t\tthis.busiKey = '';\r\n\t\t\t\tthis.searchKeyword = '';\r\n\t\t\t\tthis.checkedItems = [];\r\n\t\t\t\tthis.selectAll = false;\r\n\t\t\t\tthis.setConfList();\r\n\t\t\t\tthis.setMainList();\r\n\t\t\t}\r\n\t\t},\r\n\t\tsortKey: {\r\n\t\t\thandler: function(){\r\n\t\t\t\tthis.fnSearch();\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.data': {\r\n\t\t\thandler: function(val, oldVal) {\r\n\t\t\t\tif(this.mainList.enableevent) {\r\n\t\t\t\t\tvar vm = this;\r\n\t\t\t\t\tval.filter(function(data, rowposition) {\r\n\t\t\t\t\t\treturn Object.keys(data).some(function(colNm) {\r\n\t\t\t\t\t\t\tvar diff = data[colNm] !== vm.mainList.beforeData[rowposition][colNm];\r\n\t\t\t\t\t\t\tif(diff) {\r\n\t\t\t\t\t\t\t\tvm.mainList.beforeData[rowposition][colNm] = data[colNm];\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tdeep: true\r\n\t\t},\r\n\t\t'mainList.rowposition': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tif(this.mainList.enableevent){\r\n\t\t\t\t\tvar changeYn = this.mainList.dataCompare(oldVal);\r\n\t\t\t\t\tvar rowType = this.mainList.getRowType(val);\r\n\t\t\t\t\tif(!changeYn){\r\n\t\t\t\t\t\tthis.mainList.setDefaultRow(oldVal);\r\n\t\t\t\t\t}\r\n\t\t            this.$validator.reset();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainListPaging.currentPage': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tthis.setMainList(null, val);\r\n\t\t\t}\r\n\t\t},\t\t\r\n\t\t'mainList.currentRow':{\r\n\t\t\thandler: function(){\r\n\t\t\t\tvar self = this;\r\n\t\t\t\tself.skipWatch = true;\r\n\t\t\t\tself.$nextTick(() => { self.skipWatch = false; });\r\n\t\t\t},\r\n\t\t},\r\n\t},\r\n\t//마운트 된 시점수행\r\n\tmounted: async function(){\t\t\r\n\t\tawait this.setBusiList();\r\n\t\tthis.setCommonCode();\r\n\t\tawait this.setConfList();\r\n\t\tawait this.setMainList();\r\n\t},\r\n\t//함수\r\n\tmethods: {\r\n\t\tsetMainList: async function(e, pPageNo){\r\n\t\t\tvar self = this;\r\n\t\t\tvar pageNo = pPageNo;\r\n\t\t\tvar rowCount = self.mainListPaging.getRowCnt();\r\n\r\n\t\t\tif(isNull(pageNo)) pageNo = 1;\r\n\t\t\tif(isNull(rowCount)) rowCount = 100;\r\n\t\t\t\r\n\t\t\tvar params = {\r\n\t\t\t\tFLAG : self.radio,\r\n\t\t\t\tDEPT1 : self.session.DEPT1,\r\n\t\t\t\tbusiKey : this.busiKey,\r\n\t\t\t\tsearchVal : this.searchKeyword,\r\n\t\t\t\tsortKey : this.sortKey,\r\n\t\t\t\tworkStep: this.workStepFilter.join(','),\r\n\t\t\t\tpPageNo : pageNo,\r\n\t\t\t\tpRowCount : rowCount,\r\n\t\t\t};\r\n\t\t\t\r\n\t\t\tvar returnVal = mobMtr1000Api.getMainList(params);\t\t\r\n\t\t\t\r\n\t\t\tawait returnVal.then(function(response) {\r\n\t\t\t\tself.selectAll = false;\r\n\t\t\t\tself.checkedItems = [];\r\n\t\t\t\tself.locationsList = [];\r\n\t\t\t\tself.mainList.setData(response.data);\r\n\t\t\t\tif(self.mainList.getRowCount() > 0){\r\n\t\t\t\t\tself.totalCount = self.mainList.data[0].CNT; //목록전체 개수를 저장\r\n\t\t\t\t\tself.mainListPaging.setTotalCnt(self.totalCount);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tself.mainListPaging.setTotalCnt(0);\r\n\t\t\t\t\tself.totalCount = 0;\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tfnSearch: function(){\r\n\t\t\tvar pageNo = this.mainListPaging.getCurrentPage();\r\n\t\t\tif(pageNo == 1){\r\n\t\t\t\tthis.setMainList();\r\n\t\t\t}else{\r\n\t\t\t\tthis.mainListPaging.movePage(1);\r\n\t\t\t}\r\n\t\t},\r\n\t\tsetDept: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\t\t\tvar returnVal = mobMtr1000Api.getDept();\r\n\t\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.deptList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetBusiList: async function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {\r\n\t\t\t\tDEPT1 : self.session.DEPT1,\r\n\t\t\t};\r\n\t\t\tvar returnVal = mobMtr1000Api.getBusiList(params);\r\n\t\t\t\r\n\t\t\tawait returnVal.then(function(response) {\r\n\t\t\t\tself.busiList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetUserList: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\t\t\tvar returnVal = mobMtr1000Api.getUserList();\r\n\t\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.userList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetUserWorkGroup: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\t\t\tvar returnVal = mobMtr1000Api.getUserWorkGroup();\r\n\t\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.userWorkList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tsetCommonCode: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\t\t\tvar returnVal = mobMtr1000Api.getCommonCode();\r\n\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.codeList.setRawData(response.data);\r\n\t\t\t});\r\n\t\t},\r\n\t\tresetRows: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar para