ach(field => {\r\n\t\t        this.disabledFields[field] = false;\r\n\t\t        if(field.endsWith('QTT') && !field.includes(\"GENERATION\")){\r\n\t\t\t\t\tthis.detail[field] = this.detail[field] == ''?\"0\":this.detail[field];\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t        /*\r\n\t\t        if(field.endsWith('QTT') && !field.includes(\"GENERATION\")){\r\n\t\t\t\t\tthis.detail[field] = this.detail[field] == ''?\"0\":this.detail[field];\r\n\t\t            const fieldMap = {\r\n\t\t                \"CGD_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_3\",\r\n\t\t                \"CGD_WHME_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_4\",\r\n\t\t                \"CGD_WHME_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_5\",\r\n\t\t                \"CGD_DM_MT_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_6\",\r\n\t\t                \"CGD_DM_MT_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_7\",\r\n\t\t                \"CGD_DM_MT_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_8\",\r\n\t\t                \"CGD_VAR_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_9\",\r\n\t\t                \"CGD_VAR_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_10\",\r\n\t\t                \"CGD_VAR_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_11\",\r\n\t\t                \"CGD_GENT_WHM_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_12\",\r\n\t\t                \"CGD_ESS_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_13\"\r\n\t\t            };\r\n\t\t            const mappedField = fieldMap[field] || field;\r\n\r\n\t\t            this.album.stageList.push(mappedField);\r\n\t\t            this.album.totalAlbumStageCount++;\r\n\t\t            this.album.totalAlbumPageCount++;\r\n\t\t        }\r\n\t\t        */\r\n\t\t    });\r\n\t\t    \r\n\t\t    const stf = this.stageByField1;\r\n\t\t\tfor(const key in stf){\r\n\t\t\t\tthis.album.stageList.push(key);\r\n\t\t\t\tthis.album.totalAlbumStageCount++;\r\n\t\t\t\tthis.album.totalAlbumPageCount++;\r\n\t\t\t}\r\n\t\t    \r\n\t\t\tif(clear){\r\n\t\t\t\tthis.updateDgts();\r\n\t\t\t}\r\n\t\t},\r\n\t\tselectPhotos: async function(){\r\n\t\t\tconst keys = [\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_3',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_4',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_5',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_6',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_7',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_8',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_9',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_10',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_11',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_12',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_13',\r\n\t\t\t];\r\n\t\t\tvar params = {};\r\n\r\n\t\t\tkeys.forEach(key => {\r\n\t\t\t    const value = this.detail[key];\r\n\t\t\t    if (value !== null && value !== undefined && value !== '') {\r\n\t\t\t    \tparams[key] = value;\r\n\t\t\t    }\r\n\t\t\t});\r\n\r\n\t\t\tif (Object.keys(params).length === 0) {\r\n\t\t\t    return;\r\n\t\t\t}\r\n\r\n\t\t\tvar returnVal = mobMtr4000Api.selectPhotos(params);\r\n\t\t\treturnVal.then(async (response) => {\r\n\t\t\t    if (response.data.length > 0) {\r\n\r\n\t\t\t        for (const item of response.data) {\r\n\r\n\t\t\t            const blob = await (await fetch(item.imageSrc)).blob();\r\n\t\t\t            const blobUrl = URL.createObjectURL(blob);\r\n\t\t\t            this.album.imgBlobByColumnName[item.ATCH_COL] = blob;\r\n\t\t\t            this.album.imgUrlByColumnName[item.ATCH_COL] = blobUrl;\r\n\t\t\t            const albumImg = document.getElementById(\"img.\" + item.ATCH_COL);\r\n\t\t\t            const pageImg = document.getElementById(\"img.page.\" + item.ATCH_COL);\r\n\r\n\t\t\t            if (albumImg) albumImg.src = blobUrl;\r\n\t\t\t            if (pageImg) pageImg.src = blobUrl;\r\n\t\t\t        }\r\n\t\t\t    }\r\n\t\t\t});\r\n\t\t},\r\n\t\tshowAlbum: function() {\r\n\t\t    this.album.currentStage = this.album.stageList[0];\r\n\t\t    this.album.currentAlbumStageIndex = 1;\r\n\t\t    this.album.title = this.album.titleByColumnName[this.album.currentStage];\r\n\t\t    //this.album.isShown = true;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t\tmodal_open('albumDialog');\r\n\t\t    const video = document.getElementById(\"camera-video\");\r\n\t\t    let vT = null;\r\n\t\t    \r\n\t\t    // 후면 카메라 선택 (환경 모드 우선)\r\n\t\t    const videoConstraints = { facingMode: \"environment\" };\r\n\t\t    navigator.mediaDevices.getUserMedia({ video: videoConstraints })\r\n\t\t    .then((stream) => {\r\n\t\t        this.album.currentStream = stream;\r\n\t\t        video.srcObject = stream;\r\n\t\t        video.onloadedmetadata = () => {\r\n\t\t            video.play();\r\n\t\t        };\r\n\t\t        \r\n\t\t        //줌IN,OUT을 위한 값\r\n\t\t        vT = stream.getVideoTracks()[0];\r\n\t\t        this.album.videoTrack = vT; \r\n\t\t        \r\n\t\t        const capabilities = vT.getCapabilities();\r\n\t\t        \r\n\t\t       if(capabilities.zoom){\r\n\t\t\t\t\tthis.album.zoomRange.min = capabilities.zoom.min;\r\n\t\t\t\t\tthis.album.zoomRange.max = capabilities.zoom.max;\r\n\t\t\t\t\tthis.album.currentZoom = capabilities.zoom.min;\r\n\t\t\t\t}\r\n\t\t    })\r\n\t\t    .catch((error) => {\r\n\t\t        console.error(\"카메라 접근 오류:\", error);\r\n\t\t        output.textContent = \"❌ 카메라 접근 실패!\";\r\n\t\t    });\r\n\t\t    this.closeAlbumPage();\r\n\t\t},\r\n\t\ttakePicture: async function() {\r\n\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\tconst canvas = document.getElementById(\"canvas-video\");\r\n\t\t\tconst context = canvas.getContext(\"2d\");\r\n\t\t\t\r\n\t\t\t// ===== 설정값 =====\r\n\t\t\tconst SIZE_LIMIT = 500 * 1024; // 500KB\r\n\t\t\tconst MAX_WIDTH = 1280;\r\n\t\t\tconst MAX_HEIGHT = 1280;\r\n\t\t\tconst QUALITY = 0.8; // 0~1\r\n\t\t\tconst MIME_TYPE = \"image/jpeg\";\r\n\r\n\t\t\tcanvas.width = video.videoWidth;\r\n\t\t\tcanvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0);\r\n\r\n\t\t\tconst originalBlob = await new Promise(resolve =>\r\n\t\t\t\tcanvas.toBlob(resolve, MIME_TYPE, 1.0)\r\n\t\t\t);\r\n\r\n\t\t\tlet finalBlob = originalBlob;\r\n\r\n\t\t\tif (originalBlob.size > SIZE_LIMIT) {\r\n\t\t\t\tconst img = new Image();\r\n\t\t\t\timg.src = URL.createObjectURL(originalBlob);\r\n\r\n\t\t\t\tawait new Promise(res => (img.onload = res));\r\n\r\n\t\t\t\tlet { width, height } = img;\r\n\t\t\t\tconst ratio = Math.min(\r\n\t\t\t\t\tMAX_WIDTH / width,\r\n\t\t\t\t\tMAX_HEIGHT / height,\r\n\t\t\t\t\t1\r\n\t\t\t\t);\r\n\r\n\t\t\t\tconst resizeCanvas = document.createElement(\"canvas\");\r\n\t\t\t\tresizeCanvas.width = Math.round(width * ratio);\r\n\t\t\t\tresizeCanvas.height = Math.round(height * ratio);\r\n\r\n\t\t\t\tconst rctx = resizeCanvas.getContext(\"2d\");\r\n\t\t\t\trctx.drawImage(img, 0, 0, resizeCanvas.width, resizeCanvas.height);\r\n\r\n\t\t\t\tfinalBlob = await new Promise(resolve =>\r\n\t\t\t\t\tresizeCanvas.toBlob(resolve, MIME_TYPE, QUALITY)\r\n\t\t\t\t);\r\n\t\t\t}\r\n\t\t\tconst blobUrl = URL.createObjectURL(finalBlob);\r\n\t\t\t\r\n\t\t\t/*\r\n\t\t    canvas.width = video.videoWidth;\r\n\t\t    canvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0, canvas.width, canvas.height);\r\n\t\t\tconst blob = await new Promise(resolve => canvas.toBlob(resolve, \"image/png\"));\r\n\t\t\tconst blobUrl = URL.createObjectURL(blob);\r\n\t\t\t*/\r\n\t\t\tthis.album.imgBlobByColumnName[this.album.currentStage] = finalBlob;\r\n\t\t\tthis.album.imgUrlByColumnName[this.album.currentStage] = blobUrl;\r\n\t\t\tconst img = document.getElementById(\"img.\" + this.album.currentStage);\r\n\t\t\timg.src = blobUrl;\r\n\t\t\tthis.detail[this.album.currentStage + \"_SRC\"] = blobUrl;\r\n\t\t\t\r\n\t\t\t\r\n\t\t    this.triggerFlash();\r\n\t\t    video.style.display = \"none\";\r\n\t\t    img.style.display = \"\";\r\n\t\t    setTimeout(() => {\r\n\t\t    \timg.style.display = \"none\";\r\n\t\t    \tvideo.style.display = \"\";\r\n\t\t\t\tif(this.album.currentAlbumStageIndex == this.album.stageList.length)\r\n\t\t\t\t\tthis.closeAlbum();\r\n\t\t\t\telse{\r\n\t\t\t\t\tthis.nextStage();\r\n\t\t\t\t}\r\n\t\t    }, 1000);\r\n\t\t\t\r\n\t\t\tconst fieldMap = {\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_3\" : \