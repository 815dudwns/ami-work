loseCtModal\">취소</button>\r\n\t                                    <button v-if=\"detail.WORK_STEP != '28'\" type=\"button\" class=\"btn type01 size-m c-primary\" @click=\"messagePopup('25')\">임시저장</button>\r\n\t                                </div>\r\n\t                            </div>\r\n\t                        </div>  \r\n\t                    </div>\r\n\t                    <div class=\"btn-r\">\r\n\t                        <a href=\"#\" class=\"cbtn\" style=\"display: inline-block;\" title=\"닫기\" @click=\"closeCtModal\"><span class=\"icon-exit\"></span></a>\r\n\t                    </div>\r\n\t                </div>\r\n\t            </div>\r\n\t        </div>\r\n\t    </transition>\r\n\t    <modal-message :modalset=\"messageModal\" v-on:messagepoppupcallback=\"messagePopupCallback\"></modal-message>\r\n\t\t<barcode-reader ref=\"barcodeReader\" id=\"barcode_reader\" title=\"바코드 테스트\" @callback=\"receiveBarcode\"></barcode-reader>\r\n\t</div>\r\n    `,\r\n    mounted: function() {\r\n\t\t\r\n    },\r\n    methods: {\r\n\t\tcallBackEvent: function(){\r\n\t\t\tthis.$emit('callbackevt', -1);\r\n\t\t},\r\n\t\tmessagePopup: function(pId) {\r\n\t\t\tvar title = '확인';\r\n\t\t\tvar cont = '해당 작업을 수행하시겠습니까?';\r\n\t\t\tswitch(pId) {\r\n\t\t\t\tcase '25':\r\n\t\t\t\t\ttitle = '임시저장';\r\n\t\t\t\t\tcont = '변경 사항을 임시저장하시겠습니까?';\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tthis.messageModal.openModal('confirm', title, cont, 'small', pId);\r\n\t\t},\r\n\t\tmessagePopupCallback: function(pGb, pId) {\r\n\t\t\tif(pGb!='confirm') return;\r\n\t\t\tthis.validateRow(pId);\r\n\t\t},\r\n\t\tvalidateRow: function(pId){\r\n\t\t\tvar self = this;\r\n\t\t\tvar validate = this.$validator.validateAll();\r\n\t\t\tvalidate.then(function(response){\r\n\t\t\t\tif(response){\r\n\t                self.saveRow(pId);\r\n\t            }else {\r\n\t\t\t\t    self.$validator.errors.items.forEach(function(error) {\r\n\t\t\t\t\t    var fieldName = error.field; \r\n\t\t\t\t\t    var inputElement = self.$refs[fieldName];\r\n\t\t\t\t\t    if (inputElement) {\r\n\t\t\t\t\t        inputElement.focus();\r\n\t\t\t\t\t        return; \r\n\t\t\t\t\t    }\r\n\t\t\t\t    });\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tsaveRow: function(pId){\r\n\t\t\tvar self = this;\r\n\t\t\tself.detail.STATUS = self.status;\r\n\t\t\tvar params = _.cloneDeep(self.detail);\r\n\t\t\tparams.EX_WORK_STEP = self.detail.WORK_STEP;\t\t\t\t\t\t\r\n\t\t\tparams.WORK_STEP = pId;\r\n\t\t\tvar returnVal;\r\n\t\t\t\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 701;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t\tself.detail[self.status+'CT_YN'] = 'Y';\r\n\t\t\tmodal_close('modal_ct');\r\n\t\t},\r\n\t\treadBarcode: function(gubun){ \r\n\t\t    this.vFlmnCl = gubun;\r\n\t\t    this.$refs.barcodeReader.openBarcodeScanner(\"1d\");\r\n\t\t},\r\n\t\treceiveBarcode: function(){\r\n\t\t    var vBarcdQr = this.$refs.barcodeReader.readValue;\r\n\t\t\tthis.detail[this.vFlmnCl] = vBarcdQr;\r\n\t\t},\r\n\t\topenCtModal: function() {\r\n\t\t    this.cachedDetail = _.cloneDeep(this.detail);\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 0;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t    modal_open('modal_ct');\r\n\t\t},\r\n\t\tcloseCtModal: function() {\r\n\t\t    if (this.cachedDetail) {\r\n\t\t        Object.assign(this.detail, this.cachedDetail);\r\n\t\t    }\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 701;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t    modal_close('modal_ct');\r\n\t\t},\r\n    }\r\n });","dur":29,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01030000"}
