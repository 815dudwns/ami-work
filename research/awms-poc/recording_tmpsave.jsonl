t\t\t\t\t        </tr>\r\n\t\t\t\t\t\t\t    </tbody>\r\n\t\t\t\t\t\t\t</table>\r\n\t    \r\n\t                        <div class=\"tab-outter\">\r\n\t                            <div class=\"tab-type05\">\r\n\t                                <div class=\"tab-inner\">\r\n\t                                    <div rel=\"tab1\"><a href=\"#!\" :class=\"{'active' : activeTab == 1}\" @click=\"activeTab = 1\">변류기(CT)</a></div>\r\n\t                                </div>\r\n\t                            </div>\r\n\t                        </div>\r\n\t                        <div class=\"tab-container type05\">\r\n\t                            <div id=\"tab1\" class=\"tab-content\" v-if=\"activeTab == 1\">\r\n\t                                <div class=\"inner-box\">\r\n\t                                    <table class=\"table-type33\">\r\n\t                                        <caption>부속설비 변류기(CT) 정보를 항목별 순서대로 안내하는 표입니다</caption>\r\n\t                                        <colgroup>\r\n\t                                            <col width=\"20%\">\r\n\t                                            <col width=\"30%\">\r\n\t                                            <col width=\"20%\">\r\n\t                                            <col width=\"30%\">\r\n\t                                        </colgroup>\r\n\t                                        <tbody>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0101\">자재번호</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t                                                    <div class=\"flex\">\r\n\t                                                        <input v-model=\"detail[status+'CT_MATL_NO']\" type=\"text\" maxlength=\"20\" id=\"form0101\" class=\"size-m\" placeholder=\"바코드촬영\">\r\n\t                                                    </div>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0102\">1차전류</label></th>\r\n\t                                                <td>\r\n\t                                                    <input v-model=\"detail[status+'CT_TS1_CURR']\" type=\"number\" inputmode=\"numeric\" oninput=\"numberMaxLng(this, 10)\" id=\"form0102\" class=\"size-m\">\r\n\t                                                </td>\r\n\t                                                <th scope=\"row\"><label for=\"form010202\">1차전류 SA</label></th>\r\n\t                                                <td>\r\n\t                                                    <input v-model=\"detail[status+'CT_TS1_CRN_SCRT_COEF']\" type=\"number\" inputmode=\"numeric\" oninput=\"numberMaxLng(this, 10)\" id=\"form010202\" class=\"size-m\">\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0103\">배수</label></th>\r\n\t                                                <td>\r\n\t                                                    <input v-model=\"detail[status+'CT_TS1_CRN_MLTV']\" type=\"number\" inputmode=\"numeric\" oninput=\"numberMaxLng(this, 10)\" id=\"form0103\" class=\"size-m\">\r\n\t                                                </td>\r\n\t                                                <th scope=\"row\"><label for=\"form0104\">PT비</label></th>\r\n\t                                                <td>\r\n\t                                                    <input v-model=\"detail[status+'CT_PT_TRRT']\" type=\"number\" id=\"form0104\" class=\"size-m\"  oninput=\"numberMaxLng(this, 10)\">\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0105\">변류기 계급</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t                                                    <select v-model=\"detail[status+'CT_CPT_GRADE_CD']\" id=\"form0105\" class=\"size-m\">\r\n\t                                                        <option value=\"\">선택</option>\r\n\t                                                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'JC061')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n\t                                                    </select>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                        </tbody>\r\n\t                                    </table>\r\n\t\t\t\t\t\t\t\t\t\t<details>\r\n\t                                    <summary><h3 class=\"h3 type02\">변류기1</h3></summary>\r\n\t                                    <table class=\"table-type33\">\r\n\t                                        <caption>부속설비 변류기(CT) 정보를 항목별 순서대로 안내하는 표입니다</caption>\r\n\t                                        <colgroup>\r\n\t                                            <col width=\"20%\">\r\n\t                                            <col width=\"30%\">\r\n\t                                            <col width=\"20%\">\r\n\t                                            <col width=\"30%\">\r\n\t                                        </colgroup>\r\n\t                                        <tbody>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0201\">제조업체</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t  