us+'MB_MATL_NO']\" id=\"form0101\" class=\"size-m\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t    <option value=\"\">선택</option>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t    <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'MTR009')\" :value=\"item.C_CODE\">{{ item.C_CODE+'/'+ item.C_CODE_NM }}</option>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</select>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            <template v-if=\"status == 'C'\">\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0104\">소유구분</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t                                                    <select v-model=\"detail.CMB_POSS_CLCD\" id=\"form0104\" class=\"size-m\">\r\n\t                                                        <option value=\"\">선택</option>\r\n\t                                                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'JC015')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n\t                                                    </select>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            </template>\r\n\t                                            <template v-if=\"status == 'D'\">\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0102\">철거사유</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t                                                    <select v-model=\"detail.DMB_DISM_RSN_CD\" id=\"form0102\" class=\"size-m\">\r\n\t                                                        <option value=\"\">선택</option>\r\n\t                                                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'JA041')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n\t                                                    </select>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            <tr>\r\n\t                                                <th scope=\"row\"><label for=\"form0103\">환입구분</label></th>\r\n\t                                                <td colspan=\"3\">\r\n\t                                                    <select v-model=\"detail.DMB_PURC_CLCD\" id=\"form0103\" class=\"size-m\">\r\n\t                                                        <option value=\"\">선택</option>\r\n\t                                                        <option v-for=\"item in codeList.rawData.filter(item => item.P_CODE == 'YZ016')\" :value=\"item.C_CODE\">{{ item.C_CODE_NM }}</option>\r\n\t                                                    </select>\r\n\t                                                </td>\r\n\t                                            </tr>\r\n\t                                            </template>\r\n\t                                        </tbody>\r\n\t                                    </table>\r\n\t                                </div>\r\n\t                                <div class=\"btn-line d-flex between\">\r\n\t                                    <button type=\"button\" class=\"btn type01 size-m c-primary\" @click=\"closeMbModal\">취소</button>\r\n\t                                    <button type=\"button\" class=\"btn type01 size-m c-primary\" @click=\"messagePopup('25')\">임시저장</button>\r\n\t                                </div>\r\n\t                            </div>\r\n\t                        </div>\r\n\t                    </div>\r\n\t                    <div class=\"btn-r\">\r\n\t                        <a href=\"#\" class=\"cbtn\" style=\"display: inline-block;\" title=\"닫기\" @click=\"closeMbModal\"><span class=\"icon-exit\"></span></a>\r\n\t                    </div>\r\n\t                </div>\r\n\t            </div>\r\n\t        </div>\r\n\t    </transition>\r\n\t    <modal-message :modalset=\"messageModal\" v-on:messagepoppupcallback=\"messagePopupCallback\"></modal-message>\r\n\t\t<barcode-reader ref=\"barcodeReader\" id=\"barcode_reader\" title=\"바코드 테스트\" @callback=\"receiveBarcode\"></barcode-reader>\r\n\t</div>\r\n    `,\r\n\tmounted: function() {\r\n\t\t\r\n\t},\r\n\tmethods: {\r\n\t\tinit: function(){\r\n\t\t\tif(this.detail[this.status+'MB_YN'] !== 'Y'){\r\n\t\t\t\tthis.detail.DMB_DISM_RSN_CD = '1';\r\n\t\t\t\tthis.detail.DMB_PURC_CLCD = '4';\r\n\t\t\t\tthis.detail.CMB_POSS_CLCD = '1';\r\n\t\t\t}\r\n\t\t},\r\n\t\tcallBackEvent: function(){\r\n\t\t\tthis.$emit('callbackevt', -1);\r\n\t\t},\r\n\t\tmessagePopup: function(pId) {\r\n\t\t\tvar title = '확인';\r\n\t\t\tvar cont = '해당 작업을 수행하시겠습니까?';\r\n\t\t\tswitch(pId) {\r\n\t\t\t\tcase '25':\r\n\t\t\t\t\ttitle = '임시저장';\r\n\t\t\t\t\tcont = '변경 사항을 임시저장하시겠습니까?';\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tthis.messageModal.openModal('confirm', title, cont, 'small', pId);\r\n\t\t},\r\n\t\tmessagePopupCallback: function(pGb, pId) {\r\n\t\t\tif(pGb!='confirm') return;\r\n\t\t\tthis.validateRow(pId);\r\n\t\t},\r\n\t\tvalidateRow: function(pId){\r\n\t\t\tvar self = this;\r\n\t\t\tvar validate = this.$validator.validateAll();\r\n\t\t\tvalidate.then(function(response){\r\n\t\t\t\tif(response){\r\n\t\t\t        self.saveRow(pId);\r\n\t\t\t    }else {\r\n\t\t\t\t    self.$validator.errors.items.forEach(function(error) {\r\n\t\t\t\t\t    var fieldName = error.field; \r\n\t\t\t\t\t    var inputElement = self.$refs[fieldName];\r\n\t\t\t\t\t    if (inputElement) {\r\n\t\t\t\t\t        inputElement.focus();\r\n\t\t\t\t\t        return; \r\n\t\t\t\t\t    }\r\n\t\t\t\t    });\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\t\r\n\t\tsaveRow: function(pId){\r\n\t\t\tvar self = this;\r\n\t\t\tself.detail.STATUS = self.status;\r\n\t\t\tvar params = _.cloneDeep(self.detail);\r\n\t\t\tparams.EX_WORK_STEP = self.detail.WORK_STEP;\t\t\t\t\t\t\r\n\t\t\tparams.WORK_STEP = pId;\r\n\t\t\tvar returnVal;\r\n\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 701;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t\tself.detail[self.status+'MB_YN'] = 'Y';\r\n\t\t\tmodal_close('modal_mb');\r\n\t\t},\r\n\t\treadBarcode: function(gubun){ \r\n\t\t    this.vFlmnCl = gubun;\r\n\t\t    this.$refs.barcodeReader.openBarcodeScanner(\"1d\");\r\n\t\t},\r\n\t\treceiveBarcode: function(){\r\n\t\t    var vBarcdQr = this.$refs.barcodeReader.readValue;\r\n\t\t\tthis.detail[this.vFlmnCl] = vBarcdQr;\r\n\t\t},\r\n\t\topenMbModal: function() {\r\n\t\t    this.cachedDetail = _.cloneDeep(this.detail);\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 0;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t\tthis.init();\r\n\t\t    modal_open('modal_mb');\r\n\t\t},\r\n\t\tcloseMbModal: function() {\r\n\t\t    if (this.cachedDetail) {\r\n\t\t        Object.assign(this.detail, this.cachedDetail);\r\n\t\t    }\r\n\t\t\tdocument.getElementById(\"sub_header\").style.zIndex = 701;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t    modal_close('modal_mb');\r\n\t\t},\r\n\t}\r\n\r\n });","dur":30,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01030000"}
{"kind":"xhr","ts":1780489415355,"url":"https://awms.kdn.com/app-assets/js/api/ami/mob/mtr/MOBMTR4001.api.js","method":"GET","reqBody":"","status":200,"resBody":"function MobMtr4001Api(){}\r\nvar mobMtr4001Api = new MobMtr4001Api();\r\n\r\nMobMtr4001Api.prototype.saveRow = function(params, loading){\r\n\treturn axios.post('/ami/mob/mtr/mobMtr4001/saveRow', params);\r\n}\r\n","dur":31,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01030000"}
