  position: fixed;\r\n        top: 0;\r\n        left: 0;\r\n        width: 100%;\r\n        height: 100%;\r\n        background: white;\r\n        opacity: 0;\r\n        pointer-events: none;\r\n        animation: flash-effect 0.4s ease-out;\r\n    }\r\n    \r\n    @keyframes flash-effect {\r\n        0%   { opacity: 0; }\r\n        10%  { opacity: 1; }\r\n        100% { opacity: 0; }\r\n    }\r\n</style>\r\n<script type=\"text/javascript\">\r\n/*******************************************************************************************************************************************************************\r\n * vue start \r\n ********************************************************************************************************************************************************************/\r\n var vm = new Vue({\r\n\tel: '#app',\r\n\t//사용할 데이터\r\n\tdata: {\r\n\t\tdeptList: new Dataset(), //지사 목록\r\n\t\tcodeList: new Dataset(), //공통코드 목록\r\n\t\tbusiList: new Dataset(), //공사 목록\r\n\t\tconfList: new Dataset(), //계기관리설정데이터\r\n\t\tmainList: new Dataset(), \r\n\t\tmainListPaging: new PagingSet(10, 100),\r\n\t\t\r\n\t\tcheckedItems: [], //선택된 목록\r\n\t\tlocationsList: [],  //선택된 목록 Map 전달용\r\n\t\t\r\n\t\tworkStepFilter: ['20', '25', '28'],\r\n\t\t\r\n\t\tbusiKey: '',\r\n\t\tsortKey: '', //DCU, 모뎀/계기 목록 정렬 조건\r\n\t\tsearchKeyword: '',\r\n\t\tbeforeBusiKey: '',\r\n\t\tcallbackType: '',\r\n\t\t\r\n\t\tmessageModal: new ModalSet('modal-message'),\r\n\t\t\r\n\t\tpreviewImage: null,\r\n\t\t\r\n\t\tcurSts: '',\r\n\t\torgSts: '',\r\n\t\tunit: '10',\r\n\t\toptionList: [],\r\n\t\tselectedIndex: '',\r\n\t\t\r\n\t\tradio: '1', //DCU or 모뎀/계기 선택값\r\n\t\tselectAll: false,\r\n\t\treturnMessage: '',\t\r\n\t\t\r\n\t\tskipWatch: false,\r\n\t\tvFlmnCl: '',\r\n\t\t\r\n\t\tdetail: '',\r\n\t\tcomponentKey: 0,\r\n\t\t\r\n\t\taddrMap: new Map(),\r\n\t\t\r\n\t\talbum: {\r\n\t\t\tisShown: false,\r\n\t\t\ttitle: \"\",\r\n\t\t\topenFrom: \"\",\r\n\t\t\ttitleByColumnName: {\r\n\t\t\t\tDREMO_ATCH_FILE_