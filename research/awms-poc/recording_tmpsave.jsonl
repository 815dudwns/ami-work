of response.data) {\r\n\r\n\t\t\t            const blob = await (await fetch(item.imageSrc)).blob();\r\n\t\t\t            const blobUrl = URL.createObjectURL(blob);\r\n\t\t\t            this.album.imgBlobByColumnName[item.ATCH_COL] = blob;\r\n\t\t\t            this.album.imgUrlByColumnName[item.ATCH_COL] = blobUrl;\r\n\t\t\t            const albumImg = document.getElementById(\"img.\" + item.ATCH_COL);\r\n\t\t\t            const pageImg = document.getElementById(\"img.page.\" + item.ATCH_COL);\r\n\r\n\t\t\t            if (albumImg) albumImg.src = blobUrl;\r\n\t\t\t            if (pageImg) pageImg.src = blobUrl;\r\n\t\t\t        }\r\n\t\t\t    }\r\n\t\t\t});\r\n\t\t},\r\n\t\tshowAlbum: function() {\r\n\t\t    this.album.currentStage = this.album.stageList[0];\r\n\t\t    this.album.currentAlbumStageIndex = 1;\r\n\t\t    this.album.title = this.album.titleByColumnName[this.album.currentStage];\r\n\t\t    //this.album.isShown = true;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t\tmodal_open('albumDialog');\r\n\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\tlet vT = null;\r\n\t\t\t\r\n\t\t    // 후면 카메라 선택 (환경 모드 우선)\r\n\t\t    const videoConstraints = { facingMode: \"environment\" };\r\n\t\t    navigator.mediaDevices.getUserMedia({ video: videoConstraints })\r\n\t\t    .then((stream) => {\r\n\t\t        this.album.currentStream = stream;\r\n\t\t        video.srcObject = stream;\r\n\t\t        \r\n\t\t        video.onloadedmetadata = () => {\r\n\t\t            video.play();\r\n\t\t        };\r\n\t\t        \r\n\t\t        //줌IN,OUT을 위한 값\r\n\t\t        vT = stream.getVideoTracks()[0];\r\n\t\t        this.album.videoTrack = vT; \r\n\t\t        \r\n\t\t        const capabilities = vT.getCapabilities();\r\n\t\t        \r\n\t\t       if(capabilities.zoom){\r\n\t\t\t\t\tthis.album.zoomRange.min = capabilities.zoom.min;\r\n\t\t\t\t\tthis.album.zoomRange.max = capabilities.zoom.max;\r\n\t\t\t\t\tthis.album.currentZoom = capabilities.zoom.min;\r\n\t\t\t\t}\r\n\t\t        \r\n\t\t    })\r\n\t\t    .catch((error) => {\r\n\t\t        console.error(\"카메라 접근 오류:\", error);\r\n\t\t        output.textContent = \"❌ 카메라 접근 실패!\";\r\n\t\t    });\r\n\t\t    this.closeAlbumPage();\r\n\t\t},\r\n\t\ttakePicture: async function() {\r\n\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\tconst canvas = document.getElementById(\"canvas-video\");\r\n\t\t\tconst context = canvas.getContext(\"2d\");\r\n\r\n\t\t\t// ===== 설정값 =====\r\n\t\t\tconst SIZE_LIMIT = 500 * 1024; // 500KB\r\n\t\t\tconst MAX_WIDTH = 1280;\r\n\t\t\tconst MAX_HEIGHT = 1280;\r\n\t\t\tconst QUALITY = 0.8; // 0~1\r\n\t\t\tconst MIME_TYPE = \"image/jpeg\";\r\n\r\n\t\t\tcanvas.width = video.videoWidth;\r\n\t\t\tcanvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0);\r\n\r\n\t\t\tconst originalBlob = await new Promise(resolve =>\r\n\t\t\t\tcanvas.toBlob(resolve, MIME_TYPE, 1.0)\r\n\t\t\t);\r\n\r\n\t\t\tlet finalBlob = originalBlob;\r\n\r\n\t\t\tif (originalBlob.size > SIZE_LIMIT) {\r\n\t\t\t\tconst img = new Image();\r\n\t\t\t\timg.src = URL.createObjectURL(originalBlob);\r\n\r\n\t\t\t\tawait new Promise(res => (img.onload = res));\r\n\r\n\t\t\t\tlet { width, height } = img;\r\n\t\t\t\tconst ratio = Math.min(\r\n\t\t\t\t\tMAX_WIDTH / width,\r\n\t\t\t\t\tMAX_HEIGHT / height,\r\n\t\t\t\t\t1\r\n\t\t\t\t);\r\n\r\n\t\t\t\tconst resizeCanvas = document.createElement(\"canvas\");\r\n\t\t\t\tresizeCanvas.width = Math.round(width * ratio);\r\n\t\t\t\tresizeCanvas.height = Math.round(height * ratio);\r\n\r\n\t\t\t\tconst rctx = resizeCanvas.getContext(\"2d\");\r\n\t\t\t\trctx.drawImage(img, 0, 0, resizeCanvas.width, resizeCanvas.height);\r\n\r\n\t\t\t\tfinalBlob = await new Promise(resolve =>\r\n\t\t\t\t\tresizeCanvas.toBlob(resolve, MIME_TYPE, QUALITY)\r\n\t\t\t\t);\r\n\t\t\t}\r\n\t\t\tconst blobUrl = URL.createObjectURL(finalBlob);\r\n\t\t\t\r\n\t\t\t/*\r\n\t\t    canvas.width = video.videoWidth;\r\n\t\t    canvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0, canvas.width, canvas.height);\r\n\t\t\tconst blob = await new Promise(resolve => canvas.toBlob(resolve, \"image/png\"));\r\n\t\t\tconst blobUrl = URL.createObjectURL(blob);\r\n\t\t\t*/\r\n\t\t\tthis.album.imgBlobByColumnName[this.album.currentStage] = finalBlob;\r\n\t\t\tthis.album.imgUrlByColumnName[this.album.currentStage] = blobUrl;\r\n\t\t\tconst img = document.getElementById(\"img.\" + this.album.currentStage);\r\n\t\t\timg.src = blobUrl;\r\n\t\t\tthis.detail[this.album.currentStage + \"_SRC\"] = blobUrl;\r\n\t\t\t\r\n\t\t\t\r\n\t\t\tthis.triggerFlash();\r\n\t\t\tvideo.style.display = \"none\";\r\n\t\t\timg.style.display = \"\";\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\timg.style.display = \"none\";\r\n\t\t\t\tvideo.style.display = \"\";\r\n\t\t\t\tif(this.album.currentAlbumStageIndex == this.album.stageList.length)\r\n\t\t\t\t\tthis.closeAlbum();\r\n\t\t\t\telse{\r\n\t\t\t\t\tthis.nextStage();\r\n\t\t\t\t}\r\n\t\t\t}, 1000);\r\n\t\t\t\r\n\t\t\tconst fieldMap = {\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_3\": \"WHME_DAY\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_4\": \"WHME_EVEN\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_5\": \"WHME_MNGT\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_6\": \"DM_DAY\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_7\": \"DM_EVEN\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_8\": \"DM_MNGT\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_9\": \"VAR_DAY\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_10\": \"VAR_EVEN\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_11\": \"VAR_MNGT\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_12\": \"GENT_DAY\",\r\n\t\t\t    \"DREMO_ATCH_FILE_ID_13\": \"ESS_DAY\",\r\n\t\t\t};\r\n\r\n\t\t\tconst link = document.createElement('a');\r\n\t\t\tlink.href = blobUrl;\r\n\t\t\tlink.download = this.detail.WHM_NO + \"_\" + moment().format(\"YYYYMMDDHHmm\") + \"_\" + fieldMap[this.album.currentStage]+ '.png'; \r\n\t\t\tdocument.body.appendChild(link);\r\n\t\t\tlink.click();\r\n\t\t\tdocument.body.removeChild(link);\r\n\t\t},\t\r\n\t\tselectPicture: function() {\r\n\t\t\tconst input = document.createElement(\"input\");\r\n\t\t\tinput.type = \"file\";\r\n\t\t\tinput.accept = \"image/*\";\r\n\t\t\tinput.multiple = true;\r\n\t\t\tinput.removeAttribute(\"capture\");\r\n\t\t\t\r\n\t\t\tconst MAX_SIZE = 500 * 1024; // 500KB\r\n\t\t\tconst MAX_WIDTH = 1024;\r\n\t\t\tconst MAX_HEIGHT = 1024;\r\n\t\t\tconst QUALITY = 0.8;\r\n\t\t\t\r\n\t\t\tinput.onchange = (event) => {\r\n\t\t\t\tconst selFiles = Array.from(event.target.files);\r\n\t\t\t\tconst stf = this.stageByField1;\r\n\t\t\t\tvar fileList = [];\r\n\t\t\t\tfor(const key in stf){\r\n\t\t\t\t\t//if(!this.$refs[stf[key]]?.disabled){\r\n\t\t\t\t\t\tfileList.push(key);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tthis.album.imgBlobByColumnName[key] = '';\r\n\t\t\t\t\t\tthis.album.imgUrlByColumnName[key] = '';\r\n\t\t\t\t\t\tthis.detail[key+ \"_SRC\"] = '';\r\n\t\t\r\n\t\t\t\t\t\tconst previewImg = document.getElementById('img.'+key);\r\n\t\t\t\t\t\tpreviewImg.src = '/images/iframe/board_noimage.jpg';\r\n\t\t\t\t\t//}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tvar fileId = 0;\r\n\t\t\t\t\r\n\t\t\t\tselFiles.forEach(file => {\r\n\t\t\t\t\tif(this.album.totalAlbumStageCount == fileId){\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(file.size <= MAX_SIZE){\r\n\t\t\t\t\t\tconst blob = file;\r\n\t\t\t\t\t\tconst blobUrl = URL.createObjectURL(blob);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar fileVal = fileList[fileId];\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tthis.album.imgBlobByColumnName[fileVal] = blob;\r\n\t\t\t\t\t\tthis.album.imgUrlByColumnName[fileVal] = blobUrl;\r\n\t\t\t\t\t\tthis.detail[fileVal+ \"_SRC\"] = blobUrl;\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tconst img = document.getElementById('img.'+fileVal);\r\n\t\t\t\t\t\timg.src = blobUrl;\r\n\t\t\t\t\t\timg.classList.add('ami-img-wrap');\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tif(fileId == 0){\r\n\t\t\t\t\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\t\t\t\t\tvideo.style.display = \"none\";\r\n\t\t\t\t\t\t\timg.style.display = \"\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tfileId++;\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tconst reader = new FileReader();\r\n\t\t\t\t\t\treader.onload = (e) => {\r\n\t\t\t\t\t\t\tconst img = new Image();\r\n\t\t\t\t\t\t\timg.onload = () => {\r\n\t\t\t\t\t\t\t\tlet { width, height } = img;\r\n\t\t\t\r\n\t\t\t\t\t\t\t\tif (width > MAX_WIDTH || height > MAX_HEIGHT) {\r\n\t\t\t\t\t\t\t\t\tconst ratio = Math.min(\r\n\t\t\t\t\t\t\t\t\t\tMAX_WIDTH / width,\r\n\t\t\t\t\t\t\t\t\t\tMAX_HEIGHT / height\r\n\t\t\t\t\t\t\t\t\t);\r\n\t\t\t\t\t\t\t\t\twidth = Math.round(width * ratio);\r\n\t\t\t\t\t\t\t\t\theight = Math.round(height * ratio);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\r\n\t\t\t\t\t\t\t\tconst canvas = document.createElement('canvas');\r\n\t\t\t\t\t\t\t\tcanvas.width = width;\r\n\t\t\t\t\t\t\t\tcanvas.height = height;\r\n\t\t\t\r\n\t\t\t\t\t\t\t\tconst ctx = canvas.getContext('2d');\r\n\t\t\t\t\t\t\t\tctx.drawImage(img, 0, 0, width, height);\r\n\t\t\t\r\n\t\t\t\t\t\t\t\tcanvas.toBlob((resizedBlob) => {\r\n\t\t\t\t\t\t\t\t\tconst blobUrl = URL.createObjectURL(resizedBlob);\r\n\t\r\n\t\t\t\t\t\t\t\t\tvar fileVal = fileList[fileId];\r\n\t\r\n\t\t\t\t\t\t\t\t\tthis.album.imgBlobByColumnName[fileVal] = resizedBlob;\r\n\t\t\t\t\t\t\t\t\tthis.album.imgUrlByColumnName[fileVal] = blobUrl;\r\n\t\t\t\t\t\t\t\t\tthis.detail[fileVal+ \"_SRC\"] = blobUrl;\r\n\t\t\t\r\n\t\t\t\t\t\t\t\t\tconst previewImg = document.getElementById('img.'+fileVal);\r\n\t\t\t\t\t\t\t\t\tpreviewImg.src = blobUrl;\r\n\t\t\t\t\t\t\t\t\tpreviewImg.classList.add('ami-img-wrap');\r\n\t\t\t\r\n\t\t\t\t\t\t\t\t\tthis.detail[fileVal+ \"_SRC\"] = blobUrl;\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\tif(fileId == 0){\r\n\t\t\t\t\t\t\t\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\t\t\t\t\t\t\t\tvideo.style.display = \"none\";\r\n\t\t\t\t\t\t\t\t\t\tpreviewImg.style.display = \"\";\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\tfileId++;\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t}, 'image/jpeg', QUALITY);\r\n\t\t\t\t\t\t\t};\r\n\t\t\t\t\t\t\timg.src = e.target.result;\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t\treader.readAsDataURL(file);\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t\tthis.triggerFlash();\r\n\t\t\t\tthis.closeAlbum();\r\n\t\t\t};\r\n\r\n\t\t\t// 파일 선택창 실행\r\n\t\t\tinput.click();\r\n\t\t\t\r\n\t\t},\r\n\r\n\t\tshowAlbumPages: function(openFrom) {\r\n\t\t\tconst columnArray = Object.keys(this.album.titleByColumnName);\r\n\t\t\tcolumnArray.forEach((item) => {\r\n\t\t\t\tconst albumImg = document.getElementById(\"img.\" + item);\r\n\t\t\t\tconst pageImg = document.getElementById(\"img.page.\" + item);\r\n\t\t\t\tpageImg.src = albumImg.src;\r\n\t\t\t\tpageImg.style.display = \"none\";\r\n\t\t\t});\r\n\t\t\t//this.album.isShown = true;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t\tmodal_open('albumDialog');\r\n\t\t\tthis.album.openFrom = openFrom;\r\n\t\t\tthis.album.currentAlbumPageStage = this.album.stageList[0];\r\n\t\t    this.album.currentAlbumPageIndex = 1;\r\n\t\t\tthis.album.pageTitle = this.album.titleByColumnName[this.album.currentAlbumPageStage];\r\n\t\t\tconst img = document.getElementById(\"img.page.\" + this.album.currentAlbumPageStage);\r\n\t\t\timg.style.display = \"\";\r\n\t\t    const albumTitle = document.getElementById(\"albumTitle\");\r\n\t\t    const cameraViewDiv = document.getElementById(\"cameraViewDiv\");\r\n\t\t    const cameraControlDiv = document.getElementById(\"cameraControlDiv\");\r\n\t\t    const pageTitle = document.getElementById(\"pageTitle\");\r\n\t\t    const pageCounter = document.getElementById(\"pageCounter\");\r\n\t\t    const stageCounter = document.getElementById(\"stageCounter\");\r\n\t\t    const albumPageViewDiv = document.getElementById(\"albumPageViewDiv\");\r\n\t\t    const albumPageControlDiv = document.getElementById(\"albumPageControlDiv\");\r\n\t\t    albumTitle.style.display = \"none\";\r\n\t\t    stageCounter.style.display = \"none\";\r\n\t\t    cameraViewDiv.style.display = \"none\";\r\n\t\t    cameraControlDiv.style.display = \"none\";\r\n\t\t    pageTitle.style.display = \"\";\r\n\t\t    pageCounter.style.display = \"\";\r\n\t\t    albumPageViewDiv.style.display = \"\";\r\n\t\t    albumPageControlDiv.style.display = \"\";\r\n\t\t},\r\n\t\tcloseAlbumPage: function() {\r\n\t\t\tif(this.album.openFrom == 'list'){\r\n\t\t\t\t//this.album.isShown = false;\r\n\t\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t\t\tmodal_close('albumDialog');\r\n\t\t\t\tthis.album.openFrom = 'album';\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tconst albumTitle = document.getElementById(\"albumTitle\");\r\n\t\t    const cameraViewDiv = document.getElementById(\"cameraViewDiv\");\r\n\t\t    const cameraControlDiv = document.getElementById(\"cameraControlDiv\");\r\n\t\t    const pageTitle = document.getElementById(\"pageTitle\");\r\n\t\t    const pageCounter = document.getElementById(\"pageCounter\");\r\n\t\t    const stageCounter = document.getElementById(\"stageCounter\");\r\n\t\t    const albumPageViewDiv = document.getElementById(\"albumPageViewDiv\");\r\n\t\t    const albumPageControlDiv = document.getElementById(\"albumPageControlDiv\");\r\n\t\t    pageTitle.style.display = \"none\";\r\n\t\t    pageCounter.style.display = \"none\";\r\n\t\t    albumPageViewDiv.style.display = \"none\";\r\n\t\t    albumPageControlDiv.style.display = \"none\";\r\n\t\t    albumTitle.style.display = \"\";\r\n\t\t    stageCounter.style.display = \"\";\r\n\t\t    cameraViewDiv.style.display = \"\";\r\n\t\t    cameraControlDiv.style.display = \"\";\r\n\t\t},\r\n\t\tnextAlbumPage: function() {\r\n\t\t    let nextStage = \"\";\r\n\t\t    for(var i = 0; i < this.album.stageList.length; i++) {\r\n\t\t        if(this.album.currentAlbumPageStage == this.album.stageList[i]) {\r\n\t\t            if(i == (this.album.stageList.length - 1)) {\r\n\t\t                nextStage = this.album.stageList[0];\r\n\t\t                this.album.currentAlbumPageIndex = 1;\r\n\t\t            }\r\n\t\t            else {\r\n\t\t                nextStage = this.album.stageList[(i + 1)];\r\n\t\t                this.album.currentAlbumPageIndex++;\r\n\t\t            }\r\n\t\t            break;\r\n\t\t        }\r\n\t\t    }\r\n\t\t    this.album.pageTitle = this.album.titleByColumnName[nextStage];\r\n\t\t    const currentPageImg = document.getElementById(\"img.page.\" + this.album.currentAlbumPageStage);\r\n\t\t    currentPageImg.style.display = \"none\";\r\n\t\t    const nextPageImg = document.getElementById(\"img.page.\" + nextStage);\r\n\t\t    nextPageImg.style.display = \"\";\r\n\t\t    this.album.currentAlbumPageStage = nextStage;\r\n\t\t},\r\n\t\tbeforeAlbumPage: function() {\r\n\t\t\tlet beforeStage = \"\";\r\n\t\t\tfor(var i = 0; i< this.album.stageList.length; i++){\r\n\t\t\t\tif(this.album.currentAlbumPageStage == this.album.stageList[i]) {\r\n\t\t\t\t\tif(i == 0) {\r\n\t\t\t\t\t\tbeforeStage = this.album.stageList[this.album.stageList.length-1];\r\n\t\t\t\t\t\tthis.album.currentAlbumPageIndex = this.album.stageList.length;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse {\r\n\t\t\t\t\t\tbeforeStage = this.album.stageList[(i - 1)];\r\n\t\t\t\t\t\tthis.album.currentAlbumPageIndex--;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.album.pageTitle = this.album.titleByColumnName[beforeStage];\r\n\t\t\tconst currentPageImg = document.getElementById(\"img.page.\" + this.album.currentAlbumPageStage);\r\n\t\t\tcurrentPageImg.style.display = \"none\";\r\n\t\t\tconst beforePageImg =  document.getElementById(\"img.page.\" + beforeStage);\r\n\t\t\tbeforePageImg.style.display = \"\";\r\n\t\t\tthis.album.currentAlbumPageStage = beforeStage;\t\t\t\r\n\t\t},\r\n\t\tnextStage: function() {\r\n\t\t\tlet nextStage = \"\";\r\n\t\t\tfor(var i = 0; i < this.album.stageList.length; i++) {\r\n\t\t\t\tif(this.album.currentStage == this.album.stageList[i]) {\r\n\t\t\t\t\tif(i == (this.album.stageList.length - 1)) {\r\n\t\t\t\t\t\tnextStage = this.album.stageList[0];\r\n\t\t                this.album.currentAlbumStageIndex = 1;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse {\r\n\t\t\t\t\t\tnextStage = this.album.stageList[(i + 1)];\r\n\t\t                this.album.currentAlbumStageIndex++;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.album.title = this.album.titleByColumnName[nextStage];\r\n\t\t\tthis.album.currentStage = nextStage;\r\n\t\t},\r\n\t\tbeforeStage: function() {\r\n\t\t\tlet beforeStage = \"\";\r\n\t\t\tfor(var i = 0; i < this.album.stageList.length; i++) {\r\n\t\t\t\tif(this.album.currentStage == this.album.stageList[i]) {\r\n\t\t\t\t\tif(i == 0) {\r\n\t\t\t\t\t\tbeforeStage = this.album.stageList[this.album.stageList.length-1];\r\n\t\t                this.album.currentAlbumStageIndex = this.album.stageList.length;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse {\r\n\t\t\t\t\t\tbeforeStage = this.album.stageList[(i - 1)];\r\n\t\t                this.album.currentAlbumStageIndex--;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.album.title = this.album.titleByColumnName[beforeStage];\r\n\t\t\tthis.album.currentStage = beforeStage;\r\n\t\t},\r\n\t\t\r\n\t\tcloseAlbum: function() {\r\n\t\t    //this.album.isShown = false;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 1000;\r\n\t\t\tmodal_close('albumDialog');\r\n\t\t\tif(this.album.currentStream) {\r\n\t\t        this.album.currentStream.getTracks().forEach(track => track.stop());\r\n\t\t        this.album.currentStream = null;\r\n\t\t    }\r\n\t\t    const video = document.getElementById(\"camera-video\");\r\n\t\t    video.pause();\r\n\t\t    video.srcObject = null;\r\n\t\t},\r\n\t\ttriggerFlash: function() {\r\n\t\t    const flash = document.getElementById('flash');\r\n\t\t    flash.style.display = 'block';\r\n\t\t    flash.classList.remove('flash'); // trigger 재실행을 위해 class 제거 후 재적용\r\n\t\t    void flash.offsetWidth; // reflow 강제\r\n\t\t    flash.classList.add('flash');\r\n