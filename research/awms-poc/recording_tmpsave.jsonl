=\"ocr_reader\" title=\"계기\" @callback=\"receiveOcr\"></ocr-reader-warebiz>\r\n\t\t<virtual-keyboard ref=\"keyboard\" :initial-value.sync=\"currentInputValue\"></virtual-keyboard>\r\n    </div>\r\n    `,\r\n    mounted: function() {\r\n\t\tthis.setSealNoSetting();\r\n        this.init();\r\n        this.setCommonCode();\r\n    },\r\n\twatch:{\r\n\t\tcurrentInputValue: function(newValue) {\r\n\t\t    if (this.activeInput) {\r\n\t\t        this.detail[this.activeInput] = newValue;\r\n\t\t    }\r\n\t\t},\r\n\t},\r\n    methods: {\r\n\t\tsetSealNoSetting: function(){\r\n\t\t\tvar self = this;\r\n\t\t\tvar params = {};\r\n\r\n\t\t\tvar returnVal = mobMtr8000Api.getMainList(params);\t\t\r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tif(response.data){\r\n\t\t\t\t\tself.sealNoSettingList = response.data;\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n        init: function(){\r\n            var self = this;\r\n            this.detail.LAY_METR_DTLS_CL_CD = this.inssts;\r\n            this.detail.LAY_STS_CD = this.orgsts;\r\n\t\t\tthis.detail.DIST_LV_HV_CLCD = this.volttype;\t\r\n        },\r\n        setCommonCode: function(){\r\n            var self = this;\r\n            var params = {};\r\n            var returnVal = mobMtr6000Api.getCommonCode();\r\n\r\n            returnVal.then(function(response) {\r\n                self.codeList.setRawData(response.data);\r\n            });\r\n        },\r\n        callBackEvent: function(val){\r\n            this.$emit('callbackevt', val);\r\n        },\r\n        updateCombo: function(key){\r\n            var self = this;\r\n            self.detail[key] = '';\r\n        },\r\n        messagePopup: function(pId) {\r\n            var title = '확인';\r\n            var cont = '해당 작업을 수행하시겠습니까?';\r\n            switch(pId) {\r\n                case '25':\r\n                    title = '임시저장';\r\n                    cont = '변경 사항을 임시저장하시겠습니까?';\r\n                    break;\r\n                case '28':\r\n                    title = '저장';\r\n                    cont = '변경 사항을 저장하시겠습니까?';\r\n                    break;\r\n            }\r\n            this.messageModal.openModal('confirm', title, cont, 'small', pId);\r\n        },\r\n        messagePopupCallback: function(pGb, pId) {\r\n            if(pGb!='confirm') return;\r\n            this.validateRow(pId);\r\n        },\r\n        validateRow: function(pId){\r\n            var self = this;            \r\n            var validate = this.$validator.validateAll();\r\n            validate.then(function(response){\r\n                if(response){\r\n                    self.saveRow(pId);\r\n                }else {\r\n                    self.$validator.errors.items.forEach(function(error) {\r\n                        var fieldName = error.field; \r\n                        var inputElement = self.$refs[fieldName];\r\n                        if (inputElement) {\r\n                            inputElement.focus();\r\n                            return; \r\n                        }\r\n                    });\r\n                }\r\n            });\r\n        },\r\n        saveRow: function(pId){\r\n\t\t\tvar self = this;\r\n\t\t\tthis.detail.EX_WORK_STEP = _.cloneDeep(this.detail.WORK_STEP);\r\n\t\t\tthis.detail.WORK_STEP = pId;\r\n\t\t\tthis.detail.LAY_METR_CL_CD = this.laymetrcl;\r\n\t\t\tthis.detail.DIST_LV_HV_CLCD = this.volttype;\r\n\t\t\tvar params = this.detail;\r\n\t\t\tvar returnVal;\r\n\t\t\tif(!params.CONS_TGT_SEQNO){\r\n\t\t\t\treturnVal = mobMtr6000Api.addRow(params);\r\n\t\t\t\treturnVal.then(function(response){\r\n\t\t\t\t\tif(response.data > 0){\r\n\t\t\t\t\t\tself.detail.CONS_TGT_SEQNO = response.data;\r\n\t\t\t\t\t\tself.detail.WORK_STEP = '20';\r\n\t\t\t\t\t\tself.saveRow(pId);\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tnotifySubmit('error', '저장', '저장이 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}else{\r\n\t\t\t\treturnVal = mobMtr6000Api.saveRow(params);\r\n\t\t\t\treturnVal.then(function(response){\r\n\t\t\t\t\tif(response.data > 0){\r\n\t\t\t\t\t\tnotifySubmit('success', '저장', '저장이 완료되었습니다', 'icon-success');\r\n\t\t\t\t\t\tself.callBackEvent('C');\t\t\t\t\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse{\r\n\t\t\t\t\t\tnotifySubmit('error', '저장', '저장이 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n        },\r\n\t\treadBarcode: function(gubun){ \r\n\t\t    this.vFlmnCl = gubun;\r\n\t\t    this.$refs.barcodeReader.openBarcodeScanner(\"1d\");\r\n\t\t},\r\n\t\treceiveBarcode: function(){\r\n\t\t    var vBarcdQr = this.$refs.barcodeReader.readValue;\r\n\t\t\tthis.detail[this.vFlmnCl] = vBarcdQr;\r\n\t\t},\r\n\t\topenOcrPopup: function(gubun){\r\n\t\t\tthis.vFlmnCl = gubun;\r\n\t\t\tthis.$refs.ocrReaderWarebiz.openOCRScanner();\r\n\t\t},\r\n\t\treceiveOcr: function(){\r\n\t\t\tvar vOcrVal = this.$refs.ocrReaderWarebiz.meterNumber;\r\n\t\t\tthis.detail[this.vFlmnCl] = vOcrVal;\r\n\t\t},\r\n\t\tmodalOpen: function(gubun){\r\n\t\t    this.vFlmnCl = gubun;\r\n\t\t\tmodal_open('flmnMode');\r\n\t\t},\r\n\t\t//촬영\r\n\t\tfnFlmn: function(tool){\r\n\t\t\tif(tool == 'O'){\r\n\t\t\t\tthis.$refs.ocrReaderWarebiz.openOCRScanner();\r\n\t\t\t}else if(tool == \"Q\") {\r\n\t\t\t    this.$refs.barcodeReader.openBarcodeScanner(\"2d\");                      \r\n\t\t\t}else {\r\n\t\t\t\tthis.$refs.barcodeReader.openBarcodeScanner(\"1d\");\t\t\t\t\t\t\r\n\t\t\t}\r\n\t\t\tmodal_close('flmnMode');\r\n\t\t},\r\n\t\topenKeyboard: function(inputKey, maxLength, keyType) {\r\n\t\t    this.activeInput = inputKey;\r\n\t\t    this.currentInputValue = this.detail[inputKey];\r\n\t\t    this.$refs.keyboard.openKeyboard(maxLength, keyType);\r\n\t\t},\r\n\t\tonSealQuantityChange: function(val, settingKey, noKey1, noKey2 = null) {\r\n\t\t\tthis.detail[noKey1] = ''\r\n\t\t\tthis.detail[noKey2] = ''\r\n\t\t\tswitch(settingKey){\r\n\t\t\t\tcase '9': settingKey = 'ENCL_SEAL_VAL'; break;\r\n\t\t\t\tcase 'A': settingKey = 'METR_SEAL_VAL'; break;\r\n\t\t\t\tcase 'D': settingKey = 'OTSD_SEAL_VAL'; break;\r\n\t\t\t\tcase 'E': settingKey = 'ETC_SEAL_VAL'; break;\r\n\t\t\t\tdefault: settingKey = ''; break;\t\t\t\t\r\n\t\t\t}\r\n\t\t\tif(!settingKey){\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t    const setting = this.sealNoSettingList[settingKey];\r\n\r\n\t\t    if ((val == 1 || val == 2) && setting) {\r\n\t\t        const base = parseInt(setting, 10);\r\n\t\t\t\tif (isNaN(base)) return;\r\n\t\t        this.detail[noKey1] = String(base + 1);\r\n\t\t\t\tthis.sealNoSettingList[settingKey] = String(base + 1);\r\n\t\t        if (val == 2 && noKey2) {\r\n\t\t            this.detail[noKey2] = String(base + 2);\r\n\t\t\t\t\tthis.sealNoSettingList[settingKey] = String(base + 2);\r\n\t\t        }\r\n\t\t    }\r\n\t\t},\r\n    }\r\n });","dur":34,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01030000"}
{"kind":"xhr","ts":1780490586588,"url":"https://awms.kdn.com/service/ami/html/sub/mob/mtr/MOBMTR4001.js","method":"GET","reqBody":"","status":200,"resBody":" /********************************************************************************************\r\n * @Writer\r\n *  김동진 2025.04.02\r\n *\r\n * @Description\r\n * \t변류기(CT)\r\n *\r\n * @Syntax\r\n * \t<mobmtr4001></mobmtr4001>\r\n *\r\n * @Parameters\r\n *  detail : 상세정보\r\n *  codeList : 공통코드\r\n ********************************************************************************************/\r\nVue.component('mobmtr4001', { \r\n\tprops:['detail', 'codeList', 'status', 'insunit'],\r\n\tdata: function() {\r\n\t\treturn {\r\n\t\t\tactiveTab: 1,\r\n\t\t\tmessageModal: new ModalSet('modal-message'),\r\n\t\t\tvFlmnCl: '',\r\n\t\t\tcachedDetail: null,\r\n        };\r\n    },\r\n    template: `\r\n\t<div class=\"grow d-flex\">\r\n\t    <button style=\"height: 54px !important;\" type=\"button\" :style=\"{ background: detail[status+'CT_YN'] === 'Y' ? '#427FDF' : '', color: detail[status+'CT_YN'] === 'Y' ? '#FFF' : '' }\" class=\"btn type01 size-m c-bluegray grow b-flex\" @click=\"openCtModal\">변류기<br>(CT)</button>\r\n\t    <transition name=\"fade\">\r\n\t        <div class=\"modal-layer-wrap\">\r\n\t            <div id=\"modal_ct\" class=\"modal-layer type02\">\r\n\t                <div class=\"modal-container\">\r\n\t                    <div class=\"modal-header\">\r\n\t                        <p class=\"modal-title\">변류기</p>\r\n\t                    </div>\r\n\t                    <div class=\"modal-content\">\r\n\t\t\t\t\t\t\t<!--\r\n\t                        <table class=\"table-type35\" v-if=\"insunit != '40'\">\r\n\t                            <caption>고객정보를 항목별 순서대로 안내하는 표입니다</caption>\r\n\t                            <colgroup>\r\n\t                                <col width=\"20%\">\r\n\t                                <col width=\"30%\">\r\n\t                                <col width=\"20%\">\r\n\t                