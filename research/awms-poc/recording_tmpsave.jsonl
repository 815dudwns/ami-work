\n\t\t\t\tappOpen(\"MOBMTR\",\"01020000\",param,true);\r\n\t\t\t}else{\r\n\t\t\t\t//계기\r\n\t\t\t\tappOpen(\"MOBMTR\",\"01040000\",param,true);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n/*******************************************************************************************************************************************************************\r\n * vue end\r\n ********************************************************************************************************************************************************************/\r\n </script>","dur":41,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01010000"}
{"kind":"xhr","ts":1780489019451,"url":"https://awms.kdn.com/commons/log/menu?APP_ID=MOBMTR&MENU_CD=01010000&MENU_NM=%EA%B3%84%EA%B8%B0%EA%B4%80%EB%A6%AC+%EC%9E%91%EC%97%85%EC%84%A0%ED%83%9D&PGM_ID=mob%2Fmtr%2FMOBMTR7000&UP_MENU_CD=01000000&MENU_LV=1&SERVICE_CD=AMI&GAEINJEONGBO_USE_YN=N&GAEINJEONGBO_ITEM=&SUB_PGM_GAEINJEONGBO_USE_CNT=0","method":"GET","reqBody":"","status":200,"resBody":"","dur":33,"page":"https://awms.kdn.com/html/main/index.html?app=MOBMTR&menu=01010000"}
