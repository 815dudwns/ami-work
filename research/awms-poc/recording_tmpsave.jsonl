os.post('/ami/mob/cst/mobCst1000/revokeSelections', params);\r\n}\r\nMobCst1000Api.prototype.deleteRows = function(params, loading){\r\n\treturn axios.post('/ami/mob/cst/mobCst1000/deleteRows', params);\r\n}\r\nMobCst1000Api.prototype.checkDuplication = function(params, loading){\r\n\treturn axios.post('/ami/mob/cst/mobCst1000/checkDuplication', params);\r\n}\r\nMobCst1000Api.prototype.checkMeterDuplication = function(params, loading){\r\n\treturn axios.get('/ami/mob/cst/mobCst1000/checkMeterDuplication', { params: params, loading: false });\r\n}\r\nMobCst1000Api.prototype.getBusiMacConnection = function(params, loading){\r\n\treturn axios.get('/ami/mob/cst/mobCst1000/getBusiMacConnection', { params: params, loading: false });\r\n}\r\nMobCst1000Api.prototype.getBusiMacBoxConnection = function(params, loading){\r\n\treturn axios.get('/ami/mob/cst/mobCst1000/getBusiMacBoxConnection', { params: params, loading: false });\r\n}\r\n\r\n","dur":27,"page":"https://awms.kdn.com/html/main/index.html?app=MOBCST&menu=01010000"}
