{"kind":"xhr","ts":1780489415249,"url":"https://awms.kdn.com/service/ami/html/sub/mob/mtr/MOBMTR6000.js","method":"GET","reqBody":"","status":200,"resBody":" /********************************************************************************************\r\n * @Writer\r\n *  김동진 2025.04.07\r\n *\r\n * @Description\r\n *  재봉인(저압, 고압) 템플릿\r\n *\r\n * @Syntax\r\n *  <mobmtr6000></mobmtr6000>\r\n *\r\n * @Parameters\r\n *  orgsts : 원본 상태값\r\n *  inssts : 진행 상태값 \r\n *  insunit : 실효, 신증설, 계기일반, 계기추가 구분값\r\n *  volttype : 저압, 고압 구분값\r\n *  detail : 상세정보\r\n ********************************************************************************************/\r\nVue.component('mobmtr6000', {\r\n    props: ['orgsts', 'inssts', 'insunit', 'volttype', 'detail', 'laymetrcl'],    \r\n    data: function() {\r\n        return {\r\n            activeTab: 1,\r\n            codeList: new Dataset(),\r\n            messageModal: new ModalSet('modal-message'),\r\n\t\t\tvFlmnCl: '',\r\n\t\t\t\r\n\t\t\tcurrentInputValue: '',\r\n\t\t\tactiveInput: null,\r\n\t\t\t\r\n\t\t\tsealNoSettingList: {\r\n\t\t\t\tENCL_SEAL_VAL: '',\r\n\t\t\t\tMETR_SEAL_VAL: '',\r\n\t\t\t\tOTSD_SEAL_VAL: '',\r\n\t\t\t\tETC_SEAL_VAL: '',\r\n\t\t\t},\r\n        };\r\n    },\r\n    template: `\r\n    <div>\r\n        <template v-if=\"volttype == '1'\">\r\n\t\t\t<!--\r\n            <table class=\"table-type35\" v-if=\"insunit != '40'\">\r\n                <caption>고객정보를 항목별 순서대로 안내하는 표입니다</caption>\r\n                <colgroup>\r\n                    <col width=\"20%\">\r\n                    <col width=\"30%\">\r\n                    <col width=\"20%\">\r\n                    <col width=\"30%\">\r\n                </colgroup>\r\n                <tbody>\r\n                    <tr>\r\n                        <th scope=\"row\">고객번호</th>\r\n                        <td colspan=\"3\">\r\n                            {{ detail.CNTR_NO }}\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n         