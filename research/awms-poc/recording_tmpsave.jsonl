\n\t\t\t\t// VOLT=2 ELSE\r\n\t\t\t\t{ condition: ({VOLT_CD}) => VOLT_CD==2, fields: this.fieldGroups[\"G08\"+VOLT_CD], pType: \"P14\"},\r\n\t\t\t];\r\n\t\t    // 모든 필드 초기화\r\n\t\t    Object.keys(this.disabledFields).forEach(key => {\r\n\t\t\t\t//if(!key.includes(\"DGTS\")){\r\n\t\t        \tthis.disabledFields[key] = true;\r\n\t\t        \tif(clear) this.detail[key] = '';\r\n\t\t\t\t//}\r\n\t\t    });\r\n\r\n\t\t    let enableFields = [];\r\n\t\t    \r\n\t\t\t// 매칭되는 룰 찾기\r\n\t\t\tfor (let rule of rules) {\r\n\t\t\t    if (rule.condition({VOLT_CD, CNTR_PWR, CNTR_CLAS_CD, SD_ETC_BIZ_CD, PACH_CLCD, WHM_NO})) {\r\n\t\t\t        //발전기구분 값 존재시 송전지침 활성화\r\n\t\t\t        if(CUST_GEN_INST_CLCD != '' && !(\"etc\" in rule)){\r\n\t\t\t               if(!rule.fields.includes(\"CGD_GENT_WHM_NDL_DAY_QTT\"))rule.fields.push(\"CGD_GENT_WHM_NDL_DAY_QTT\");\r\n\t\t\t               if(!rule.fields.includes(\"CGD_DEMOLITION_READ_STATE_GENERATION\"))rule.fields.push(\"CGD_DEMOLITION_READ_STATE_GENERATION\");\r\n\t\t\t               if(!rule.fields.includes(\"CGD_DEMOLITION_READ_REASON_GENERATION\"))rule.fields.push(\"CGD_DEMOLITION_READ_REASON_GENERATION\");\r\n\t\t\t        }\r\n\t\t\t        //저압, 특례적용 값이 78인 경우 ESS 추가\r\n\t\t\t        if((VOLT_CD == '1' && SD_ETC_BIZ_CD == '78') && !(\"etc\" in rule)){\r\n\t\t\t               if(!rule.fields.includes(\"CGD_ESS_WHME_NDL_DAY_QTT\"))rule.fields.push(\"CGD_ESS_WHME_NDL_DAY_QTT\");\r\n\t\t\t        }\r\n\t\t\t        //계기추가시\r\n\t\t\t        if(this.detail.WHM_SEQNO == '9999'){\r\n\t\t\t\t\t\t/*\r\n\t\t\t               if(!rule.fields.includes(\"CGD_GENT_WHM_NDL_DAY_QTT\"))rule.fields.push(\"CGD_GENT_WHM_NDL_DAY_QTT\");\r\n\t\t\t               if(!rule.fields.includes(\"CGD_DEMOLITION_READ_STATE_GENERATION\"))rule.fields.push(\"CGD_DEMOLITION_READ_STATE_GENERATION\");\r\n\t\t\t               if(!rule.fields.includes(\"CGD_DEMOLITION_READ_REASON_GENERATION\"))rule.fields.push(\"CGD_DEMOLITION_READ_REASON_GENERATION\");\r\n\t\t\t               if(!rule.fields.includes(\"CGD_ESS_WHME_NDL_DAY_QTT\"))rule.fields.push(\"CGD_ESS_WHME_NDL_DAY_QTT\");\r\n\t\t\t            */\r\n\t\t\t        }\r\n\t\t\t        enableFields = rule.fields;\r\n\t\t\t        \r\n\t\t\t        //placeholder 초기화\r\n\t\t\t        this.placeholderClear();\r\n\t\t\t        \r\n\t\t\t        //계기의 3,4번째 자리로 판단\r\n\t\t\t        /*\r\n\t\t\t        var meterData = this.detail.WHM_NO.slice(2,4);\r\n\t\t\t        if(rule.pType == 'P01'){\r\n\t\t\t\t\t\tif(['14','15','34','01','03'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder = '5';\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder = '4';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(rule.pType == 'P02'){\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}else if(rule.pType == 'P03'){\r\n\t\t\t\t\t\tif(['14','15','34','01','03'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '5';\r\n\t\t\t\t\t\t}else if(['17','18','25','26','27','37','38','45','46','47','51','52','53','54','55','56','57','58'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '4';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(rule.pType == 'P04'){\r\n\t\t\t\t\t}else if(rule.pType == 'P05'){\r\n\t\t\t\t\t\tif(['25','26','27','37','38','45','46','47','19'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '4';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_MNGT_QTT.placeholder \t= '5';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_DAY_QTT.placeholder \t= '7';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_DAY_QTT.placeholder \t\t= '6';\r\n\t\t\t\t\t\t}else if(['14','15','34','01','03'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '6';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_MNGT_QTT.placeholder \t= '7';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_DAY_QTT.placeholder \t= '9';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_DAY_QTT.placeholder \t\t= '8';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(rule.pType == 'P06'){\r\n\t\t\t\t\t}else if(rule.pType == 'P07'){\r\n\t\t\t\t\t}else if(rule.pType == 'P08'){\r\n\t\t\t\t\t}else if(rule.pType == 'P09'){\r\n\t\t\t\t\t\tif(['25','26','27','37','38','45','46','47','19'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '4';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_EVEN_QTT.placeholder\t= '5';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_MNGT_QTT.placeholder \t= '6';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_DAY_QTT.placeholder \t= '10';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_EVEN_QTT.placeholder\t= '11';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_DAY_QTT.placeholder \t\t= '7';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_EVEN_QTT.placeholder \t= '8';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(rule.pType == 'P10'){\r\n\t\t\t\t\t\tif(['25','26','27','37','38','45','46','47','19'].includes(meterData)){\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_DAY_QTT.placeholder \t= '4';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_EVEN_QTT.placeholder\t= '5';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_WHME_NDL_MNGT_QTT.placeholder \t= '6';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_DAY_QTT.placeholder \t= '10';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_DM_MT_NDL_EVEN_QTT.placeholder\t= '11';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_DAY_QTT.placeholder \t\t= '7';\r\n\t\t\t\t\t\t\tthis.$refs.CGD_VAR_NDL_EVEN_QTT.placeholder \t= '8';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(rule.pType == 'P11'){\r\n\t\t\t\t\t}else if(rule.pType == 'P12'){\r\n\t\t\t\t\t}\r\n\t\t\t\t\t*/\r\n\t\t\t        break;\r\n\t\t\t    }\r\n\t\t\t}\r\n\r\n\t\t    // 앨범 관련 세팅\r\n\t\t    this.album.stageList = [];\r\n\t\t    this.album.totalAlbumStageCount = 0;\r\n\t\t    this.album.currentAlbumStageIndex = 1;\r\n\t\t    this.album.totalAlbumPageCount = 0;\r\n\t\t    this.album.currentAlbumPageIndex = 1;\r\n\r\n\t\t    // 필드 활성화\r\n\t\t    enableFields.forEach(field => {\r\n\t\t        this.disabledFields[field] = false;\r\n\t\t        if(field.endsWith('QTT') && !field.includes(\"GENERATION\")){\r\n\t\t\t\t\tthis.detail[field] = this.detail[field] == ''?\"0\":this.detail[field];\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t        /*\r\n\t\t        if(field.endsWith('QTT') && !field.includes(\"GENERATION\")){\r\n\t\t\t\t\tthis.detail[field] = this.detail[field] == ''?\"0\":this.detail[field];\r\n\t\t            const fieldMap = {\r\n\t\t                \"CGD_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_3\",\r\n\t\t                \"CGD_WHME_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_4\",\r\n\t\t                \"CGD_WHME_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_5\",\r\n\t\t                \"CGD_DM_MT_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_6\",\r\n\t\t                \"CGD_DM_MT_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_7\",\r\n\t\t                \"CGD_DM_MT_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_8\",\r\n\t\t                \"CGD_VAR_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_9\",\r\n\t\t                \"CGD_VAR_NDL_EVEN_QTT\": \"CREMO_ATCH_FILE_ID_10\",\r\n\t\t                \"CGD_VAR_NDL_MNGT_QTT\": \"CREMO_ATCH_FILE_ID_11\",\r\n\t\t                \"CGD_GENT_WHM_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_12\",\r\n\t\t                \"CGD_ESS_WHME_NDL_DAY_QTT\": \"CREMO_ATCH_FILE_ID_13\"\r\n\t\t            };\r\n\t\t            const mappedField = fieldMap[field] || field;\r\n\r\n\t\t            this.album.stageList.push(mappedField);\r\n\t\t            this.album.totalAlbumStageCount++;\r\n\t\t            this.album.totalAlbumPageCount++;\r\n\t\t        }\r\n\t\t        */\r\n\t\t    });\r\n\t\t    \r\n\t\t    const stf = this.stageByField1;\r\n\t\t\tfor(const key in stf){\r\n\t\t\t\tthis.album.stageList.push(key);\r\n\t\t\t\tthis.album.totalAlbumStageCount++;\r\n\t\t\t\tthis.album.totalAlbumPageCount++;\r\n\t\t\t}\r\n\t\t    \r\n\t\t\tif(clear){\r\n\t\t\t\tthis.updateDgts();\r\n\t\t\t}\r\n\t\t},\r\n\t\tselectPhotos: async function(){\r\n\t\t\tconst keys = [\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_3',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_4',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_5',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_6',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_7',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_8',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_9',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_10',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_11',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_12',\r\n\t\t\t\t'CREMO_ATCH_FILE_ID_13',\r\n\t\t\t];\r\n\t\t\tvar params = {};\r\n\r\n\t\t\tkeys.forEach(key => {\r\n\t\t\t    const value = this.detail[key];\r\n\t\t\t    if (value !== null && value !== undefined && value !== '') {\r\n\t\t\t    \tparams[key] = value;\r\n\t\t\t    }\r\n\t\t\t});\r\n\r\n\t\t\tif (Object.keys(params).length === 0) {\r\n\t\t\t    return;\r\n\t\t\t}\r\n\r\n\t\t\tvar returnVal = mobMtr4000Api.selectPhotos(params);\r\n\t\t\treturnVal.then(async (response) => {\r\n\t\t\t    if (response.data.length > 0) {\r\n\r\n\t\t\t        for (const item of response.data) {\r\n\r\n\t\t\t            const blob = await (await fetch(item.imageSrc)).blob();\r\n\t\t\t            const blobUrl = URL.createObjectURL(blob);\r\n\t\t\t            this.album.imgBlobByColumnName[item.ATCH_COL] = blob;\r\n\t\t\t            this.album.imgUrlByColumnName[item.ATCH_COL] = blobUrl;\r\n\t\t\t            const albumImg = document.getElementById(\"img.\" + item.ATCH_COL);\r\n\t\t\t            const pageImg = document.getElementById(\"img.page.\" + item.ATCH_COL);\r\n\r\n\t\t\t            if (albumImg) albumImg.src = blobUrl;\r\n\t\t\t            if (pageImg) pageImg.src = blobUrl;\r\n\t\t\t        }\r\n\t\t\t    }\r\n\t\t\t});\r\n\t\t},\r\n\t\tshowAlbum: function() {\r\n\t\t    this.album.currentStage = this.album.stageList[0];\r\n\t\t    this.album.currentAlbumStageIndex = 1;\r\n\t\t    this.album.title = this.album.titleByColumnName[this.album.currentStage];\r\n\t\t    //this.album.isShown = true;\r\n\t\t\tdocument.getElementById(\"header\").style.zIndex = 0;\r\n\t\t\tmodal_open('albumDialog');\r\n\t\t    const video = document.getElementById(\"camera-video\");\r\n\t\t    let vT = null;\r\n\t\t    \r\n\t\t    // 후면 카메라 선택 (환경 모드 우선)\r\n\t\t    const videoConstraints = { facingMode: \"environment\" };\r\n\t\t    navigator.mediaDevices.getUserMedia({ video: videoConstraints })\r\n\t\t    .then((stream) => {\r\n\t\t        this.album.currentStream = stream;\r\n\t\t        video.srcObject = stream;\r\n\t\t        video.onloadedmetadata = () => {\r\n\t\t            video.play();\r\n\t\t        };\r\n\t\t        \r\n\t\t        //줌IN,OUT을 위한 값\r\n\t\t        vT = stream.getVideoTracks()[0];\r\n\t\t        this.album.videoTrack = vT; \r\n\t\t        \r\n\t\t        const capabilities = vT.getCapabilities();\r\n\t\t        \r\n\t\t       if(capabilities.zoom){\r\n\t\t\t\t\tthis.album.zoomRange.min = capabilities.zoom.min;\r\n\t\t\t\t\tthis.album.zoomRange.max = capabilities.zoom.max;\r\n\t\t\t\t\tthis.album.currentZoom = capabilities.zoom.min;\r\n\t\t\t\t}\r\n\t\t    })\r\n\t\t    .catch((error) => {\r\n\t\t        console.error(\"카메라 접근 오류:\", error);\r\n\t\t        output.textContent = \"❌ 카메라 접근 실패!\";\r\n\t\t    });\r\n\t\t    this.closeAlbumPage();\r\n\t\t},\r\n\t\ttakePicture: async function() {\r\n\t\t\tconst video = document.getElementById(\"camera-video\");\r\n\t\t\tconst canvas = document.getElementById(\"canvas-video\");\r\n\t\t\tconst context = canvas.getContext(\"2d\");\r\n\t\t\t\r\n\t\t\t// ===== 설정값 =====\r\n\t\t\tconst SIZE_LIMIT = 500 * 1024; // 500KB\r\n\t\t\tconst MAX_WIDTH = 1280;\r\n\t\t\tconst MAX_HEIGHT = 1280;\r\n\t\t\tconst QUALITY = 0.8; // 0~1\r\n\t\t\tconst MIME_TYPE = \"image/jpeg\";\r\n\r\n\t\t\tcanvas.width = video.videoWidth;\r\n\t\t\tcanvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0);\r\n\r\n\t\t\tconst originalBlob = await new Promise(resolve =>\r\n\t\t\t\tcanvas.toBlob(resolve, MIME_TYPE, 1.0)\r\n\t\t\t);\r\n\r\n\t\t\tlet finalBlob = originalBlob;\r\n\r\n\t\t\tif (originalBlob.size > SIZE_LIMIT) {\r\n\t\t\t\tconst img = new Image();\r\n\t\t\t\timg.src = URL.createObjectURL(originalBlob);\r\n\r\n\t\t\t\tawait new Promise(res => (img.onload = res));\r\n\r\n\t\t\t\tlet { width, height } = img;\r\n\t\t\t\tconst ratio = Math.min(\r\n\t\t\t\t\tMAX_WIDTH / width,\r\n\t\t\t\t\tMAX_HEIGHT / height,\r\n\t\t\t\t\t1\r\n\t\t\t\t);\r\n\r\n\t\t\t\tconst resizeCanvas = document.createElement(\"canvas\");\r\n\t\t\t\tresizeCanvas.width = Math.round(width * ratio);\r\n\t\t\t\tresizeCanvas.height = Math.round(height * ratio);\r\n\r\n\t\t\t\tconst rctx = resizeCanvas.getContext(\"2d\");\r\n\t\t\t\trctx.drawImage(img, 0, 0, resizeCanvas.width, resizeCanvas.height);\r\n\r\n\t\t\t\tfinalBlob = await new Promise(resolve =>\r\n\t\t\t\t\tresizeCanvas.toBlob(resolve, MIME_TYPE, QUALITY)\r\n\t\t\t\t);\r\n\t\t\t}\r\n\t\t\tconst blobUrl = URL.createObjectURL(finalBlob);\r\n\t\t\t\r\n\t\t\t/*\r\n\t\t    canvas.width = video.videoWidth;\r\n\t\t    canvas.height = video.videoHeight;\r\n\t\t\tcontext.drawImage(video, 0, 0, canvas.width, canvas.height);\r\n\t\t\tconst blob = await new Promise(resolve => canvas.toBlob(resolve, \"image/png\"));\r\n\t\t\tconst blobUrl = URL.createObjectURL(blob);\r\n\t\t\t*/\r\n\t\t\tthis.album.imgBlobByColumnName[this.album.currentStage] = finalBlob;\r\n\t\t\tthis.album.imgUrlByColumnName[this.album.currentStage] = blobUrl;\r\n\t\t\tconst img = document.getElementById(\"img.\" + this.album.currentStage);\r\n\t\t\timg.src = blobUrl;\r\n\t\t\tthis.detail[this.album.currentStage + \"_SRC\"] = blobUrl;\r\n\t\t\t\r\n\t\t\t\r\n\t\t    this.triggerFlash();\r\n\t\t    video.style.display = \"none\";\r\n\t\t    img.style.display = \"\";\r\n\t\t    setTimeout(() => {\r\n\t\t    \timg.style.display = \"none\";\r\n\t\t    \tvideo.style.display = \"\";\r\n\t\t\t\tif(this.album.currentAlbumStageIndex == this.album.stageList.length)\r\n\t\t\t\t\tthis.closeAlbum();\r\n\t\t\t\telse{\r\n\t\t\t\t\tthis.nextStage();\r\n\t\t\t\t}\r\n\t\t    }, 1000);\r\n\t\t\t\r\n\t\t\tconst fieldMap = {\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_3\" : \"WHME_DAY\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_4\" : \"WHME_EVEN\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_5\" : \"WHME_MNGT\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_6\" : \"DM_DAY\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_7\" : \"DM_EVEN\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_8\" : \"DM_MNGT\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_9\" : \"VAR_DAY\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_10\" : \"VAR_EVEN\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_11\" : \"VAR_MNGT\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_12\" : \"GENT_DAY\",\r\n\t\t\t\t\"CREMO_ATCH_FILE_ID_13\" : \"ESS_DAY\"\r\n\t\t\t};\r\n\t\t\t\r\n\t\t\tconst link = document.createElement('a');\r\n\t\t\tlink.href = blobUrl;\r\n\t\t\tlink.download = this.detail.CREMO_WHM_NO + \"_\" + moment().format(\"YYYYMMDDHHmm\") + \"_\" + fieldMap[this.album.currentStage]+ '.png'; \r\n\t\t\tdocument.body.appendChild(link);\r\n\t\t\tlink.click();\r\n\t\t\tdocument.body.removeChild(link);\r\n\t\t\t/*\r\n\t\t\tconst link = document.createElement('a');\r\n\t\t\tlink.href = imageBase64String;\r\n\t\t\tlink.download = this.detail.WHM_NO + \"_\" + moment().format(\"YYYYMMDDHHmm\") + \"_\" + fieldMap[this.album.currentStage]+ '.png'; \r\n\t\t\tdocument.body.appendChild(link);\r\n\t\t\tlink.click();\r\n\t\t\tdocument.body.removeChild(link);\r\n\t\t\t*/\r\n\t\t},\r\n\t\tselectPicture: function() {\r\n\t\t\tconst input = document.createElement(\"input\");\r\n\t\t\tinput.type = \"file\";\r\n\t\t\tinput.accept = \"image/*\";\r\n\t\t\tinput.multiple = true;\r\n\t\t\tinput.removeAttribute(\"capture\");\r\n\t\t\r\n\t\t\tconst MAX_SIZE = 500 * 1024; // 500KB\r\n\t\t\tconst MAX_WIDTH = 1024;\r\n\t\t\tconst MAX_HEIGHT = 1024;\r\n\t\t\tconst QUALITY = 0.8;\r\n\t\t\t\r\n\t\t\tinput.onchange = (event) => {\r\n\t\t\t\tconst selFiles = Array.from(event.target.files);\r\n\t\t\t\t\r\n\t\t\t\tconst stf = this.stageByField1;\r\n\t\t\t\tvar fileList = [];\r\n\t\t\t\tfor(const key in stf){\r\n\t\t\t\t\t//if(!this.$refs[stf[key]]?.disabled){\r\n\t\t\t\t\t\tfileList.push(key);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\