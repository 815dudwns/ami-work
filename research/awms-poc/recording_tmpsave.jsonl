{"kind":"xhr","ts":1780465458256,"url":"https://awms.kdn.com/app-assets/js/api/ami/mob/cst/MOBCST5000.api.js","method":"GET","reqBody":"","status":200,"resBody":"function MobCst5000Api(){}\r\nvar mobCst5000Api = new MobCst5000Api();\r\n\r\n/********************************************************************************************\r\n * 작업자1~3 옵션리스트 조회\r\n * @param: \r\n * @return: 작업자1~3 옵션 리스트\r\n ********************************************************************************************/\r\nMobCst5000Api.prototype.getWorkerUserList = function(params, loading){\r\n\treturn axios.get('/ami/mob/cst/mobCst5000/selectWorkerUserList'\t, {\r\n\t\tparams: params,\r\n\t\tloading: false\r\n\t});\r\n}\r\n/********************************************************************************************\r\n * 조회 \r\n * @param: \r\n * @return: 작업자1, 작업자2, 작업자3\r\n ********************************************************************************************/\r\nMobCst5000Api.prototype.getWorkerList = function(params, loading){\r\n\treturn axios.get('/ami/mob/cst/mobCst5000/selectWorkerList'\t, {\r\n\t\tparams: params,\r\n\t\tloading: false\r\n\t});\r\n}\r\n/********************************************************************************************\r\n * 등록 및 수정\r\n * @param: worker1,worker2,worker3,enclSealVal,metrSealVal,otsdSealVal\r\n * @return: count\r\n ********************************************************************************************/\r\nMobCst5000Api.prototype.addWorker = function(params, loading){\r\n\treturn axios.post('/ami/mob/cst/mobCst5000/saveWorker', params);\r\n}","dur":27,"page":"https://awms.kdn.com/html/main/index.html?app=MOBCST&menu=01010000"}
{"kind":"xhr","ts":1780465458285,"url":"https://awms.kdn.com/service/ami/html/sub/mob/cst/MOBCST3000.js","method":"GET","reqBody":"","status":200,"resBody":" /********************************************************************************************\r\n * @Writer\r\n *  김동진 2025.06.10\r\n *\r\n * @Description\r\n *  대상리스트 \r\n *\r\n * @Syntax\r\n *  <mobcst3000 ref=\"mobcst3000\" insunit=\"10/20\" @callbackevt=\"콜백이벤트함수\"></mobcst3000>\r\n *\r\n * @Parameters\r\n *  insunit : 메뉴 구분 (10-시공관리, 20-설치불가)\r\n * \r\n * @return\r\n *  BUSI_NUM\t: 공사명\r\n *  DEPT1\t\t: 지역본부\r\n *  DEPT2\t\t: 지사\r\n *  METER_ID\t: 계기번호\r\n *  METER_TYPE\t: 계기타입\r\n *  DATA_NUM\t: 전산화번호\r\n *  CUST_NO     : 고객번호\r\n ********************************************************************************************/\r\nVue.component('mobcst3000', {\r\n    props: ['insunit'],    \r\n    data: function() {\r\n        return {\t\t\t\r\n\t\t\ttarget: '10',\r\n\t\t\tmainList: new Dataset(),\r\n\t\t\tcodeList: new Dataset(),\r\n\t\t\tconsList: new Dataset(),\r\n\t\t\tmessageModal: new ModalSet('modal-message'),\r\n\t\t\t\r\n\t\t\tselect01: '',\r\n\t\t\tsortKey: '',\r\n\t\t\tsearchKeyword: '',\r\n\t\t\t\r\n\t\t\tcheckedItems: [],\r\n\t\t\tlocationsList: [],\r\n\t\t\tworkStepFilter: ['01', '02', '03'],\r\n\t\t\tselectAll: false,\r\n\t\t\tcommCdMapping: {\r\n\t\t\t\t'01': '10',\r\n\t\t\t\t'02': '20',\r\n\t\t\t\t'03': '30',\r\n\t\t\t\t'04': '50',\r\n\t\t\t\t'05': '40',\r\n\t\t\t\t'06': '70',\r\n\t\t\t\t'07': '60',\r\n\t\t\t\t'10': '80',\r\n\t\t\t\t'11': '90',\r\n\t\t\t\t'12': '85',\r\n\t\t\t\t'-': '',\r\n\t\t\t\t'21': '91',\r\n\t\t\t\t'24': '92',\r\n\t\t\t},\r\n        };\r\n    },\r\n    template: `\r\n\t<div class=\"modal-layer-wrap\">\r\n\t    <div id=\"mobcst3000\" class=\"modal-layer modal-large\">\r\n\t        <div class=\"modal-container\">\r\n\t            <div class=\"modal-header\">\r\n\t                <p class=\"modal-title\">대상리스트</p>\r\n\t            </div>\r\n\t            <div class=\"content_wrap\">\r\n\t\t\t\t\t<div class=\"cont_box\">\r\n\t\t\t\t\t\t<section class=\"sub_cont_box\" v-if=\"!mainList.currentRow\">\r\n\t\t\t\t\t\t    <div class=\"row form-row flex\">\r\n\t\t\t\t\t\t        <div class=\"col s8\">\r\n\t\t\t\t\t\t            <div class=\"radio type03\">\r\n\t\t\t\t\t\t                <input v-model=\"target\" type=\"radio\" name=\"target\" id=\"target01\" value=\"10\">\r\n\t\t\t\t\t\t                <label for=\"target01\">신규공사</label>\r\n\t\t\t\t\t\t                <i class=\"radio-icon\"></i>\r\n\t\t\t\t\t\t            </div>\r\n\t\t\t\t\t\t            <div class=\"radio type03\">\r\n\t\t\t\t\t\t                <input v-model=\"target\" type=\"radio\" name=\"target\" id=\"target02\" value=\"20\">\r\n\t\t\t\t\t\t                <label for=\"target02\">보강공사</label>\r\n\t\t\t\t\t\t                <i class=\"radio-icon\"></i>\r\n\t\t\t\t\t\t            </div>\r\n\t\t\t\t\t\t        </div>\r\n\t\t\t\t\t\t        <div class=\"col s4 right\">\r\n\t\t\t\t\t\t            <kakao-map-popup ref=\"kakaoMap\" :coords=\"locationsList\" type=\"address\"></kakao-map-popup>\r\n\t\t\t\t\t\t        </div>\r\n\t\t\t\t\t\t    </div>\r\n\t\t\r\n\t\t\t\t\t\t    <section v-if=\"target == '10'\">\r\n\t\t\t\t\t\t        <div class=\"box-type11\">\r\n\t\t\t\t\t\t            <div class=\"row form-row\">\r\n\t\t\t\t\t\t                <div class=\"form-group col s12 l4\">\r\n\t\t\t\t\t\t                    <label class=\"full\">\r\n\t\t\t\t\t\t                        <select v-model=\"select01\" id=\"select01\" class=\"size-m\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<option v-if=\"consList.data.length == 0\" value=\"\">할당받은 사업이 없습니다</option>\r\n\t\t\t\t\t\t                            <option v-if=\"consList.data.length > 0\" v-for=\"item in consList.data\" :value=\"item.CONS_NO\">{{ item.CONS_NM }}</option>\r\n\t\t\t\t\t\t                        </select>\r\n\t\t\t\t\t\t                    </label>\r\n\t\t\t\t\t\t                </div>\r\n\t\t\t\t\t\t                <div class=\"form-group col s12 l4 flex\">\r\n\t\t\t\t\t\t                    <label class=\"full\">\r\n\t\t\t\t\t\t                        <input v-model=\"searchKeyword\" type=\"text\" id=\"input01\" class=\"size-m\" placeholder=\"계기번호\">\r\n\t\t\t\t\t\t                    </label>\r\n\t\t\t\t\t\t                </div>\r\n\t\t\t\t\t\t                <div class=\"form-group col s12 l4\">\r\n\t\t\t\t\t\t                    <label class=\"full\">\r\n\t\t\t\t\t\t                        <select id=\"sortKey\" class=\"size-m\">\r\n\t\t\t\t\t\t                            <option value=\"\">정렬기준 선택</option>\r\n\t\t\t\t\t\t                            <option value=\"METER_ID_ASC\">계기번호</option>\r\n\t\t\t\t\t\t                            <option value=\"TR_FEED_NM_ASC\">변대주</option>\r\n\t\t\t\t\t\t                            <option value=\"GUM_DAY_ASC\">검침일</option>\r\n\t\t\t\t\t\t                            <option value=\"ADDR_ASC\">주소</option>\r\n\t\t\t\t\t\t                        </select>\r\n\t\t\t\t\t\t                    </label>\r\n\t\t\t\t\t\t                </div>\r\n\t\t\t\t\t\t            </div>\r\n\t\t\t\t\t\t        </div>\r\n\t\t\t\t\t\t\t\t<div class=\"btn-line d-flex between\">\r\n\t\t\t\t\t\t\t\t    <button type=\"button\" class=\"btn type01 size-m c-primary\" @click=\"messagePopup('41')\" :disabled=\"consList.data.length == 0\">임의추가</button>\r\n\t\t\t\t\t\t\t\t    <button type=\"button\" class=\"btn type02 size-m primary\" @click=\"messagePopup('40')\">대상선택</button>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div class=\"d-flex between\">\r\n\t\t\t\t\t\t\t\t    <div class=\"checkbox type04 size-l\">\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" id=\"checkbox0101\" v-model=\"selectAll\" @change=\"toggleSelectAll()\">\r\n\t\t\t\t\t\t\t\t        <label for=\"checkbox0101\">작업목록</label>\r\n\t\t\t\t\t\t\t\t        <i class=\"icon-check\"></i>\r\n\t\t\t\t\t\t\t\t    </div>\r\n\t\t\t\t\t\t\t\t    <div class=\"row form-row\">\r\n\t\t\t\t\t\t\t\t        <div class=\"form-group col s12 right\">\r\n\t\t\t\t\t\t\t\t            <div class=\"checkbox type04 size-xs red\">\r\n\t\t\t\t\t\t\t\t                <input v-model=\"workStepFilter\" id=\"checkbox01\" type=\"checkbox\" value=\"01\">\r\n\t\t\t\t\t\t\t\t                <label for=\"checkbox01\">대상</label>\r\n\t\t\t\t\t\t\t\t                <i class=\"icon-check\"></i>\r\n\t\t\t\t\t\t\t\t            </div>\r\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"checkbox type04 size-xs green\">\r\n\t\t\t\t\t\t\t\t\t\t\t    <input v-model=\"workStepFilter\" id=\"checkbox02\" type=\"checkbox\" value=\"02\">\r\n\t\t\t\t\t\t\t\t\t\t\t    <label for=\"checkbox02\">시공</label>\r\n\t\t\t\t\t\t\t\t\t\t\t    <i class=\"icon-check\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"checkbox type04 size-xs blue\">\r\n\t\t\t\t\t\t\t\t\t\t\t    <input v-model=\"workStepFilter\" id=\"checkbox03\" type=\"checkbox\" value=\"03\">\r\n\t\t\t\t\t\t\t\t\t\t\t    <label for=\"checkbox03\">전송</label>\r\n\t\t\t\t\t\t\t\t\t\t\t    <i class=\"icon-check\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t        </div>\r\n\t\t\t\t\t\t\t\t    </div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t        \r\n\t\t\t\t\t\t        <div class=\"table-type32-wrap\">\r\n\t\t\t\t\t\t            <table class=\"table-type32\">\r\n\t\t\t\t\t\t                <caption>작업목록 테이블로 선택, 작업상태, 장애번호, 복구여부, DCU ID, 지사, 변대주, 주소 항목별 순서대로 안내하는 표입니다</caption>\r\n\t\t\t\t\t\t                <thead>\r\n\t\t\t\t\t\t                    <tr>\r\n\t\t\t\t\t\t                        <th scope=\"col\">선택</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">작업상태</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">지사</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">계기번호</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">계기타입</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">변대주</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">인입주</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">검침일</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">고객수(미설치/전체)</th>\r\n\t\t\t\t\t\t                        <th scope=\"col\">주소</th>\r\n\t\t\t\t\t\t                    </tr>\r\n\t\t\t\t\t\t                </thead>\r\n\t\t\t\t\t\t                <tbody v-if=\"sortedList.length > 0\">\r\n\t\t\t\t\t\t                    <tr v-for=\"(item, index) in sortedList\" @click=\"rowClick(index)\">\r\n\t\t\t\t\t\t                        <td class=\"sel\">\r\n\t\t\t\t\t\t                            <div class=\"checkbox type05\">\r\n\t\t\t\t\t\t                                <input v-model=\"checkedItems\" type=\"checkbox\" id=\"checkbox0201\" :value=\"item\" @click.stop @change=\"updateSelectedItems\">\r\n\t\t\t\t\t\t                                <label for=\"checkbox0201\"></label>\r\n\t\t\t\t\t\t                                <i class=\"icon-check\"></i>\r\n\t\t\t\t\t\t                            </div>\r\n\t\t\t\t\t\t                        </td>\r\n\t\t\t\t\t\t                        <td :class=\"{'red' : item.WORK_STATE == '01','green' : item.WORK_STATE == '02', 'blue' : item.WORK_STATE == '03'}\">\r\n\t\t\t\t\t\t                        \t{{ getStateName(item.WORK_STATE) }}\r\n\t\t\t\t\t\t                        </td>\r\n\t\t\t\t\t\t                        <td>{{ item.OFFC_NM }}</td>\r\n\t\t\t\t\t\t                        <td>{{ item.METER_ID }}</td>\r\n\t\t\t\t\t\t                        <td>{{ codeList.data.find(cl => cl.P_CODE == 'HW40' && cl.C_CODE == item.METER_TYPE)?.C_CODE_NM }}</td>\r\n\t\t\t\t\t\t                        <td>{{ item.TR_FEED_NM }}</td>\r\n\t\t\t\t\t\t                        <td>{{ item.SV_FEED_NM }}</td>\r\n\t\t\t\t\t\t                        <td>{{ item.GUM_DAY }}</td>\r\n\t\t\t\t\t\t                        <td>0/0</td>\r\n\t\t\t\t\t\t                        <td>{{ item.ADDR }}</td>\r\n\t\t\t\t\t\t                    </tr>\r\n\t\t\t\t\t\t                </tbody>\r\n\t\t\t\t\t\t         