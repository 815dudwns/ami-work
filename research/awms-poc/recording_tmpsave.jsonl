t\t\t\tATCH_FILE_ID_8: \"\",\r\n\t\t\t\tATCH_FILE_ID_9: \"\",\r\n\t\t\t\tATCH_FILE_ID_10: \"\",\r\n\t\t\t\tATCH_FILE_ID_11: \"\",\r\n\t\t\t},\r\n\t\t},\r\n\t\t\r\n\t\t//20260223 추가\r\n\t\tmbMeterIdDisable : false,\r\n\t\tmbCntDisable : false,\r\n\t\tmtrWithDisable : false,\r\n\t\tmbInsertCnt : 0,\r\n\t\tisWorkDivFormShow : true,\r\n\t\t\r\n    },\r\n    //데이터 감시\r\n    watch: {\r\n\t\tworkStepFilter: 'resetSelections',\r\n\t\tsearchKeyword: 'resetSelections',\r\n\t\tendDate: 'resetSelections',\r\n\t\tdept2: 'resetSelections',\r\n\t\t'radio':{\r\n\t\t    handler: function(val, oldVal){\r\n\t\t        this.sortKey = '0';\r\n\t\t        this.dept2 = '';\r\n\t\t        this.checkedItems = [];\r\n\t\t        this.fnSearch();\r\n\t\t    }\r\n\t\t},\r\n        'mainList.data': {\r\n            handler: function(val, oldVal) {\r\n                if(this.mainList.enableevent) {\r\n                    var vm = this;\r\n                    val.filter(function(data, rowposition) {\r\n                        return Object.keys(data).some(function(colNm) {\r\n                            var diff = data[colNm] !== vm.mainList.beforeData[rowposition][colNm];\r\n                            if(diff) {\r\n                                vm.mainList.beforeData[rowposition][colNm] = data[colNm];\r\n                            }\r\n                        });\r\n                    });\r\n                }\r\n            },\r\n            deep: true\r\n        },\r\n\t\t'mainList.rowposition': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tif(this.mainList.enableevent){\r\n\t\t\t\t\tvar changeYn = this.mainList.dataCompare(oldVal);\r\n\t\t\t\t\tvar rowType = this.mainList.getRowType(val);\r\n\t\t\t\t\tif(!changeYn){\r\n\t\t\t\t\t\tthis.mainList.setDefaultRow(oldVal);\r\n\t\t\t\t\t}\r\n\t\t            this.$validator.reset();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t//날짜 체크\r\n\t\t'strDate': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tif(this.strDate > this.endDate){\r\n\t\t\t\t\tnotifySubmit('error', '시작일체크', '시작일보다 종료일이 작을 수 없습니다.', 'icon-caution');\r\n\t\t\t\t\tthis.$nextTick(() => {\r\n\t\t\t\t\t\tthis.strDate = moment().add(-1, 'month').format('YYYYMMDD');\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'endDate': {\r\n\t\t\thandler: function (val, oldVal) {\r\n\t\t\t\tif(this.strDate > this.endDate){\r\n\t\t\t\t\tnotifySubmit('error', '종료일체크', '종료일이 시작일보다 작을 수 없습니다.', 'icon-caution');\r\n\t\t\t\t\tthis.$nextTick(() => {\r\n\t\t\t\t\t\tthis.endDate =  moment().format('YYYYMMDD');\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n        \r\n        'mainListPaging.currentPage': {\r\n            handler: function (val, oldVal) {\r\n                this.setMainList(null, val);\r\n                this.updateSelectedItems();\r\n            }\r\n        },\r\n        \r\n        'mainList.currentRow':{\r\n            handler: function(){\r\n\t\t\t\tthis.resetSelections();\r\n\t\t\t\t//this.resetFileAtach();\r\n                var self = this;\r\n                self.skipWatch = true;\r\n                if(self.mainList.currentRow){\r\n\t\t\t\t\tthis.mtrlValSts = true;\r\n\t\t\t\t\tthis.mtrlExtSts = true;\r\n\t\t\t\t\tthis.mtrlEMMMSts = true;\r\n\t\t\t\t\tthis.mtrlCMMMSts = true;\t\t\t\t\t\r\n\t\t\t\t\tthis.mtrlEMMSts = true;\r\n\t\t\t\t\tthis.mtrlCMMSts = true;\r\n\t\t\t\t\tthis.mtrlEINSts = true;\r\n\t\t\t\t\tthis.mtrlCINSts = true;\r\n\r\n\t\t\t\t\tthis.$nextTick(() => {\r\n\t\t\t\t\t\tthis.skipWatch = false;\r\n\t\t\t\t\t\tthis.setBusiMacConnection();\r\n\t\t\t\t\t\tthis.setBusiMacBoxConnection();\r\n\t\t\t\t\t});\r\n                }\r\n            },\r\n        },\r\n        \r\n        'mainList.currentRow.WORK_DIV': function(val){\r\n            this.updateCombo(val, 'REMV_MEMO');\r\n            \r\n            //작업구분에 따른 입력폼 설정\r\n            if(val == 'D1010'){\r\n\t\t\t\tthis.mtrlExtSts = true;\r\n\t\t\t\tthis.mtrlEMMMSts = true;\r\n\t\t\t\tthis.mtrlEMMSts = true;\r\n\t\t\t\tthis.mtrlEINSts = true;\r\n                this.mainList.currentRow.EXT_DCU_ID = '';\r\n\t\t\t\tthis.mainList.currentRow.EXT_DCU_MAC = '';\r\n            } else if(val == 'M1010') { //신설\r\n            \tthis.mtrlExtSts = true;\r\n                this.mainList.currentRow.EXT_FCTY_ID = '';\r\n                this.isWorkDivFormShow = true;\r\n            } else if(val == 'M1030') { //기설\r\n            \tthis.mtrlExtSts = true;\r\n                this.mainList.currentRow.EXT_FCTY_ID = '';\r\n            \tthis.resetWorkDivCommField();\r\n            } else if(val == 'M1040') { //교체 \r\n            \tthis.mtrlExtSts = true;\r\n                this.mainList.currentRow.EXT_FCTY_ID = '';\r\n                this.resetWorkDivCommField();\r\n                this.mainList.currentRow.INST_M = ''\r\n                this.mainList.currentRow.INST_S = ''\r\n                this.mainList.currentRow.BUNGI = ''\r\n               \tthis.mainList.currentRow.ATCH_FILE_ID_3 = ''\r\n              \tthis.mainList.currentRow.ATCH_FILE_ID_4 = ''\r\n            } else if(val == 'M1050') { //철거 \r\n            \tthis.mtrlExtSts = true;\r\n                this.mainList.currentRow.EXT_FCTY_ID = '';\r\n            \tthis.resetWorkDivCommField();\r\n            \tthis.mainList.currentRow.INST_M = ''\r\n                this.mainList.currentRow.INST_S = ''\r\n                this.mainList.currentRow.BUNGI = ''\r\n                this.mainList.currentRow.ATCH_FILE_ID_3 = ''\r\n                this.mainList.currentRow.ATCH_FILE_ID_4 = ''\r\n            } else {\r\n            \tthis.isWorkDivFormShow = true;\r\n            }\r\n        },\r\n        \r\n        'mainList.currentRow.INST_M': function(val){\r\n            this.updateCombo(val, 'INST_S');\r\n\t\t\tif (this.skipWatch) return;\r\n            if(this.mainList.currentRow){\r\n                this.mainList.currentRow.EXT_CONN_DEV = 'N';\r\n            }\r\n            if(this.radio == 'M10'){\r\n                this.validateCode();\r\n            }\r\n        },\r\n        'mainList.currentRow.DATA_NUM': function(val){\r\n\t\t\tif (this.skipWatch) return;\r\n\t\t\tif(this.mainList.currentRow){\r\n                var dcu_id = this.mainList.currentRow.BIZ_DGR == \"\"||this.mainList.currentRow.BIZ_DGR == null?val+6:val+this.mainList.currentRow.BIZ_DGR;\r\n                if(val == null || val == \"\") {\r\n                \tdcu_id = \"\";\r\n                }else {\r\n                \t switch(this.mainList.currentRow.INST_S.slice(6,8)){\r\n\t                     case '10': dcu_id += \"4\"; break;\r\n\t                     case '20': dcu_id += \"\"; break;\r\n\t                     case '30': dcu_id += \"5\"; break;\r\n\t                     case '40': dcu_id += \"6\"; break;\r\n\t                     case '50': dcu_id += \"7\"; break;\r\n\t                     case '60': dcu_id += \"\"; break;\r\n\t                     case '70': dcu_id += \"\"; break;\r\n\t                     case '80': dcu_id += \"\"; break;\r\n\t                     case '85': dcu_id += \"\"; break;\r\n\t                     case '90': dcu_id += \"\"; break;\r\n\t                     case '91': dcu_id += \"\"; break;\r\n\t                     case '92': dcu_id += \"\"; break;\r\n\t                     default: dcu_id = \"\";\r\n                 \t }\r\n                }\r\n                this.mainList.currentRow.DCU_ID = dcu_id;\r\n            }\r\n        },\r\n        'mainList.currentRow.INST_S': function(val){\r\n            this.updateCombo(val, 'IND_CBD_DIV_CD');\r\n\t\t\tif (this.skipWatch) return;\r\n            if(this.mainList.currentRow){\r\n                var dcu_id = this.mainList.currentRow.BIZ_DGR == \"\"||this.mainList.currentRow.BIZ_DGR == null?this.mainList.currentRow.DATA_NUM+6:this.mainList.currentRow.DATA_NUM+this.mainList.currentRow.BIZ_DGR;\r\n                if(this.mainList.currentRow.DATA_NUM == null || this.mainList.currentRow.DATA_NUM == \"\") {\r\n                \tdcu_id = \"\";\r\n                }else {\r\n                \t switch(val.slice(6,8)){\r\n\t                     case '10': dcu_id += \"4\"; break;\r\n\t                     case '20': dcu_id += \"\"; break;\r\n\t                     case '30': dcu_id += \"5\"; break;\r\n\t                     case '40': dcu_id += \"6\"; break;\r\n\t                     case '50': dcu_id += \"7\"; break;\r\n\t                     case '60': dcu_id += \"\"; break;\r\n\t                     case '70': dcu_id += \"\"; break;\r\n\t                     case '80': dcu_id += \"\"; break;\r\n\t                     case '85': dcu_id += \"\"; break;\r\n\t                     case '90': dcu_id += \"\"; break;\r\n\t                     case '91': dcu_id += \"\"; break;\r\n\t                     case '92': dcu_id += \"\"; break;\r\n\t                     default: dcu_id = \"\";\r\n                 \t }\r\n                }\r\n                this.mainList.currentRow.DCU_ID = dcu_id;\r\n            }\r\n        },\r\n        'mainList.currentRow.INSTR_NUM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tthis.mainList.currentRow.INST_M = this.setType(val);\r\n\t            this.validateCode();\r\n\t\t\t}\r\n        },\r\n        'mainList.currentRow.MODEM_DIV': function(val){\r\n\t\t\tif (this.skipWatch) return;\r\n            if(val == '20'){\r\n                this.mainList.currentRow.BUNGI = '0.5';\r\n            }else {\r\n            \tthis.mainList.currentRow.BUNGI = '';\r\n            }\r\n        },\r\n        'mainList.currentRow.IND_CBD_DIV_CD': function(val){\r\n\t\t\tif (this.skipWatch) return;\r\n            if(val != \"\" && this.mainList.currentRow){\r\n                var dcu_id = this.mainList.currentRow.BIZ_DGR == \"\"||this.mainList.currentRow.BIZ_DGR == null?this.mainList.currentRow.DATA_NUM+6:this.mainList.currentRow.DATA_NUM+this.mainList.currentRow.BIZ_DGR;\r\n                dcu_id += (val == 10?'S':'M');\r\n                this.mainList.currentRow.DCU_ID = dcu_id;\r\n            }\r\n        },\r\n        currentInputValue: function(newValue) {\r\n            if (this.activeInput) {\r\n                this.mainList.currentRow[this.activeInput] = newValue;\r\n            }\r\n        },\r\n\t\t'mainList.currentRow.EXT_FCTY_ID': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlExst('M', val, 'M', '기존 모뎀맥').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlExtSts = Boolean(result);\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.EXT_DCU_MAC': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.length >= 11 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlExst('M', val, 'D', '기존 DCU').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlExtSts = Boolean(result);\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.MAC_MODEM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlCd('M', val, 'M', '모뎀맥').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlValSts = Boolean(result);\t\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\tthis.setBusiMacConnection();\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.NEW_DCU_MAC': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.length >= 11 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlCd('M', val, 'D', '사용 DCU자재').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlValSts = Boolean(result);\t\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.EXT_MLN_MAC_MODEM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlExst('M', val, 'M', '기존 간선망 모뎀').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlEMMMSts = Boolean(result);\t\r\n\t\t\t\t\t});\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlEMMMSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.CUR_MLN_MAC_MODEM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlCd('M', val, 'M', '사용 간선망 모뎀').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlCMMMSts = Boolean(result);\r\n\t\t\t\t\t});\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlCMMMSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.EXT_MAC_MODEM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlExst('M', val, 'M', '기존 인입망 모뎀').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlEMMSts = Boolean(result);\t\r\n\t\t\t\t\t});\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlEMMSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.CUR_MAC_MODEM': function(val){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tif(typeof val !== 'undefined' && val.replace('-','').replace(':','').length >= 10 && !this.skipWatch){\r\n\t\t\t\t\tthis.checkMtrlCd('M', val, 'M', '사용 인입망 모뎀').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlCMMSts = Boolean(result);\r\n\t\t\t\t\t});\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlCMMSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.EXT_INSTR_NUM': function(val){\r\n\t\t\tif(this.mainList.currentRow && !this.skipWatch){\r\n\t\t\t\tthis.mainList.currentRow.EXT_MANU_CD = '';\r\n\t\t\t\tthis.mainList.currentRow.EXT_MTRL_NO = '';\r\n\t\t\t\tthis.mainList.currentRow.EXT_MNFCT_YM = '';\r\n\t\t\t\tif(typeof val !== 'undefined' && val.length >= 11){\r\n\t\t\t\t\tthis.checkMtrlExst('M', val, 'T', '기존 계량기', 'EXT_MNFCT_YM').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlEINSts = Boolean(result);\t\r\n\t\t\t\t\t});\r\n\t\t\t\t\tthis.mainList.currentRow.EXT_MANU_CD = val.slice(0,2);\r\n\t\t\t\t\tthis.mainList.currentRow.EXT_MTRL_NO = this.codeList.rawData.find(item => item.P_CODE == 'MNFCT' && item.C_CODE == val.slice(2,4))?.C_CODE_NM;\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlEINSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.CUR_INSTR_NUM': function(val){\r\n\t\t\tif(this.mainList.currentRow && !this.skipWatch){\r\n\t\t\t\tthis.mainList.currentRow.CUR_MANU_CD = '';\r\n\t\t\t\tthis.mainList.currentRow.CUR_MTRL_NO = '';\r\n\t\t\t\tthis.mainList.currentRow.CUR_MNFCT_YM = '';\r\n\t\t\t\tif(typeof val !== 'undefined' && val.length >= 11 ){\r\n\t\t\t\t\tthis.checkMtrlCd('M', val, 'T', '사용 계량기', 'CUR_MNFCT_YM').then(result=>{\r\n\t\t\t\t\t\tthis.mtrlCINSts = Boolean(result);\t\t\t\t\t\t\r\n\t\t\t\t\t});\r\n\t\t\t\t\tthis.mainList.currentRow.CUR_MANU_CD = val.slice(0,2);\r\n\t\t\t\t\tthis.mainList.currentRow.CUR_MTRL_NO = this.codeList.rawData.find(item => item.P_CODE == 'MNFCT' && item.C_CODE == val.slice(2,4))?.C_CODE_NM\r\n\t\t\t\t}else if(typeof val !== 'undefined' && val.length == 0){\r\n\t\t\t\t\tthis.mtrlCINSts = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.BUSI_NUM': function(){\r\n\t\t\tif(this.mainList.currentRow){\r\n\t\t\t\tthis.setBusiMacConnection();\r\n\t\t\t}\r\n\t\t},\r\n\t\t'mainList.currentRow.FCLTY_DIV': function (val) { \r\n\t\t\tif('10' === val) { //단독형\r\n\t\t\t\tthis.mbMeterIdDisable = true;\r\n\t\t\t\tthis.mbCntDisable = true;\r\n\t\t\t\tthis.mtrWithDisable = false;\r\n\t\t\t} else { //집합형\r\n\t\t\t\tthis.mbMeterIdDisable = false;\r\n\t\t\t\tthis.mbCntDisable = false;\r\n\t\t\t\tthis.mtrWithDisable = false;\r\n\t\t\t} \r\n\t\t},\r\n\t\t'workStepFilter': {\r\n\t\t    handler(val, oldVal) {\r\n\t\t        this.fnSearch();\r\n\t\t    },\r\n\t\t    deep: true\r\n\t\t},\r\n    },\r\n    //마운트 된 시점수행\r\n    mounted: function(){        \r\n        this.setDept();\r\n        this.setBusiList();\r\n        this.setCommonCode();\r\n        this.setUserList();\r\n        this.setUserWorkGroup();\r\n        this.fnSearch();\r\n    },\r\n    //함수\r\n    methods: {\r\n        setMainList: function(e, pPageNo){\r\n            var self = this;\r\n\t\t\t\r\n\t\t\tvar vWorkStep = self.workStepFilter.length > 0 ? self.workStepFilter.join(\",\") : \"\"; //진행상태\r\n\t\t\tvar pageNo = pPageNo;\r\n\t\t\tvar rowCount = self.mainListPaging.getRowCnt();\r\n\r\n\t\t\tif(isNull(pageNo)) pageNo = 1;\r\n\t\t\tif(isNull(rowCount)) rowCount = 10;\r\n\r\n\t\t\tif(self.strDate.length != 8 || self.endDate.length != 8){\r\n\t\t\t\tnotifySubmit('error', '철거불가/철거', '작업일을 선택해주세요.', 'icon-caution');\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar params = {\r\n\t\t\t    FLAG : self.radio,\r\n\t\t\t    DEPT1 : self.session.DEPT1,\r\n\t\t\t\tDEPT2 : self.dept2,\r\n\t\t\t\tsearchKeyword : self.vFindCnt > 1 ? self.vFindVal.toUpperCase() : self.searchKeyword.toUpperCase(),\r\n\t\t\t\tsortKey : self.sortKey,\r\n\t\t\t\tworkStep : vWorkStep,\r\n\t\t\t\tpPageNo: pageNo,\r\n\t\t\t\tpRowCount: rowCount,\r\n\t\t\t\tstrDate: self.strDate,\r\n\t\t\t\tendDate: self.endDate,\r\n\t\t\t};\r\n\r\n\t\t\tself.mainList = new Dataset();\r\n\t\t\tself.mainListPaging.setTotalCnt(0);\r\n\t\t\tself.totalCount = 0;\r\n\t\t\t\r\n            var returnVal = mobCst1000Api.getMainList(params);      \r\n            \r\n            returnVal.then(function(response) {\r\n                self.selectAll = false;\r\n                self.checkedItems = [];\r\n\r\n\t\t\t\tself.mainList.setData(response.data);\r\n\t\t\t\tif(self.mainList.getRowCount() > 0){\r\n\t\t\t\t\tself.totalCount = self.mainList.data[0].CNT; //목록전체 개수를 저장\r\n\t\t\t\t\tself.mainListPaging.setTotalCnt(self.totalCount);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tself.mainListPaging.setTotalCnt(0);\r\n\t\t\t\t\tself.totalCount = 0;\r\n\t\t\t\t}\r\n            });\r\n        },\r\n\t\t//조회\r\n\t\tfnSearch: function() {\r\n\t\t\tvar pageNo = this.mainListPaging.getCurrentPage();\r\n\t\t\tif(pageNo == 1){\r\n\t\t\t\tthis.setMainList();\r\n\t\t\t}else{\r\n\t\t\t\tthis.mainListPaging.movePage(1);\r\n\t\t\t}\r\n\t\t},\r\n\t\t//상세조회\r\n\t\tfnSelectDetail: function(params){\r\n\t\t\tvar self = this;\r\n\t\t\t//var vWorkStep = self.workStepFilter.length > 0 ? self.workStepFilter.join(\",\") : \"\"; //진행상태\r\n\t\t\tvar params = {\r\n\t\t\t\t'FLAG': self.radio,\r\n\t\t\t    'DEPT1': params.DEPT1,\r\n\t\t\t\t'BUSI_NUM' : params.BUSI_NUM,\r\n\t\t\t\t'DATA_NUM' : params.DATA_NUM,\r\n\t\t\t\t'EXT_DCU_ID': params.EXT_DCU_ID || '',\r\n\t\t\t\t'INSTR_NUM': params.INSTR_NUM || '',\r\n\t\t\t\t'MAC_MODEM': params.MAC_MODEM || '',\r\n\t\t\t\t'EXT_FCTY_ID': params.EXT_FCTY_ID || '',\r\n\t\t\t};\r\n\t\t\tvar returnVal = mobCst1000Api.getDetail(params);      \r\n\t\t\treturnVal.then(function(response) {\r\n\t\t\t\tself.mainList.currentRow = response.data;\r\n\t\t\t\tself.mainList.currentRow.BIZ_DGR = self.userWorkList.rawData[0]?.BIZ_DGR;\r\n\t\t\t});\r\n\t\t},\r\n        setDept: function(){\r\n            var self = this;\r\n            var params = {};\r\n            var returnVal = mobCst1000Api.getDept();\r\n            \r\n            returnVal.then(function(response) {\r\n                self.deptList.setRawData(response.data);\r\n            });\r\n        },\r\n\t\tsetBusiMacConnection: function(){\r\n\t\t    var self = this;\r\n\t\t\tif(this.radio == 'D10') return;\r\n\t\t    var params = {\r\n\t\t\t\tMAC_MODEM: this.mainList.currentRow.MAC_MODEM,\r\n\t\t\t\tBUSI_NUM: this.mainList.currentRow.BUSI_NUM,\r\n\t\t\t};\r\n\t\t    var returnVal = mobCst1000Api.getBusiMacConnection(params);\r\n\t\t    \r\n\t\t    returnVal.then(function(response) {\r\n\t\t\t\tself.connection = response.data;\r\n\t\t    });\r\n\t\t},\r\n\t\tsetBusiMacBoxConnection: function(){\r\n\t\t    var self = this;\r\n\t\t\tif(this.radio == 'D10') return;\r\n\t\t    var params = {\r\n\t\t\t\tMAC_MODEM: this.mainList.currentRow.MAC_MODEM,\r\n\t\t\t\tMB_METER_ID: this.mainList.currentRow.MB_METER_ID,\r\n\t\t\t\tBUSI_NUM: this.mainList.currentRow.BUSI_NUM,\r\n\t\t\t};\r\n\t\t    var returnVal = mobCst1000Api.getBusiMacBoxConnection(params);\r\n\t\t    \r\n\t\t    returnVal.then(function(response) {\r\n\t\t\t\tself.mbInsertCnt = response.data;\r\n\t\t    });\r\n\t\t},\r\n\t\tcheckMeterDuplication: function(){\r\n\t\t    var self = this;\r\n\t\t\tvar params = {\r\n\t\t\t\tMAC_MODEM: this.mainList.currentRow.MAC_MODEM,\r\n\t\t\t\tBUSI_NUM: this.mainList.currentRow.BUSI_NUM,\r\n\t\t\t\tINSTR_NUM: this.mainList.currentRow.INSTR_NUM,\r\n\t\t\t};\r\n\t\t\t//260414 AMIGO > 무선일 경우 중복계기 체크하지 않음\r\n\t\t\tif(self.mainList.currentRow.INST_M == 'HW4050' && self.mainList.currentRow.BUNGI == '무선') {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\treturn new Promise((resolve) => {\r\n\t\t\t\tvar returnVal = mobCst1000Api.checkMeterDuplication(params);\r\n\t\t\t\treturnVal.then(function(response) {\r\n\t\t\t\t\tresolve(response.data >= 1);\r\n\t\t\t\t});\r\n\t\t\t});\r\n\t\t},\r\n        setBusiList: function(){\r\n            var self = this;\r\n            var params = {\r\n                DEPT1 : self.session.DEPT1,\r\n            };\r\n            var returnVal = mobCst1000Api.getBusiList(params);\r\n            \r\n            returnVal.then(function(response) {\r\n                self.busiList.setRawData(response.data);\r\n            });\r\n        },\r\n        setUserList: function(){\r\n            var self = this;\r\n            var params = {'BLON_CL_CD': this.session.BLON_CL_CD, 'EMP_CL_CD': this.session.EMP_CL_CD};\r\n            var returnVal = mobCst1000Api.getUserList(params);\r\n            \r\n            returnVal.then(function(response) {\r\n                self.userList.setRawData(response.data);\r\n            });\r\n        },\r\n        setUserWorkGroup: function(){\r\n            var self = this;\r\n            var params = {};\r\n            var returnVal = mobCst1000Api.getUserWorkGroup();\r\n            \r\n            returnVal.then(function(response) {\r\n                self.userWorkList.setRawData(response.data);\r\n            });\r\n        },\r\n        setCommonCode: function(){\r\n            var self = this;\r\n            var params = {};\r\n            var returnVal = mobCst1000Api.getCommonCode();\r\n\r\n            returnVal.then(function(response) {\r\n                self.codeList.setRawData(response.data);\r\n            });\r\n        },\r\n        sendSelections: function(){\r\n        \tdocument.body.classList.add('loading-indicator');\r\n            var self = this;\r\n            this.checkedItems.forEach(item => item.FLAG = self.radio);\r\n\t\t\t//var params = this.checkedItems;\r\n\t\t\tvar fileIdCnt = self.radio == 'D10' ? 10 : 5; //추가20260227(유현정)-첨부파일 개수\r\n            var params = {JSON_DATA_LIST: this.checkedItems, tabGubun: self.radio, fileIdCnt: fileIdCnt}; //추가20260227(유현정)-첨부파일 전송 시 foreach로 변경\r\n            var returnVal = mobCst1000Api.sendSelections(params);\r\n            \r\n            returnVal.then(function(response) {\r\n                if(response.data > 0){\r\n                    notifySubmit('success', '전송', '전송이 완료되었습니다', 'icon-success');\r\n                    self.fnSearch();\r\n                }\r\n                else{\r\n                    notifySubmit('error', '전송', '전송이 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n                }\r\n                document.body.classList.remove('loading-indicator');\r\n            }).catch(function(error){\r\n            \tdocument.body.classList.remove('loading-indicator');\r\n\t\t\t\treturn;\r\n\t\t\t});\r\n        },\r\n\t\trevokeSelections: function(){\r\n\t\t    var self = this;\r\n\t\t    this.checkedItems.forEach(item => item.FLAG = self.radio);\r\n\t\t    var params = this.checkedItems;\r\n\t\t    var returnVal = mobCst1000Api.revokeSelections(params);\r\n\t\t    \r\n\t\t    returnVal.then(function(response) {\r\n\t\t        if(response.data > 0){\r\n\t\t            notifySubmit('success', '전송취소', '전송취소가 완료되었습니다', 'icon-success');\r\n\t\t            self.fnSearch();\r\n\t\t        }\r\n\t\t        else{\r\n\t\t            notifySubmit('error', '전송취소', '전송취소가 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n\t\t        }\r\n\t\t    });\r\n\t\t},\r\n        deleteRow: function(){\r\n            var self = this;\r\n            this.checkedItems.forEach(item => item.FLAG = self.radio);\r\n            var params = this.checkedItems;\r\n            var returnVal = mobCst1000Api.deleteRows(params);\r\n            returnVal.then(function(response){\r\n                if(response.data > 0){\r\n                    notifySubmit('success', '삭제', '삭제가 완료되었습니다', 'icon-success');\r\n                    self.fnSearch();\r\n                }\r\n                else{\r\n                    notifySubmit('error', '삭제', '삭제가 완료되지 않았습니다. 관리자에게 문의하시기 바랍니다.', 'icon-caution');\r\n                }\r\n            });\r\n            \r\n        },\r\n        rowClick: function(index){\r\n            var self = this;\r\n\t\t\tif(index == -1){\r\n\t\t\t\tthis.isValid = true;\r\n\t\t\t\tif(this.resetFlag){\r\n\t\t\t\t\tthis.resetFlag = false;\r\n\t\t\t\t\tthis.fnSearch();\r\n\t\t\t\t}\r\n\t\t\t    this.mainList.selectRow(index);\r\n\t\t\t}else{     \r\n\t\t\t\tthis.mainList.selectRow(index);\r\n\t\t\t\tthis.fnSelectDetail(this.mainList.currentRow);\r\n\t\t\t}\r\n        },\r\n        validateRow: async function(pId){\r\n            var self = this;\r\n\t\t\tif(pId == '30' && this.checkedItems.some(item => item.WORK_STEP != '29')){\r\n\t\t\t\tnotifySubmit('error', '오류', '전송하지 않은 항목이 존재합니다', 'icon-caution');\r\n\t\t\t\treturn;\r\n\t\t\t}else if(pId == '99'){\r\n                if(this.checkedItems.some(item => item.WORK_STEP == '29')){\r\n                    notifySubmit('error', '삭제실패', '전송