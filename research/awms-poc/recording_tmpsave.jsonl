{};\r\n\t\t    let fieldsToUpload = this.fileFields[this.radio];\r\n\t\t    if (this.radio === 'D10' &&\r\n\t\t        this.mainList.currentRow.DCU_SIGONG_CD === 'Y' &&\r\n\t\t        this.mainList.currentRow.TDU_USE_YN === 'N') {\r\n\t\t        fieldsToUpload = fieldsToUpload.filter(field => !this.excludeFiles.includes(field));\r\n\t\t    }\r\n\t\t    const uploadPromises = [];\r\n\t\t    fieldsToUpload.forEach(field => {\r\n\t\t        const fileNo = field.replace('ATCH_FILE', '');\r\n\t\t        const refName = `innorixFileUploadSingleAtchFile${fileNo}`;\r\n\t\t        const runner = this.$refs[refName];\r\n\t\t        if (runner?.isChanged()) {\r\n\t\t\t\t\tthis.uploadTarget[field] = {\r\n\t\t                status: \"ready\",\r\n\t\t                runner\r\n\t\t            };\r\n\t\t            uploadPromises.push(\r\n\t\t                new Promise(resolve => {\r\n\t\t                    this.uploadResolvers[field] = resolve;\r\n\t\t                })\r\n\t\t            );\r\n\t\t        }\r\n\t\t    });\r\n\t\t    if (uploadPromises.length === 0) {\r\n\t\t        document.body.classList.remove('loading-indicator');\r\n\t\t        this.saveRow();\r\n\t\t        return;\r\n\t\t    }\r\n\t\t    const first = Object.keys(this.uploadTarget)[0];\r\n\t\t\t\r\n\t\t\tthis.uploadTarget[first].runner.setFileName(this.mainList.currentRow.DATA_NUM, this.mainList.currentRow.INSTR_NUM, this.mainList.currentRow.MAC_MODEM);\r\n\t\t\tthis.uploadTarget[first].runner.upload();\r\n\t\t    await Promise.all(uploadPromises);\r\n\t\t    document.body.classList.remove('loading-indicator');\r\n\t\t    this.saveRow();\r\n\t\t},\r\n        addUserSet: function(model, target){\r\n            if(!this.mainList.currentRow[model]?.toString().trim() && this.userWorkList.rawData.length > 0){\r\n\t\t\t\tconst len = this.userWorkList.rawData[0][target].length;\r\n\t\t\t\tlet val = parseInt(this.userWorkList.rawData[0][target], 10);\r\n\t\t\t\tlet rtnVal = \"\";\r\n\t\t\t\tif(model.indexOf('1') > -1 && !isNaN(val)){\r\n\t\t\t\t\tval = val + 1;\r\n\t\t\t\t\trtnVal = String(val).padStart(len, \"0\");\r\n\t\t\t\t}else if(model.indexOf('2') > -1 && !isNaN(val)){\r\n\t\t\t\t\tval = val + 2;\r\n\t\t\t\t\trtnVal = String(val).padStart(len, \"0\");\r\n\t\t\t\t}\r\n\t\t\t\tthis.$set(this.mainList.currentRow, model, rtnVal);\r\n            }\r\n        },\r\n        openKeyboard: function(inputKey, maxLength, keyType) {\r\n            this.activeInput = inputKey;\r\n            this.currentInputValue = this.mainList.currentRow[inputKey];\r\n            this.$refs.keyboard.openKeyboard(maxLength, keyType);\r\n        },\r\n        checkMtrlCd: function(flag, target, gubun, name, ...checkCode){\r\n\t\t\tif(this.mainList.currentRow.MODEM_DIV == '20'){\r\n\t\t\t\treturn Promise.resolve(true);\r\n\t\t\t}\r\n\t\t\tvar self = this;\r\n\t\t\tvar params ={\r\n\t\t\t\tvBarcdQr : target,\r\n\t\t\t\tvGubun : gubun,\r\n\t\t\t};\r\n            return getMtrlUseYn(params).then(function(response) {\r\n\t\t\t\tif(self.session.MTRL_USE == false){\r\n\t\t\t\t\tif(checkCode){\r\n\t\t\t\t\t\tself.mainList.currentRow[checkCode] = response.MNFCT_YM;\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}else if (response.RESULT === 'Y') {\r\n\t\t\t\t\tif(flag == 'M'){\r\n\t\t\t\t\t\tnotifySubmit('success', '자재유효성검사', '유효한 자재입니다.', 'icon-success');\r\n                    }\r\n\t\t\t\t\tif(checkCode){\r\n\t\t\t\t\t\tself.mainList.currentRow[checkCode] = response.MNFCT_YM;\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn true;\r\n                }else{\r\n                    notifySubmit('error', '자재관리 유효성검사', '['+name+']유효하지 않은 자재입니다', 'icon-caution');\r\n                    return false;\r\n                }\r\n            });\r\n        },\r\n\t\tcheckMtrlExst: function(flag, target, gubun, name, ...checkCode){\r\n\t\t\tif(this.mainList.currentRow.MODEM_DIV == '20'){\r\n\t\t\t\treturn Promise.resolve(true);\r\n\t\t\t}\r\n\t\t\tvar self = this;\r\n\t\t\tvar params ={\r\n\t\t\t\tvBarcdQr : target,\r\n\t\t\t\tvGubun : gubun,\r\n\t\t\t};\r\n\t\t\treturn getMtrExstYn(params).then(function(response) {\r\n\t\t\t\tif(self.session.MTRL_USE == false){\r\n\t\t\t\t\tif(checkCode){\r\n\t\t\t\t\t\tself.mainList.currentRow[checkCode] = response.MNFCT_YM;\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}else if (response.RESULT === 'Y') {\r\n\t\t\t\t\tif(flag == 'M'){\r\n\t\t\t\t\t\tnotifySubmit('success', '자재마스터 유효성검사', '유효한 자재입니다.', 'icon-success');\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(checkCode){\r\n\t\t\t\t\t\tself.mainList.currentRow[checkCode] = response.MNFCT_YM;\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn true;\r\n\t\t\t    }else{\r\n\t\t\t\t\tnotifySubmit('error', '자재마스터 유효성검사', '['+name+']유효하지 않은 자재입니다', 'icon-caution');\r\n\t\t\t\t\treturn false;\r\n\t\t\t    }\r\n\t\t\t});\r\n\t\t},\r\n        \r\n        receiveData: function(tool){\r\n            var data = tool == 'B'?this.$refs.barcodeReader.readValue:this.$refs.ocrReaderWarebiz.meterNumber;\r\n            this.mainList.currentRow[this.vFlmnCl] = data;\r\n        },\r\n        modalOpen: function(gubun, tool){\r\n            this.vFlmnCl = gubun;\r\n            if(tool){\r\n                this.fnFlmn(tool);\r\n            }else{\r\n                modal_open('flmnMode');\r\n            }\r\n        },\r\n        fnFlmn: function(tool){\r\n            if(tool == 'O'){\r\n                this.$refs.ocrReaderWarebiz.openOCRScanner();       \r\n            }\r\n            else if(tool == \"Q\") {\r\n                this.$refs.barcodeReader.openBarcodeScanner(\"2d\");                      \r\n            }\r\n            else {\r\n                this.$refs.barcodeReader.openBarcodeScanner(\"1d\");                      \r\n            }\r\n            modal_close('flmnMode');\r\n        },\r\n        \r\n        resetFileAtach: function(){\r\n\t\t\tObject.keys(this.album.imgBlobByColumnName).forEach(key => {\r\n\t\t\t\tthis.album.imgBlobByColumnName[key] = \"\";\r\n\t\t\t});\r\n\r\n\t\t\tObject.keys(this.album.imgUrlByColumnName).forEach(key => {\t\t\r\n\t\t\t\tthis.album.imgUrlByColumnName[key] = \"\";\r\n\t\t\t\tconst albumImg = document.getElementById(key.replace('_ID_','') + \"_IMG\");\r\n\t\t\t\tif (albumImg && key != 'ATCH_FILE_ID_4') albumImg.src = \"\";\r\n\t\t\t});\r\n        },\r\n        callBackEvent: function(item){\r\n            modal_close('mobcst3000');\r\n            this.$refs.mobcst3000.reset();\r\n\t\t\tif(typeof item !== 'undefined'){\t\t\t\r\n\t\t\t\tif(item.pId !== '41'){\r\n\t\t\t\t\tvar index = this.mainList.data.findIndex(row => row.METER_ID == item.METER_ID \r\n\t\t\t\t\t\t\t\t\t\t\t\t\t&& row.CUST_NO == item.CUST_NO\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t&& row.BONBU_CD == item.DEPT1\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t&& row.TGT_DIV_CD == item.TGT_DIV_CD)\r\n\t\t\t\t\tif(index != -1){\r\n\t\t\t\t\t\tthis.mainList.selectRow(index);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.newRow(item);\r\n        },\r\n\t\tcheckDuplication: function(){\r\n\t\t    const self = this;\r\n\t\t    const params = this.mainList.currentRow;\r\n\t\t\treturn new Promise((resolve) => {\r\n\t\t        mobCst1000Api.checkDuplication(params).then((response) => {\r\n\t\t            const data = response.data;\r\n\t\t\t\t\tself.mainList.currentRow.ERR_LIST = response.data;\r\n\t\t            self._modalQueue = []; // 모달 메시지 큐 초기화\r\n\r\n\t\t            const case1 = data.find(item => item.ERR_CASE == '1');\r\n\t\t            const case2 = data.find(item => item.ERR_CASE == '2');\r\n\t\t\t\t\t\r\n\t\t            if (case1) {\r\n\t\t                self._modalQueue.push({\r\n\t\t                    id: 'DUP_CASE_1',\r\n\t\t                    title: '존재하는 항목',\r\n\t\t                    message: `${case1.USER_NM} 담당자가 이미 시공을 등록하였습니다.\\n삭제후 진행하시겠습니까?`\r\n\t\t                });\r\n\t\t            }\r\n\r\n\t\t            if (case2) {\r\n\t\t                self._modalQueue.push({\r\n\t\t                    id: 'DUP_CASE_2',\r\n\t\t                    title: '할당된 항목',\r\n\t\t                    message: `${case2.USER_NM} 담당자에게 할당된 대상계기입니다.\\n계속 진행하시겠습니까?`\r\n\t\t                });\r\n\t\t            }\r\n\r\n\t\t            if (self._modalQueue.length > 0) {\r\n\t\t                self._duplicationResolve = resolve;\r\n\t\t                self._showNextModal(); // 첫 번째 모달 표시\r\n\t\t            } else {\r\n\t\t                resolve(true); // 중복 없음\r\n\t\t            }\r\n\t\t        });\r\n\t\t    });\r\n\t\t},\r\n\t\terrMessagePopupCallback: function(pGb, pId){\r\n\t\t    if (pGb !== 'confirm') {\r\n\t\t        // 사용자가 취소를 누른 경우 전체 취소\r\n\t\t        if (this._duplicationResolve) {\r\n\t\t            this._duplicationResolve(false);\r\n\t\t            this._duplicationResolve = null;\r\n\t\t        }\r\n\t\t        this._modalQueue = [];\r\n\t\t        return;\r\n\t\t    }\r\n\r\n\t\t    // 사용자가 확인을 누른 경우 다음 모달 표시\r\n\t\t    if (pId.startsWith('DUP_CASE_')) {\r\n\t\t        this._showNextModal(); \r\n\t\t    }\r\n\t\t},\r\n\t\t_showNextModal: function(){\r\n\t\t    const next = this._modalQueue.shift(); // 다음 모달 꺼내기\r\n\t\t    if (next) {\r\n\t\t        this.errMessageModal.openModal('confirm', next.title, next.message, 'small', next.id);\r\n\t\t    } else {\r\n\t\t        // 모두 확인 완료\r\n\t\t        if (this._duplicationResolve) {\r\n\t\t            this._duplicationResolve(true);\r\n\t\t            this._duplicationResolve = null;\r\n\t\t        }\r\n\t\t    }\r\n\t\t},\r\n\t\tresetSelections: function() {\r\n\t\t\tthis.selectAll = false;\r\n\t\t\tthis.checkedItems = [];\r\n\t\t\t// this.locationsList = [];\r\n\t\t},\r\n\t\t\r\n\t\tduplicateCheck: function() {\r\n\t\t    const fclIdSet = new Set();\r\n\t\t    const filteredItems = this.checkedItems.filter(item => {\r\n\t\t        return this.radio === 'D10' || item.MODEM_DIV == 10;\r\n\t\t    });\r\n\t\t    const fclIds = [];\r\n\t\t    if (this.radio === 'D10') {\r\n\t\t        filteredItems.forEach(item => {\r\n\t\t            if (item.EXT_DCU_MAC) fclIds.push(item.EXT_DCU_MAC); //기존 DCU 자재 (자재마스터)\r\n\t\t            if (item.NEW_DCU_MAC) fclIds.push(item.NEW_DCU_MAC); //사용 DCU 자재 (자재관리)\r\n\t\t\t\t\tif (item.EXT_MLN_MAC_MODEM) fclIds.push(item.EXT_MLN_MAC_MODEM); //기존 간선망 모뎀 (자재마스터)\r\n\t\t\t\t\tif (item.CUR_MLN_MAC_MODEM) fclIds.push(item.CUR_MLN_MAC_MODEM); //사용 간선망 모뎀 (자재관리)\r\n\t\t\t\t\tif (item.EXT_MAC_MODEM) fclIds.push(item.EXT_MAC_MODEM); //기존 인입망 모뎀 (자재마스터)\r\n\t\t\t\t\tif (item.CUR_MAC_MODEM) fclIds.push(item.CUR_MAC_MODEM); //사용 인입망 모뎀 (자재관리)\r\n\t\t\t\t\tif (item.EXT_INSTR_NUM) fclIds.push(item.EXT_INSTR_NUM); //기존 계량기\r\n\t\t\t\t\tif (item.CUR_INSTR_NUM) fclIds.push(item.CUR_INSTR_NUM); //사용 계량기\r\n\t\t        });\r\n\t\t    } else {\r\n\t\t        filteredItems.forEach(item => {\r\n\t\t            if (item.EXT_FCTY_ID && item.EXT_FCTY_ID !== '-') fclIds.push(item.EXT_FCTY_ID); //기존 모뎀맥 (자재마스터)\r\n\t\t\t\t\tif (item.MAC_MODEM) fclIds.push(item.MAC_MODEM.replace(/[-:]/g, '')); //사용 모뎀맥 (자재관리)\r\n\t\t        });\r\n\t\t    }\r\n\r\n\t\t    const hasDuplicate = fclIds.some(fclId => {\r\n\t\t        if (fclIdSet.has(fclId)) return true;\r\n\t\t        fclIdSet.add(fclId);\r\n\t\t        return false;\r\n\t\t    });\r\n\r\n\t\t    return !hasDuplicate;\r\n\t\t},\r\n\t\t// 전송 전 2차 검증 (순차 검증)\r\n\t\tfnMtrlCheck: async function(type) {\r\n\t\t\tconst self = this;\r\n\t\t\t\r\n \t\t\t//2026-04-16 함내계기수 비교 삭제\r\n \t\t\t/*\r\n\t\t\tvar isValid = this.checkedItems.every(item => {\r\n\t\t\t\treturn Number(item.MB_CNT) === Number(item.MB_REG_CNT)\t\r\n\t\t\t});\r\n\t\t\tif(this.radio === 'M10' && !isValid) {\r\n\t\t\t\tnotifySubmit('error', '','함내계기수와 등록된 계기수가 불일치합니다.', 'icon-caution');\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t*/\r\n\t\t\t\r\n\t\t\tvar listArr = this.checkedItems.map(item => ({\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvSeq: item.SEQ,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvBarcdQr: this.radio === 'D10' ? item.NEW_DCU_MAC : item.MODEM_MAC,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvGubun: 'D',\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvGubun: this.radioVal === 'D' ? 'D' : 'M',\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvMlnMacModem: item.CUR_MLN_MAC_MODEM,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvMacModem: item.CUR_MAC_MODEM,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\tvInstrNum: item.CUR_INSTR_NUM,\r\n\t\t\t\t\t\t\t\t\t\t\t\t}));\r\n\t\t\tvar sendParams = {\r\n\t\t\t\tlistArrChk: listArr,  // 선택된 항목들\t\r\n\t\t\t\trevoke: type === 'send' ? 'N' : 'Y'\r\n\t\t\t}\r\n\t\t\tif(this.session.MTRL_USE == false){\r\n\t\t\t\tif (type === 'send') {\r\n\t\t\t\t\tself.sendSelections();\r\n\t\t\t\t} else {\r\n\t\t\t\t\tself.revokeSelections();\r\n\t\t\t\t}\r\n\t\t\t\treturn Promise.resolve(true); //추가20260227(유현정)\r\n\t\t\t}\r\n\t\t\treturn getMtrlStsCheck(sendParams).then(function(response) {\r\n\t\t\t\tif(response !== \"\"){\r\n\t\t\t\t\tnotifySubmit('error', '', response, 'icon-caution');\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif (type === 'send') {\r\n\t\t\t\t\t\tself.sendSelections();\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\tself.revokeSelections();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t},\r\n\t\tresetDcuList: function(){\r\n\t\t\tthis.mainList.currentRow.EXT_MLN_MAC_MODEM = ''\r\n\t\t\tthis.mainList.currentRow.CUR_MLN_MAC_MODEM = ''\r\n\t\t\tthis.mainList.currentRow.EXT_MAC_MODEM = ''\r\n\t\t\tthis.mainList.currentRow.CUR_MAC_MODEM = ''\r\n\t\t\tthis.resetTduList();\r\n\t\t},\r\n\t\tresetTduList: function(){\r\n\t\t\tthis.mainList.currentRow.EXT_INSTR_NUM = ''\r\n\t\t\tthis.mainList.currentRow.CUR_INSTR_NUM = ''\r\n\t\t\tthis.mainList.currentRow.EXT_MTRL_NO = ''\r\n\t\t\tthis.mainList.currentRow.EXT_MANU_CD = ''\r\n\t\t\tthis.mainList.currentRow.EXT_MNFCT_YM = ''\r\n\t\t\tthis.mainList.currentRow.CUR_MTRL_NO = ''\r\n\t\t\tthis.mainList.currentRow.CUR_MANU_CD = ''\r\n\t\t\tthis.mainList.currentRow.CUR_MNFCT_YM = ''\r\n\t\t\tthis.mainList.currentRow.BOX_NO = ''\r\n\t\t\tthis.mainList.currentRow.ATCH_FILE_ID_7 = ''\r\n\t\t\tthis.mainList.currentRow.ATCH_FILE_ID_8 = ''\r\n\t\t\tthis.mainList.currentRow.ATCH_FILE_ID_9 = ''\r\n\t\t\tthis.mainList.currentRow.LINE_FAIR = ''\r\n\t\t\tthis.mainList.currentRow.USE_CT = ''\r\n\t\t\tthis.mainList.currentRow.USE_POWER = ''\r\n\t\t\tthis.mainList.currentRow.AM_BAND = ''\r\n\t\t\tthis.mainList.currentRow.FILM_BAND = ''\r\n\t\t\tthis.mainList.currentRow.GRADEL = ''\r\n\t\t\tthis.mainList.currentRow.G_WIRE = ''\r\n\t\t\tthis.mainList.currentRow.KVA_A = ''\r\n\t\t\tthis.mainList.currentRow.KVA_B = ''\r\n\t\t\tthis.mainList.currentRow.KVA_C = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MRF_A = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MRF_B = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MRF_C = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MFG_YM_A = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MFG_YM_B = ''\r\n\t\t\tthis.mainList.currentRow.TRF_MFG_YM_C = ''\r\n\t\t\t//this.updateAtachFile();\r\n\t\t},\r\n\t\tupdateAtachFile: function(){\r\n\t\t\tthis.$nextTick(() => {\r\n\t\t\t\tvar self = this;\r\n\t\t\t\tlet fieldsToProcess = this.fileFields[this.radio];\r\n\t\t\t\tif(this.radio == 'D10' && this.mainList.currentRow.DCU_SIGONG_CD == 'Y' && this.mainList.currentRow.TDU_USE_YN == 'N'){\r\n\t\t\t\t\tfieldsToProcess = fieldsToProcess.filter(field => !this.excludeFiles.includes(field));\r\n\t\t\t\t}\r\n\t\t\t\tfieldsToProcess.forEach((field) => {\r\n\t\t\t\t    const index = self.fileFields[self.radio].indexOf(field);\r\n\t\t\t\t    if (index === -1) return; // 필드가 fileFields에 없으면 스킵\r\n\t\t\t\t    const fileNumber = field.replace('ATCH_FILE', '');\r\n\t\t\t\t    const refName = `innorixFileUploadSingleAtchFile${fileNumber}`;\r\n\t\t\t\t    const buttonId = `${field}_BUTTON`;\r\n\t\t\t\t    const imgId = `${field}_IMG`;\r\n\t\t\t\t    \r\n\t\t\t\t    if (self.$refs[refName]) {\r\n\t\t\t\t        self.$refs[refName].setCapturingWithImg(buttonId, imgId);\r\n\t\t\t\t    }\r\n\t\t\t\t});\r\n\t\t\t});\r\n\t\t},\r\n\t\tfnDuplCheck: function(useMtrl, extMtrl){\r\n\t\t\tconst replace = str => str ? str.replace(/[:-]/g, '') : '';\r\n\t\t\tconst checkList = [\r\n\t\t\t\t//조회해서 불러온 값\r\n\t\t\t\t{ name: this.radio == 'D10' ? '기존DCU자재' : '기존모뎀맥', value: replace(extMtrl)},\r\n\t\t\t\t{ name: this.radio == 'D10' ? '사용DCU자재' : '모뎀맥', value: replace(useMtrl)},\r\n\t\t\t\t{ name: '기존간선망모뎀', value: replace(this.mainList.currentRow.EXT_MLN_MAC_MODEM) },\r\n\t\t\t\t{ name: '사용간선망모뎀', value: replace(this.mainList.currentRow.CUR_MLN_MAC_MODEM) },\r\n\t\t\t\t{ name: '기존인입망모뎀', value: replace(this.mainList.currentRow.EXT_MAC_MODEM) },\r\n\t\t\t\t{ name: '사용인입망모뎀', value: replace(this.mainList.currentRow.CUR_MAC_MODEM) },\r\n\t\t\t\t{ name: '기존계량기', value: replace(this.mainList.currentRow.EXT_INSTR_NUM) },\r\n\t\t\t\t{ name: '사용계량기', value: replace(this.mainList.currentRow.CUR_INSTR_NUM) }\r\n\t\t\t];\r\n\t\t\tconst itemMap = new Map();\r\n\t\t\tfor (let item of checkList) {\r\n\t\t\t\tif (!isNull(item.value)) {\r\n\t\t\t\t\tif (itemMap.has(item.value)) {\r\n\t\t\t\t\t\tconst prevName = itemMap.get(item.value);\r\n\t\t\t\t\t\tnotifySubmit('error','내장애', `${prevName}와 ${item.name} 동일한 값을 입력하실 수 없습니다.`, 'icon-caution' );\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\titemMap.set(item.value, item.name);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\treturn true;\r\n\t\t},\r\n\t\t//봉인정보 maxLength체크\r\n\t\tfnMaxLength: function(e, nm, maxLength){\r\n\t\t\tlet val = e.target.value.replace(/[^0-9]/g, '');\r\n\t\t\t//자리수체크\r\n\t\t\tif (val.length > maxLength) {\r\n\t\t\t    val = val.slice(0, maxLength);\r\n\t\t\t}\r\n\t\t\te.target.value = val;\r\n\t\t\tthis.mainList.currentRow[nm] = val;\r\n\t\t},\r\n\t\tfnMaxSeal: function(val1, val2, gubun){\r\n\t\t\tlet val = \"\";\r\n\t\t\tif (!val1 && !val2) return val; //입력값이 없음녀 빈값 리턴\r\n\t\t\tif (!val1 || !val2) { //봉인1,2값 중 하나라도 값이 있는 경우\r\n\t\t\t\tval = val1 || val2;\r\n\t\t\t}else{\r\n\t\t\t\tval = Number(val1.slice(0, 7)) > Number(val2.slice(0, 7)) ? val1 : val2;\r\n\t\t\t}\r\n\t\t\tconst sliceVal = val.slice(0, 7); //기존에는 8자리였어서 뒤 한자리를 제외한 값으로 비교하기\r\n\t\t\tif(this.userWorkList.rawData.length > 0){\r\n\t\t\t\tconst userSeal = this.userWorkList.rawData[0][gubun]; //AMI시공 설정 봉인값(함체, 계기, 외부)\r\n\t\t\t\treturn Number(sliceVal) > Number(userSeal) ? sliceVal : \"\"; //설정값과 비교\t\r\n\t\t\t}else{\r\n\t\t\t\treturn val;\r\n\t\t\t}\r\n\t\t},\r\n\t\t//모뎀맥 형식 확인 11자리 -> 012로 시작, 16자리 -> 16진수값인지 확인\r\n\t\tfnCheckModemForm: function(){\r\n\t\t\tconst replace = str => str ? str.replace(/[:-]/g, '') : '';\r\n\t\t\tconst checkList = [\r\n\t\t\t\t//조회해서 불러온 값\r\n\t\t\t\t{ name: '기존모뎀맥', value: replace(this.mainList.currentRow.EXT_FCTY_ID)},\r\n\t\t\t\t{ name: '모뎀맥', value: replace(this.mainList.currentRow.MAC_MODEM)},\r\n\t\t\t\t{ name: '기존간선망모뎀', value: replace(this.mainList.currentRow.EXT_MLN_MAC_MODEM)},\r\n\t\t\t\t{ name: '사용간선망모뎀', value: replace(this.mainList.currentRow.CUR_MLN_MAC_MODEM)},\r\n\t\t\t\t{ name: '기존인입망모뎀', value: replace(this.mainList.currentRow.EXT_MAC_MODEM)},\r\n\t\t\t\t{ name: '사용인입망모뎀', value: replace(this.mainList.currentRow.CUR_MAC_MODEM)},\r\n\t\t\t];\r\n\t\t\tfor (let item of checkList) {\r\n\t\t\t\tif (!isNull(item.value)) {\r\n\t\t\t\t\tif(item.value.length == 11){\r\n\t\t\t\t\t\tif(!item.value.startsWith('012')){\r\n\t\t\t\t\t\t\treturn item.name;\t\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(item.value.length == 16){\r\n\t\t\t\t\t\tconst reg = /[G-Z]/i;\r\n\t\t\t\t\t\tif(reg.test(item.value)){\r\n\t\t\t\t\t\t\treturn item.name;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\topenModalAndWait(){\r\n\t\t\treturn new Promise((resolve) => {\r\n\t\t        modal_open('modal_selection');\r\n\r\n\t\t        const cameraBtn = document.querySelector(\"#camera\");\r\n\t\t        const albumBtn = document.querySelector(\"#album\");\r\n\t\t        cameraBtn.onclick = () => {\r\n\t\t            modal_close('modal_selection');\r\n\t\t            resolve('camera');\r\n\t\t        };\r\n\t\t        albumBtn.onclick = () => {\r\n\t\t            modal_close('modal_selection');\r\n\t\t            resolve('album');\r\n\t\t        };\r\n\t\t    });\r\n\t\t},\r\n\t\tfindOrCapture: async function(id) {\r\n\t\t\tconst select = await this.openModalAndWait();\r\n\t\t\tconst input = document.createElement(\"input\");\r\n\t\t\tinput.type = \"file\";\r\n\t\t\tinput.accept = \"image/*\";\r\n\t\t\tif(select == 'album'){\r\n\t\t\t\tinput.removeAttribute(\"capture\");\r\n\t\t\t}else{\r\n\t\t\t\tinput.capture = \"environment\";\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tinput.onchange = (event) => {\r\n\t\t\t\tconst file = event.target.files[0];\r\n\t\t\t\tif (!file) return;\r\n\r\n\t\t\t\tconst LIMIT_SIZE = 500 * 1024;\r\n\t\t\t\tconst MAX_WIDTH = 1024;   // 최대 가로\r\n\t\t\t\tconst MAX_HEIGHT = 1024;  // 최대 세로\r\n\t\t\t\tconst QUALITY = 0.8;      // 0 ~ 1 (JPEG/WEBP 품질)\r\n\r\n\t\t\t\tif (file.size <= LIMIT_SIZE) {\r\n\t\t\t\t\tconst blobUrl = URL.createObjectURL(file);\r\n\r\n\t\t\t\t\tthis.album.imgBlobByColumnName[id] = file;\r\n\t\t\t\t\tthis.album.imgUrlByColumnName[id] = blobUrl;\r\n\r\n\t\t\t\t\tconst previewImg = document.getElementById(\r\n\t\t\t\t\t\tid.replace(\"_ID_\", \"\") + \"_IMG\"\r\n\t\t\t\t\t);\r\n\t\t\t\t\tpreviewImg.src = blobUrl;\r\n\t\t\t\t\tpreviewImg.classList.add('ami-img-wrap');\r\n\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tconst img = new Image();\r\n\t\t\t\tconst reader = new FileReader();\r\n\r\n\t\t\t\treader.onload = (e) => {\r\n\t\t\t\t\timg.src = e.target.result;\r\n\t\t\t\t};\r\n\r\n\t\t\t\timg.onload = () => {\r\n\t\t\t\t\tlet { width, height } = img;\r\n\r\n\t\t\t\t\t// 비율 유지하면서 리사이즈\r\n\t\t\t\t\tif (width > MAX_WIDTH || height > MAX_HEIGHT) {\r\n\t\t\t\t\t\tconst ratio = Math.min(\r\n\t\t\t\t\t\t\tMAX_WIDTH / width,\r\n\t\t\t\t\t\t\tMAX_HEIGHT / height\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\twidth *= ratio;\r\n\t\t\t\t\t\theight *= ratio;\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tconst canvas = document.createElement('canvas');\r\n\t\t\t\t\tcanvas.width = width;\r\n\t\t\t\t\tcanvas.height = height;\r\n\r\n\t\t\t\t\tconst ctx = canvas.getContext('2d');\r\n\t\t\t\t\tctx.drawImage(img, 0, 0, width, height);\r\n\r\n\t\t\t\t\t// JPEG 또는 WEBP 권장\r\n\t\t\t\t\tcanvas.toBlob((resizedBlob) => {\r\n\t\t\t\t\t\tconst blobUrl = URL.createObjectURL(resizedBlob);\r\n\r\n\t\t\t\t\t\tthis.album.imgBlobByColumnName[id] = resizedBlob;\r\n\t\t\t\t\t\tthis.album.imgUrlByColumnName[id] = blobUrl;\r\n\r\n\t\t\t\t\t\tconst previewImg = document.getElementById(\r\n\t\t\t\t\t\t\tid.replace(\"_ID_\", \"\") + \"_IMG\"\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\tpreviewImg.src = blobUrl;\r\n\t\t\t\t\t\tpreviewImg.classList.add('ami-img-wrap');\r\n\r\n\t\t\t\t\t}, 'image/jpeg', QUALITY);\r\n\t\t\t\t};\r\n\r\n\t\t\t\treader.readAsDataURL(file);\r\n\t\t\t};\r\n\r\n\t\t\t// 파일 선택창 실행\r\n\t\t\tinput.click();\r\n\t\t},\r\n\t\tresetWorkDivCommField : function() {\r\n\t\t\tthis.isWorkDivFormShow = false;\r\n\t\t\t\r\n\t\t\tthis.mainList.currentRow.EXT_CONN_DEV = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_BOX1 = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_BOX2 = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_METER1 = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_METER2 = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_OUTER1 = ''\r\n\t\t\tthis.mainList.currentRow.SEAL_OUTER2 = ''\r\n\t\t\tthis.mainList.currentRow.LINE_TYPE = ''\r\n\t\t\tthis.mainList.currentRow.VISIT_DIV = ''\r\n\t\t\tthis.mainList.currentRow.SIG_LEVEL = ''\r\n\t\t\tthis.mainList.currentRow.ETC1 = ''\r\n\t\t\tthis.mainList.currentRow.ETC2 = ''\r\n\t\t}\r\n    }\r\n});\r\n/*******************************************************************************************************************************************************************\r\n * vue end \r\n ********************************************************************************************************************************************************************/\r\n\r\n\r\n/*******************************************************************************************************************************************************************\r\n * jui script start \r\n ********************************************************************************************************************************************************************/\r\n/*******************************************************************************************************************************************************************\r\n * jui script end \r\n ********************************************************************************************************************************************************************/\r\n\r\n \r\n \r\n/*******************************************************************************************************************************************************************\r\n * javascript start \r\n ********************************************************************************************************************************************************************/\r\n$(document).ready(function(){\r\n    $('.table-type32 td input[type=checkbox]').on('click', function () {\r\n        $(this).parent().parent().parent().toggleClass('active');\r\n    });\r\n});\r\n\r\n\r\n/*******************************************************************************************************************************************************************\r\n * javascript end \r\n ********************************************************************************************************************************************************************/\r\n\r\n</script>","dur":464,"page":"https://awms.kdn.com/html/main/index.html?app=MOBCST&menu=01010000"}
