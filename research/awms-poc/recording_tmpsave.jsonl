gEl = document.querySelector(`#ATCH_FILE${index}_IMG`);\r\n\t\t\t\t    if(imgEl.getAttribute('src') == ''){\r\n\t\t\t\t        notifySubmit('error', '필수항목 누락', imgEl.getAttribute('name') + ' 항목은 필수정보입니다', 'icon-caution');\r\n\t\t\t\t        return true;\r\n\t\t\t\t    }\r\n\t\t\t\t    return false;\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t\tif(fileFlag)return;\r\n\t\t\t\t//if (self.radio == 'M10' && self.mainList.currentRow.ROW_TYPE == '2') {\r\n\t\t\t\tif (self.radio == 'M10') {\r\n\t\t\t\t    const isConfirmed = await self.checkDuplication();\r\n\t\t\t\t    if (!isConfirmed) return;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar test = this.fnCheckModemForm();\r\n\t\t\t\tif(!isNull(test)){\r\n\t\t\t\t\tnotifySubmit('error', '모뎀맥 형식 미일치', test+' 형식이 일치하지 않습니다', 'icon-caution');\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(!this.mainList.currentRow.WORK_STEP){\r\n\t\t\t\t\tvar meterDupl = await this.checkMeterDuplication();\r\n\t\t\t\t\tif(meterDupl){\r\n\t\t\t\t\t\tvar msg = '공사번호 ' + this.mainList.currentRow.BUSI_NUM + ', 모뎀맥 ' + this.mainList.currentRow.MAC_MODEM + '인 작업중 계기번호 끝 2자리 ' + this.mainList.currentRow.INSTR_NUM.slice(-2) + '가 동일한 항목이 존재합니다';\r\n\t\t\t\t\t\tnotifySubmit('error', '계기 중복', msg, 'icon-caution', 5000);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tself.mainList.currentRow.FLAG = self.radio;\r\n\t\t\t\tself.pId = pId;\r\n\t\t\t\t//self.upload();\r\n\t\t\t\tself.saveRow();\r\n            }\r\n        },\r\n        selectNewSigModem: function(){\r\n            this.$refs.mobcst3000.setMainList();\r\n            modal_open(\"mobcst3000\");\r\n        },\r\n        \r\n        newRow: function(item){\r\n\t\t\tlet worker1 = this.session.USER_ID;\r\n\t\t\tlet worker2 = \"\";\r\n\t\t\tlet worker3 = \"\";\r\n\t\t\t\r\n\t\t\tlet busiNum = \"\";\r\n\t\t\tif(this.radio == 'M10'){\r\n\t\t\t\tif(item.pId == '41'){\r\n\t\t\t\t\tbusiNum = item.busiNum;\r\n\t\t\t\t\titem = undefined;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//신규등록 시 디폴트 세팅값은