cope=\"col\">모뎀유형</th>\r\n                            <th scope=\"col\">개통여부</th>\r\n                            <th scope=\"col\">대표계기</th>\r\n                            <th scope=\"col\">함내계기</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody v-if=\"mainList.data.length > 0\">\r\n                        <tr v-for=\"(item, index) in mainList.data\" @click=\"rowClick(index)\">\r\n                            <td class=\"sel\">\r\n                                <div class=\"checkbox type05\">\r\n                                    <input v-model=\"checkedItems\" type=\"checkbox\" :id=\"`checkbox0201_${item.DATA_NUM}_${item.BUSI_NUM}_${item.MAC_MODEM}_${item.EXT_FCTY_ID}`\" :value=\"item\" @click.stop @change=\"updateSelectedItems\">\r\n                                    <label :for=\"`checkbox0201_${item.DATA_NUM}_${item.BUSI_NUM}_${item.MAC_MODEM}_${item.EXT_FCTY_ID}`\"></label>\r\n                                    <i class=\"icon-check\"></i>\r\n                                </div>\r\n                            </td>\r\n\t\t\t\t\t\t\t<td :class=\"{'red' : item.WORK_STEP == '20', 'yellow' : item.WORK_STEP == '25' ,'green' : item.WORK_STEP == '28', 'blue' : item.WORK_STEP == '29'}\">\r\n\t\t\t\t\t\t\t\t{{ codeList.rawData.find(cl => cl.P_CODE == 'OBS002' && cl.C_CODE == item.WORK_STEP)?.C_CODE_NM }}\r\n\t\t\t\t\t\t\t</td>\r\n                            <td>{{ item.INSTR_NUM }}</td>\r\n                            <td>{{ deptList.rawData.find(dl => dl.DEPT2 == item.DEPT2)?.DEPT2_NM }}</td>\r\n                            <td>{{ item.MAC_MODEM }}</td>\r\n                            <td>{{ codeList.rawData.find(cl => cl.C_CODE == item.INST_S)?.C_CODE_NM }}</td>\r\n                            <td>{{ codeList.rawData.find(cl => cl.C_CODE == item.INST_M)?.C_CODE_NM }}</td>\r\n                            <td>{{ codeList.rawData.find(cl => cl.C_CODE == item.FCLTY_DIV)?.C_CODE_NM }}</td>\r\n                            <td>