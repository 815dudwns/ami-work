{
  "rules": {
    ".read": false,
    ".write": false,
    "workStatus": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@ami-work.local')",
      "$dataset": {
        ".indexOn": "syncAt",
        "$addr": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@ami-work.local')"
        }
      }
    },
    "collect_handoff": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@ami-work.local')",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@ami-work.local')"
    },
    "mapSecret": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@ami-work.local')",
      ".write": false
    },
    "siteData": {
      ".read": false,
      "charger4eleccar": {
